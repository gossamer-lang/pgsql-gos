// A program whose whole output is checked to be byte-identical across the
// three tiers: the bytecode VM (`gos run`), the Cranelift JIT, and LLVM AOT
// (`gos build`, `gos build --release`).
//
// `gos test` runs on the VM by design, so tier agreement is not something
// the unit or integration suites can establish. This walks the surface a
// tier could plausibly disagree on - the typed codec in both wire formats,
// the calendar arithmetic behind it, streamed COPY, the statement cache,
// and JSON rendering - and prints a deterministic transcript.
//
//     tests/parity/run.sh
//
// The transcript carries no clock, no PID, and no server version, so a
// difference between two runs is a difference between two tiers.

use std::sync::channel_unbounded
use std::{env, errors}

use "github.com/gossamer-lang/pgsql-gos" as pgsql

fn main() -> Result<(), errors::Error> {
    let url = env::var("GOS_PGSQL_TEST_URL")
        .unwrap_or("host=/var/run/postgresql dbname=gos_pgsql_test")
    let mut db = pgsql::connect(&url)?
    defer db.close()
    db.batch_execute(&"SET TIME ZONE 'UTC'")?

    calendar()
    text_forms()?
    prepare_churn(&url)?
    codec(&mut db)?
    copy_stream(&mut db)?
    statement_cache(&mut db)?
    row_json(&mut db)?
    concurrent(&url)?
    Ok(())
}

// Connections opened from several goroutines under one limiter, which is
// the shape the concurrency ABI supports and the one a compiled tier could
// deadlock on.
fn concurrent(url: &String) -> Result<(), errors::Error> {
    println!("== concurrency")
    let limiter = pgsql::limit_open(url, 3)?
    let (results, collected) = channel_unbounded()
    cohort {
        for n in 0..12 {
            spawn(|| results.send(shard(&limiter, n).unwrap_or(-1)))
        }
    }?
    results.close()
    let mut total = 0
    let mut counted = 0
    while let Some(doubled) = collected.recv() {
        total += doubled
        counted += 1
    }
    println!("  limiter={} shards={} total={}", limiter.size(), counted, total)
    Ok(())
}

fn shard(limiter: &pgsql::pool::Limiter, n: i64) -> Result<i64, errors::Error> {
    let mut db = limiter.acquire()?
    let row = db.query_one(&"SELECT $1::int4 * 2 AS doubled", &#[pgsql::int(n)])?
    let doubled = row.i64_of("doubled")?
    limiter.release(db)
    Ok(doubled)
}

// Many statements, each with SQL text the session has not seen, so each one
// sends its own Parse.
//
// The count of failures is the whole point: every one of these is a valid
// statement against a working session, so the answer is zero, and a tier that
// prints anything else disagrees with the others about a program that only
// prepares statements.
fn prepare_churn(url: &String) -> Result<(), errors::Error> {
    println!("== prepare churn")
    let mut db = pgsql::connect(url)?
    defer db.close()
    let mut failures = 0
    for i in 0..400 {
        let sql = format!("SELECT {}::int8 AS n", i)
        match db.query(&sql, &#[]) {
            Ok(rows) => {
                if rows.len() != 1 || rows[0].i64_of("n").unwrap_or(-1) != i {
                    failures += 1
                }
            }
            Err(_) => failures += 1
        }
    }
    println!("  400 distinct statements, failures={}", failures)
    Ok(())
}

// The calendar arithmetic under the typed codec, at the boundaries an
// integer-division rounding difference would show up in.
fn calendar() {
    println!("== calendar")
    let days: Vec<i64> = #[-719_162, -1, 0, 10_957, 19_951, 2_932_896]
    for day in days {
        let (year, month, date) = pgsql::temporal::civil_from_days(day)
        println!(
            "  {} -> {}-{}-{} -> {}"
            day
            year
            month
            date
            pgsql::temporal::days_from_civil(year, month, date)
        )
    }
    let divisions: Vec<(i64, i64)> = #[(-7, 2), (7, 2), (-1, 86_400), (0, 3), (-86_400_000, 86_400)]
    for (a, b) in divisions {
        println!("  floor_div({}, {}) = {}", a, b, pgsql::temporal::floor_div(a, b))
    }
}

// Parsing and rendering, which every tier has to agree on before a column
// can.
fn text_forms() -> Result<(), errors::Error> {
    println!("== text forms")
    let stamps: Vec<String> = #[
        "2026-08-16 12:34:56.789012+00"
        "2026-08-16 12:34:56+05:30"
        "2026-08-16 12:34:56"
        "0044-03-15 BC"
        "infinity"
        "-infinity"
        "1970-01-01 00:00:00-00"
    ]
    for text in stamps {
        let at = pgsql::parse_timestamp(&text)?
        println!("  {} -> {} | {} | {}", text, at, at.to_rfc3339(), at.to_unix_micros())
    }
    let spans: Vec<String> = #[
        "1 year 2 mons 3 days 04:05:06.789"
        "-1 years -2 mons -3 days -04:05:06"
        "00:00:00"
        "P1Y2M3DT4H5M6.5S"
        "400:00:00"
    ]
    for text in spans {
        let span = pgsql::parse_interval(&text)?
        println!("  {} -> {} | {} {} {}", text, span, span.months, span.days, span.micros)
    }
    let id = pgsql::parse_uuid(&"00112233-4455-6677-8899-AABBCCDDEEFF")?
    println!("  uuid -> {} | {}", id, id.to_hex())
    Ok(())
}

// Every column the driver reads specially, in both wire formats.
fn codec(db: &mut pgsql::client::Client) -> Result<(), errors::Error> {
    println!("== codec")
    let sql = """
    SELECT 42::int4 AS i, 9007199254740991::int8 AS big, true AS b,
           1.5::float8 AS f, 'NaN'::float8 AS nan, '123.4500'::numeric AS n,
           'hello'::text AS t, '\\x00ff'::bytea AS blob,
           '00112233-4455-6677-8899-aabbccddeeff'::uuid AS id,
           '2026-08-16 12:34:56.789012+00'::timestamptz AS at,
           '2026-08-16 12:34:56.789012'::timestamp AS naive,
           '2026-08-16'::date AS day, '12:34:56.5'::time AS clock,
           '12:34:56.5-05'::timetz AS zoned,
           '1 year 2 mons 3 days 04:05:06.789'::interval AS span,
           '{"a": 1, "b": [2, 3]}'::jsonb AS doc,
           ARRAY[1, NULL, 3]::int4[] AS ints,
           ARRAY['a', 'b,c']::text[] AS texts,
           '[1,5)'::int4range AS r,
           'infinity'::timestamptz AS hi, '-infinity'::date AS lo
    """
    let formats: Vec<i64> = #[pgsql::value::FORMAT_TEXT, pgsql::value::FORMAT_BINARY]
    for format in formats {
        db.set_result_format(format)
        let row = db.query_one(&sql, &#[])?
        println!("  -- format {}", format)
        println!("    i={} big={} b={}", row.i64_of("i")?, row.i64_of("big")?, row.bool_of("b")?)
        println!("    f={} nan={} n={}", row.f64_of("f")?, row.text_of("nan")?, row.text_of("n")?)
        println!("    t={} blob={:?}", row.text_of("t")?, row.bytes_of("blob")?)
        println!("    id={}", row.uuid_of("id")?)
        let at = row.timestamp_of("at")?
        println!("    at={} micros={} rfc={}", at, at.to_unix_micros(), at.to_rfc3339())
        println!("    naive={} zone={:?}", row.timestamp_of("naive")?, row.timestamp_of("naive")?.offset_minutes)
        println!("    day={} clock={} zoned={}", row.date_of("day")?, row.time_of("clock")?, row.time_of("zoned")?)
        let span = row.interval_of("span")?
        println!("    span={} ({} {} {})", span, span.months, span.days, span.micros)
        println!("    doc={}", row.json_of("doc")?)
        println!("    ints={:?}", row.array_of("ints")?.map(|v| v.render()))
        println!("    texts={:?}", row.array_of("texts")?.map(|v| v.render()))
        let r = row.range_of("r")?
        println!("    range=[{},{}) inclusive={}{}", r.lower.render(), r.upper.render(), r.lower_inclusive, r.upper_inclusive)
        println!("    hi={} lo={}", row.timestamp_of("hi")?, row.date_of("lo")?)
    }
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    small_magnitude_numerics(db)
}

// The base-10000 numeric encoding stores significant digits and a weight
// saying where they sit, so a value below one whole group is written back
// from the weight rather than read off the wire. Both formats are printed
// side by side: a tier that reconstructs those zeros differently shows up
// as a differing line rather than as a wrong number nobody looked at.
fn small_magnitude_numerics(db: &mut pgsql::client::Client) -> Result<(), errors::Error> {
    println!("  -- numeric across both formats")
    let samples: Vec<String> = #[
        "0", "1", "-1", "0.1", "-0.1", "0.0001", "0.00010000"
        "0.00000001", "-0.00000001", "1e-25", "0.5000"
        "12345.6789", "-12345.6789"
        "123456789012345678901234567890.123456789"
    ]
    for sample in samples {
        let sql = format!("SELECT {}::numeric AS n", sample)
        db.set_result_format(pgsql::value::FORMAT_TEXT)
        let as_text = db.query_one(&sql, &#[])?.text_of("n")?
        db.set_result_format(pgsql::value::FORMAT_BINARY)
        let as_binary = db.query_one(&sql, &#[])?.text_of("n")?
        println!("    {} -> text={} binary={} agree={}", sample, as_text, as_binary, as_text == as_binary)
    }
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    Ok(())
}

// A bulk load in both directions, chunked, which exercises the framing a
// compiled tier could get wrong at a buffer boundary.
fn copy_stream(db: &mut pgsql::client::Client) -> Result<(), errors::Error> {
    println!("== copy")
    db.batch_execute(&"DROP TABLE IF EXISTS t_parity_copy")?
    db.batch_execute(&"CREATE TABLE t_parity_copy (id int4, name text)")?
    let mut copy = db.copy_in_begin(&"COPY t_parity_copy (id, name) FROM STDIN")?
    for start in (0..5_000).step_by(500) {
        let mut batch: Vec<Vec<pgsql::value::Value>> = #[]
        for offset in 0..500 {
            let id = start + offset
            batch.push(#[pgsql::int(id), pgsql::text(format!("name{}", id))])
        }
        db.copy_in_write_rows(&mut copy, &batch)?
    }
    println!("  copied in {}", db.copy_in_end(&mut copy)?)

    let mut out = db.copy_out_begin(&"COPY t_parity_copy (id, name) TO STDOUT")?
    let mut lines = 0
    let mut last = ""
    while let Some(line) = db.copy_out_line(&mut out)? {
        lines += 1
        last = line
    }
    println!("  copied out {} last={}", lines, last)
    db.batch_execute(&"DROP TABLE t_parity_copy")?
    Ok(())
}

// The cache's eviction order, which a difference in map or vector ordering
// would show up in.
fn statement_cache(db: &mut pgsql::client::Client) -> Result<(), errors::Error> {
    println!("== statement cache")
    db.set_statement_cache_capacity(4)
    let mut total = 0
    for n in 0..12 {
        let row = db.query_one(&format!("SELECT {}::int4 + $1::int4 AS total", n), &#[pgsql::int(1)])?
        total += row.i64_of("total")?
    }
    println!("  total={} held={}", total, db.statement_cache_len())
    db.clear_statement_cache()
    println!("  after clear held={}", db.statement_cache_len())
    db.set_statement_cache_capacity(pgsql::client::DEFAULT_STATEMENT_CACHE_CAPACITY)
    Ok(())
}

// The JSON rendering, whose key order follows the result's column order.
fn row_json(db: &mut pgsql::client::Client) -> Result<(), errors::Error> {
    println!("== json")
    println!("  {}", db.query_one_json(
        &"""
        SELECT 7::int8 AS id, 'Ada'::text AS name, 1.5::float8 AS ratio,
               '12.500'::numeric AS exact, true AS active, NULL::text AS note,
               ARRAY['one', 'two']::text[] AS tags, '{"a": 1}'::jsonb AS doc,
               '\\x00ff'::bytea AS blob,
               '2026-08-16 12:34:56.789012+00'::timestamptz AS at
        """
        &#[]
    )?)
    println!("  {}", db.query_json(&"SELECT generate_series(1, 3) AS n", &#[])?)
    Ok(())
}
