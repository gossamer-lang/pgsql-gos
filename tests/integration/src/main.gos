#[test]
fn a_statement_held_by_the_caller_runs_without_the_cache() {
    let _ = testing::check_ok(a_statement_held_by_the_caller_runs_without_the_cache_steps(), "steps")
}

fn a_statement_held_by_the_caller_runs_without_the_cache_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_held")?
    db.batch_execute(&"CREATE TABLE t_held (id bigint, name text)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_held")

    let insert = db.prepare(&"INSERT INTO t_held (id, name) VALUES ($1, $2)")?
    let _ = testing::check_eq(&insert.param_count(), &2, "two parameters were described")
    let _ = testing::check_eq(&insert.columns.len(), &0, "an insert describes no columns")
    for i in 1..4 {
        let affected = db.execute_prepared(&insert, &#[pgsql::int(i), pgsql::text(format!("n{}", i))])?
        let _ = testing::check_eq(&affected, &1, &format!("row {} went in", i))
    }
    // Holding the statement is not the cache, so the cache stays empty.
    let _ = testing::check_eq(&db.statement_cache_len(), &0, "nothing was cached")

    let total = db.query_value(&"SELECT count(*) FROM t_held", &#[])?
    let _ = testing::check_eq(&total.as_int().unwrap_or(0), &3, "all three rows")

    // Closing it drops it on the server, so running it again is reported.
    db.close_statement(&insert)?
    let after = db.execute_prepared(&insert, &#[pgsql::int(9), pgsql::text("x")])
    let _ = testing::check(after.is_err(), "a closed statement no longer runs")
    db.ping()?
    Ok(())
}

#[test]
fn turning_the_cache_off_prepares_every_call_and_leaves_nothing_behind() {
    let _ = testing::check_ok(
        turning_the_cache_off_prepares_every_call_and_leaves_nothing_behind_steps()
        "steps"
    )
}

fn turning_the_cache_off_prepares_every_call_and_leaves_nothing_behind_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    let _ = db.query(&"SELECT $1::int8 AS n", &#[pgsql::int(1)])?
    let _ = testing::check_eq(&db.statement_cache_len(), &1, "the cache holds it")
    let held = prepared_count(&mut db)?
    let _ = testing::check(held >= 1, &format!("and so does the server: {}", held))

    // Turning it off drops what it held, on both sides.
    db.set_statement_cache(false)
    let _ = testing::check_eq(&db.statement_cache_len(), &0, "the cache is empty")
    let _ = testing::check_eq(&prepared_count(&mut db)?, &0, "and the server holds none")

    for i in 0..5 {
        let row = db.query_one(&"SELECT $1::int8 AS n", &#[pgsql::int(i)])?
        let _ = testing::check_eq(&row.i64_of("n")?, &i, &format!("call {} still answers", i))
    }
    let _ = testing::check_eq(&db.statement_cache_len(), &0, "and still caches nothing")

    db.set_statement_cache(true)
    let _ = db.query(&"SELECT $1::int8 AS n", &#[pgsql::int(1)])?
    let _ = testing::check_eq(&db.statement_cache_len(), &1, "turning it back on caches again")
    Ok(())
}

#[test]
fn a_portal_abandoned_before_it_is_exhausted_leaves_the_transaction_usable() {
    let _ = testing::check_ok(
        a_portal_abandoned_before_it_is_exhausted_leaves_the_transaction_usable_steps()
        "steps"
    )
}

fn a_portal_abandoned_before_it_is_exhausted_leaves_the_transaction_usable_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    let mut tx = db.transaction()?
    let mut portal = db.open_portal(&"SELECT i FROM generate_series(1, 5000) i", &#[])?
    let first = db.fetch(&mut portal, 10)?
    let _ = testing::check_eq(&first.len(), &10, "the first batch")
    let _ = testing::check_eq(&first[0].i64_at(0)?, &1, "starting where the result does")

    // Give up on it with thousands of rows still to come.
    db.close_portal(&mut portal)?
    let _ = testing::check_eq(&db.fetch(&mut portal, 10)?.len(), &0, "a closed portal yields nothing")

    // The transaction is still usable, and so is the connection after it.
    let inside = db.query_value(&"SELECT 7", &#[])?
    let _ = testing::check_eq(&inside.as_int().unwrap_or(0), &7, "the transaction still runs")
    db.commit(&mut tx)?
    db.ping()?
    Ok(())
}

#[test]
fn a_savepoint_can_be_released_rather_than_rolled_back_to() {
    let _ = testing::check_ok(a_savepoint_can_be_released_rather_than_rolled_back_to_steps(), "steps")
}

fn a_savepoint_can_be_released_rather_than_rolled_back_to_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_savepoints")?
    db.batch_execute(&"CREATE TABLE t_savepoints (id bigint)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_savepoints")

    let mut tx = db.transaction()?
    let _ = db.execute(&"INSERT INTO t_savepoints VALUES (1)", &#[])?
    let outer = db.savepoint(&mut tx)?
    let _ = db.execute(&"INSERT INTO t_savepoints VALUES (2)", &#[])?
    let inner = db.savepoint(&mut tx)?
    let _ = db.execute(&"INSERT INTO t_savepoints VALUES (3)", &#[])?

    // Releasing keeps the work; rolling back to the outer one discards what
    // came after it.
    db.release_savepoint(inner)?
    let _ = testing::check_eq(
        &db.query_value(&"SELECT count(*) FROM t_savepoints", &#[])?.as_int().unwrap_or(0)
        &3
        "a released savepoint keeps its rows"
    )
    db.rollback_to(outer)?
    let _ = testing::check_eq(
        &db.query_value(&"SELECT count(*) FROM t_savepoints", &#[])?.as_int().unwrap_or(0)
        &1
        "and rolling back to the outer one drops both"
    )
    db.commit(&mut tx)?
    let _ = testing::check_eq(
        &db.query_value(&"SELECT count(*) FROM t_savepoints", &#[])?.as_int().unwrap_or(0)
        &1
        "what committed is what was left"
    )
    Ok(())
}

#[test]
fn a_failed_statement_poisons_its_transaction_until_it_is_rolled_back() {
    let _ = testing::check_ok(
        a_failed_statement_poisons_its_transaction_until_it_is_rolled_back_steps()
        "steps"
    )
}

fn a_failed_statement_poisons_its_transaction_until_it_is_rolled_back_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    let mut tx = db.transaction()?
    let _ = testing::check(db.in_transaction(), "the block is open")

    let broken = db.query(&"SELECT * FROM a_table_that_is_not_there", &#[])
    let _ = testing::check(broken.is_err(), "the statement is reported")

    // The server accepts only a rollback now, which is its rule rather than
    // the driver's.
    let next = db.query(&"SELECT 1", &#[])
    let _ = testing::check(next.is_err(), "and the block refuses anything else")
    if let Err(e) = next {
        let _ = testing::check_eq(
            &pgsql::sqlstate_of(&e)
            &"25P02"
            &format!("in a failed transaction block: {}", e)
        )
    }
    let _ = testing::check(
        db.in_failed_transaction()
        "and the connection says the block is poisoned rather than merely open"
    )
    db.rollback(&mut tx)?
    let _ = testing::check(!db.in_transaction(), "the rollback ends it")
    let _ = testing::check(!db.in_failed_transaction(), "and it is no longer poisoned")
    let _ = testing::check_eq(
        &db.query_value(&"SELECT 1", &#[])?.as_int().unwrap_or(0)
        &1
        "and the connection works again"
    )
    Ok(())
}

#[test]
fn a_pipeline_commits_all_of_its_statements_or_none_of_them() {
    let _ = testing::check_ok(a_pipeline_commits_all_of_its_statements_or_none_of_them_steps(), "steps")
}

fn a_pipeline_commits_all_of_its_statements_or_none_of_them_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_pipeline")?
    db.batch_execute(&"CREATE TABLE t_pipeline (id bigint primary key)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_pipeline")

    let sql: Vec<String> = #[
        "INSERT INTO t_pipeline VALUES ($1)"
        "INSERT INTO t_pipeline VALUES ($1)"
        "INSERT INTO t_pipeline VALUES ($1)"
    ]
    let good: Vec<Vec<pgsql::value::Value>> = #[
        #[pgsql::int(1)], #[pgsql::int(2)], #[pgsql::int(3)]
    ]
    let counts = db.pipeline(&sql, &good)?
    let _ = testing::check_eq(&counts.len(), &3, "one count per statement")
    let _ = testing::check_eq(&counts[0], &1, "each affected one row")

    // The batch carries one Sync, so it is one implicit transaction: a
    // statement that fails rolls back the ones before it in the same batch.
    let clashing: Vec<Vec<pgsql::value::Value>> = #[
        #[pgsql::int(4)], #[pgsql::int(1)], #[pgsql::int(5)]
    ]
    let outcome = db.pipeline(&sql, &clashing)
    let _ = testing::check(outcome.is_err(), "the duplicate key is reported")
    if let Err(e) = outcome {
        let _ = testing::check(pgsql::unique_violation(&e), &format!("classified: {}", e))
    }
    let total = db.query_value(&"SELECT count(*) FROM t_pipeline", &#[])?
    let _ = testing::check_eq(&total.as_int().unwrap_or(0), &3, "and none of that batch landed")

    // A mismatched pairing is caught before anything reaches the wire.
    let short: Vec<Vec<pgsql::value::Value>> = #[#[pgsql::int(9)]]
    let _ = testing::check(db.pipeline(&sql, &short).is_err(), "three statements need three sets")
    db.ping()?
    Ok(())
}

#[test]
fn a_bulk_load_can_be_written_as_raw_bytes_a_chunk_at_a_time() {
    let _ = testing::check_ok(a_bulk_load_can_be_written_as_raw_bytes_a_chunk_at_a_time_steps(), "steps")
}

fn a_bulk_load_can_be_written_as_raw_bytes_a_chunk_at_a_time_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_copy_raw")?
    db.batch_execute(&"CREATE TABLE t_copy_raw (id bigint, name text)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_copy_raw")

    // A chunk need not end on a row boundary: the server reassembles the
    // stream, so a caller can hand over whatever it has.
    let mut copy = db.copy_in_begin(&"COPY t_copy_raw (id, name) FROM STDIN")?
    db.copy_in_write(&mut copy, &"1\tone\n2\ttw".as_bytes())?
    db.copy_in_write(&mut copy, &"o\n3\tthree\n".as_bytes())?
    let loaded = db.copy_in_end(&mut copy)?
    let _ = testing::check_eq(&loaded, &3, "three rows even though a chunk split one")

    let names = db.query(&"SELECT name FROM t_copy_raw ORDER BY id", &#[])?
    let _ = testing::check_eq(&names.len(), &3, "all three read back")
    let _ = testing::check_eq(&names[1].text_at(0)?, &"two", "including the one that was split")
    Ok(())
}

#[test]
fn a_copy_given_up_part_way_commits_none_of_its_rows() {
    let _ = testing::check_ok(a_copy_given_up_part_way_commits_none_of_its_rows_steps(), "steps")
}

fn a_copy_given_up_part_way_commits_none_of_its_rows_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_copy_abort")?
    db.batch_execute(&"CREATE TABLE t_copy_abort (id bigint)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_copy_abort")

    let mut copy = db.copy_in_begin(&"COPY t_copy_abort (id) FROM STDIN")?
    for i in 1..500 {
        db.copy_in_write(&mut copy, &format!("{}\n", i).as_bytes())?
    }
    let _ = testing::check(copy.bytes_sent() > 0, "the payload did reach the server")
    db.copy_in_abort(&mut copy, &"the caller changed its mind")?

    let total = db.query_value(&"SELECT count(*) FROM t_copy_abort", &#[])?
    let _ = testing::check_eq(&total.as_int().unwrap_or(-1), &0, "and none of it was committed")
    db.ping()?
    Ok(())
}

// --- LISTEN / NOTIFY ----------------------------------------------

#[test]
fn a_notification_arrives_on_the_channel_it_was_sent_to() {
    let _ = testing::check_ok(a_notification_arrives_on_the_channel_it_was_sent_to_steps(), "steps")
}

fn a_notification_arrives_on_the_channel_it_was_sent_to_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.listen("gos_pgsql_events")?
    db.notify("gos_pgsql_events", "row 7 changed")?
    // The delivery rides the next exchange, or the poll waits for it.
    match db.poll_notification(2_000)? {
        Some(n) => {
            let _ = testing::check_eq(&n.channel, &"gos_pgsql_events", "channel")
            let _ = testing::check_eq(&n.payload, &"row 7 changed", "payload")
            let _ = testing::check(n.pid > 0, "sender pid")
        }
        None => { let _ = testing::check(false, "a notification was expected") }
    }
    db.unlisten("gos_pgsql_events")?
    Ok(())
}

#[test]
fn polling_with_no_notification_answers_none() {
    let _ = testing::check_ok(polling_with_no_notification_answers_none_steps(), "steps")
}

fn polling_with_no_notification_answers_none_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.listen("gos_pgsql_quiet")?
    let _ = testing::check(
        db.poll_notification(0)?.is_none()
        "a zero timeout answers None on a quiet channel"
    )
    db.unlisten("")?
    db.ping()?
    Ok(())
}

#[test]
fn a_queued_notification_is_drained_without_touching_the_socket() {
    let _ = testing::check_ok(a_queued_notification_is_drained_without_touching_the_socket_steps(), "steps")
}

fn a_queued_notification_is_drained_without_touching_the_socket_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.listen("t_queued")?
    // Delivered to this same session, so the payload is already on the wire
    // by the time the NOTIFY's own exchange finishes.
    db.notify("t_queued", "first")?
    db.notify("t_queued", "second")?
    // Any exchange absorbs what arrives during it, so a plain query is
    // enough to have queued both.
    let _ = db.query(&"SELECT 1", &#[])?

    let mut seen: Vec<String> = #[]
    while let Some(n) = db.take_notification() {
        let _ = testing::check_eq(&n.channel, &"t_queued", "the channel it was sent to")
        let _ = testing::check(n.pid > 0, "and the backend that issued it")
        seen.push(n.payload)
    }
    let _ = testing::check_eq(&seen.len(), &2, &format!("both were queued: {:?}", seen))
    let _ = testing::check_eq(&seen[0], &"first", "in the order they were sent")
    let _ = testing::check_eq(&seen[1], &"second", "including the second")
    let _ = testing::check(db.take_notification().is_none(), "and the queue is drained")

    // After UNLISTEN the session no longer receives them.
    db.unlisten("t_queued")?
    db.notify("t_queued", "third")?
    let _ = db.query(&"SELECT 1", &#[])?
    let _ = testing::check(db.take_notification().is_none(), "an unlistened channel delivers nothing")
    Ok(())
}

#[test]
fn a_channel_name_from_outside_the_program_cannot_end_the_statement() {
    let _ = testing::check_ok(
        a_channel_name_from_outside_the_program_cannot_end_the_statement_steps()
        "steps"
    )
}

fn a_channel_name_from_outside_the_program_cannot_end_the_statement_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    // A name a program read from somewhere else is quoted, so it names a
    // channel rather than running as SQL.
    let hostile = "ch\"; DROP TABLE IF EXISTS t_not_dropped; --"
    db.batch_execute(&"DROP TABLE IF EXISTS t_not_dropped")?
    db.batch_execute(&"CREATE TABLE t_not_dropped (id bigint)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_not_dropped")

    db.listen(hostile)?
    db.notify(hostile, "still just a payload")?
    let _ = db.query(&"SELECT 1", &#[])?
    match db.take_notification() {
        Some(n) => { let _ = testing::check_eq(&n.channel, &hostile, "the whole name is the channel") }
        None => { let _ = testing::check(false, "the notification arrived") }
    }
    let still_there = db.query_value(
        &"SELECT count(*) FROM pg_class WHERE relname = 't_not_dropped'"
        &#[]
    )?
    let _ = testing::check_eq(&still_there.as_int().unwrap_or(-1), &1, "and the table is still there")
    db.unlisten(hostile)?
    Ok(())
}

// --- connecting from parameters a program built -------------------

#[test]
fn a_connection_opens_from_parameters_the_program_adjusted() {
    let _ = testing::check_ok(a_connection_opens_from_parameters_the_program_adjusted_steps(), "steps")
}

fn a_connection_opens_from_parameters_the_program_adjusted_steps() -> Result<(), errors::Error> {
    // The documented shape: parse the string, change what the program rather
    // than the operator decides, then connect on those.
    let mut cfg = pgsql::parse_config(&test_url())?
    cfg.application_name = Some("pgsql_gos_integration")
    cfg.statement_timeout_ms = 8_000

    let mut db = pgsql::connect_with(&cfg)?
    defer db.close()
    let _ = testing::check_eq(
        &db.query_value(&"SHOW application_name", &#[])?.render()
        &"pgsql_gos_integration"
        "the name the program set reached the server"
    )
    let _ = testing::check_eq(
        &db.query_value(&"SHOW statement_timeout", &#[])?.render()
        &"8s"
        "and so did the statement bound"
    )
    // The server sees it under that name too.
    let mine = db.query_value(
        &"SELECT count(*) FROM pg_stat_activity WHERE pid = $1 AND application_name = $2"
        &#[pgsql::int(db.backend_pid()), pgsql::text("pgsql_gos_integration")]
    )?
    let _ = testing::check_eq(&mine.as_int().unwrap_or(0), &1, "the session names itself")
    Ok(())
}

#[test]
fn a_pool_opens_from_parameters_the_program_built() {
    let _ = testing::check_ok(a_pool_opens_from_parameters_the_program_built_steps(), "steps")
}

fn a_pool_opens_from_parameters_the_program_built_steps() -> Result<(), errors::Error> {
    let mut cfg = pgsql::parse_config(&test_url())?
    cfg.application_name = Some("pgsql_gos_pooled")
    let mut pool = pgsql::pool::open_with(&cfg, 2)?
    let _ = testing::check_eq(&pool.size(), &2, "the cap")
    pool.warm(1)?
    let mut db = pool.acquire()?
    let _ = testing::check_eq(
        &db.query_value(&"SHOW application_name", &#[])?.render()
        &"pgsql_gos_pooled"
        "every connection the pool opens carries the parameters"
    )
    pool.release(db)
    pool.close_idle()
    let _ = testing::check_eq(&pool.live_count(), &0, "and closing empties it")
    Ok(())
}

// --- awkward data -------------------------------------------------

#[test]
fn a_value_far_larger_than_one_read_chunk_survives_a_round_trip() {
    let _ = testing::check_ok(
        a_value_far_larger_than_one_read_chunk_survives_a_round_trip_steps()
        "steps"
    )
}

fn a_value_far_larger_than_one_read_chunk_survives_a_round_trip_steps() -> Result<(), errors::Error> {
    // The socket is read in 64 KiB chunks, so a value larger than that spans
    // several reads and the framing has to carry it across them.
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_large")?
    db.batch_execute(&"CREATE TABLE t_large (id bigint, body text, blob bytea)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_large")

    let mut body = ""
    while body.byte_len() < 400_000 {
        body += "abcdefghij0123456789"
    }
    let mut blob: Vec<u8> = #[]
    for i in 0..300_000 {
        blob.push((i & 255) as u8)
    }
    let _ = db.execute(
        &"INSERT INTO t_large (id, body, blob) VALUES ($1, $2, $3)"
        &#[pgsql::int(1), pgsql::text(body.clone()), pgsql::bytes(blob.clone())]
    )?
    for format in #[pgsql::value::FORMAT_TEXT, pgsql::value::FORMAT_BINARY] {
        db.set_result_format(format)
        let row = db.query_one(&"SELECT body, blob FROM t_large WHERE id = 1", &#[])?
        let read_body = row.text_of("body")?
        let read_blob = row.bytes_of("blob")?
        let _ = testing::check_eq(&read_body.byte_len(), &body.byte_len(), &format!("text length, format {}", format))
        let _ = testing::check(read_body == body, &format!("text content, format {}", format))
        let _ = testing::check_eq(&read_blob.len(), &blob.len(), &format!("bytea length, format {}", format))
        let _ = testing::check(read_blob == blob, &format!("bytea content, format {}", format))
    }
    Ok(())
}

#[test]
fn a_wide_result_reads_every_one_of_its_columns() {
    let _ = testing::check_ok(a_wide_result_reads_every_one_of_its_columns_steps(), "steps")
}

fn a_wide_result_reads_every_one_of_its_columns_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    // The column count is an int16 on the wire, so a wide row is worth
    // reading to the end rather than only at its start.
    let mut selected: Vec<String> = #[]
    for i in 0..300 {
        selected.push(format!("{} AS c{}", i, i))
    }
    let row = db.query_one(&format!("SELECT {}", selected.join(", ")), &#[])?
    let _ = testing::check_eq(&row.width(), &300, "every column arrived")
    let _ = testing::check_eq(&row.i64_at(0)?, &0, "the first")
    let _ = testing::check_eq(&row.i64_at(299)?, &299, "and the last")
    let _ = testing::check_eq(&row.i64_of("c150")?, &150, "and one in the middle by name")
    Ok(())
}

#[test]
fn text_that_is_awkward_to_quote_round_trips_unchanged() {
    let _ = testing::check_ok(text_that_is_awkward_to_quote_round_trips_unchanged_steps(), "steps")
}

fn text_that_is_awkward_to_quote_round_trips_unchanged_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let awkward: Vec<String> = #[
        ""
        "'"
        "\""
        "\\"
        "a\tb"
        "line\nbreak"
        "{braced}"
        "{\"json\": null}"
        "h\u{e9}llo \u{65e5}\u{672c}\u{8a9e} \u{1d11e}"
        "trailing space "
        " leading space"
        "NULL"
        "\\N"
    ]
    for sample in awkward {
        let row = db.query_one(&"SELECT $1::text AS t", &#[pgsql::text(sample.clone())])?
        let _ = testing::check_eq(&row.text_of("t")?, &sample, &format!("round trip `{}`", sample))
    }
    // The same values through an array, where the literal has to quote them.
    let row = db.query_one(&"SELECT $1::text[] AS a", &#[pgsql::text_array(awkward.clone())])?
    let read = row.array_of("a")?
    let _ = testing::check_eq(&read.len(), &awkward.len(), "every element came back")
    for i in 0..awkward.len() {
        let _ = testing::check_eq(
            &read[i].as_text().unwrap_or("<null>")
            &awkward[i]
            &format!("array element {}", i)
        )
    }
    Ok(())
}

// --- errors -------------------------------------------------------

#[test]
fn a_server_error_carries_its_sqlstate_and_leaves_the_connection_usable() {
    let _ = testing::check_ok(a_server_error_carries_its_sqlstate_and_leaves_the_connection_usable_steps(), "steps")
}

fn a_server_error_carries_its_sqlstate_and_leaves_the_connection_usable_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let outcome = db.query(&"SELECT * FROM a_table_that_does_not_exist", &#[])
    match outcome {
        Ok(_) => { let _ = testing::check(false, "expected a failure") }
        Err(e) => {
            let _ = testing::check_eq(
                &pgsql::sqlstate_of(&e)
                &"42P01"
                &format!("undefined_table sqlstate: {}", e)
            )
            let _ = testing::check(pgsql::in_error_class(&e, "42"), "syntax / access class")
            let _ = testing::check(!pgsql::retryable(&e), "not retryable")
        }
    }
    // The session is still usable after the failure.
    let after = db.query_value(&"SELECT 1", &#[])?
    let _ = testing::check_eq(&after.as_int().unwrap_or(0), &1, "the next query works")
    Ok(())
}

#[test]
fn a_constraint_violation_is_classified() {
    let _ = testing::check_ok(a_constraint_violation_is_classified_steps(), "steps")
}

fn a_constraint_violation_is_classified_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_constraints")?
    db.batch_execute(
        &"""
        CREATE TABLE t_constraints (
            id int4 PRIMARY KEY,
            parent int4 REFERENCES t_constraints(id),
            name text NOT NULL
        )
        """
    )?
    let _ = db.execute(&"INSERT INTO t_constraints (id, name) VALUES (1, 'root')", &#[])?

    match db.execute(&"INSERT INTO t_constraints (id, name) VALUES (1, 'again')", &#[]) {
        Ok(_) => { let _ = testing::check(false, "a duplicate key must fail") }
        Err(e) => { let _ = testing::check(pgsql::unique_violation(&e), &format!("unique: {}", e)) }
    }
    match db.execute(&"INSERT INTO t_constraints (id, parent, name) VALUES (2, 99, 'orphan')", &#[]) {
        Ok(_) => { let _ = testing::check(false, "a missing parent must fail") }
        Err(e) => {
            let _ = testing::check(pgsql::foreign_key_violation(&e), &format!("foreign key: {}", e))
        }
    }
    match db.execute(&"INSERT INTO t_constraints (id, name) VALUES (3, NULL)", &#[]) {
        Ok(_) => { let _ = testing::check(false, "a NULL in a NOT NULL column must fail") }
        Err(e) => { let _ = testing::check(pgsql::not_null_violation(&e), &format!("not null: {}", e)) }
    }
    db.batch_execute(&"DROP TABLE t_constraints")?
    Ok(())
}

#[test]
fn a_wrong_parameter_count_is_reported_before_the_wire() {
    let _ = testing::check_ok(a_wrong_parameter_count_is_reported_before_the_wire_steps(), "steps")
}

fn a_wrong_parameter_count_is_reported_before_the_wire_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let outcome = db.execute(&"SELECT $1::int4 + $2::int4", &#[pgsql::int(1)])
    match outcome {
        Ok(_) => { let _ = testing::check(false, "expected a failure") }
        Err(e) => {
            let _ = testing::check(
                format!("{}", e).contains("parameter")
                &format!("names the mismatch: {}", e)
            )
        }
    }
    db.ping()?
    Ok(())
}

#[test]
fn a_notice_is_collected_rather_than_raised() {
    let _ = testing::check_ok(a_notice_is_collected_rather_than_raised_steps(), "steps")
}

fn a_notice_is_collected_rather_than_raised_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_notice")?
    // `DROP TABLE IF EXISTS` on a missing table is a notice, not an error.
    db.batch_execute(&"DROP TABLE IF EXISTS t_notice")?
    let notices = db.take_notices()
    let _ = testing::check(notices.len() > 0, "the notice was collected")
    let _ = testing::check(
        notices[0].code != ""
        &format!("the notice carries a sqlstate: {}", notices[0].render())
    )
    let _ = testing::check_eq(&db.take_notices().len(), &0, "taking them clears the queue")
    Ok(())
}

// --- cancellation -------------------------------------------------

#[test]
fn a_cancel_token_stops_a_running_query() {
    let _ = testing::check_ok(a_cancel_token_stops_a_running_query_steps(), "steps")
}

fn a_cancel_token_stops_a_running_query_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let token = db.cancel_token()
    // The cancel goes out on its own connection while this one sleeps. The
    // token is captured by the closure rather than passed as a `go`
    // argument: the compiled concurrency ABI moves no aggregate across that
    // boundary, while a capture reaches it by reference.
    let cancel = || {
        time::sleep(300)
        let _ = token.cancel()
    }
    go cancel()
    let outcome = db.query(&"SELECT pg_sleep(10)", &#[])
    match outcome {
        Ok(_) => { let _ = testing::check(false, "the sleep should have been cancelled") }
        Err(e) => {
            let _ = testing::check(
                pgsql::sqlstate_of(&e) == "57014"
                &format!("query_canceled sqlstate: {}", e)
            )
        }
    }
    // The session survives a cancellation.
    let after = db.query_value(&"SELECT 5", &#[])?
    let _ = testing::check_eq(&after.as_int().unwrap_or(0), &5, "the next query works")
    Ok(())
}

// --- pool ---------------------------------------------------------

// --- schema change under a cached statement -----------------------

#[test]
fn a_schema_change_under_a_cached_statement_is_answered_rather_than_reported() {
    let _ = testing::check_ok(
        a_schema_change_under_a_cached_statement_is_answered_rather_than_reported_steps()
        "steps"
    )
}

fn a_schema_change_under_a_cached_statement_is_answered_rather_than_reported_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_stale")?
    db.batch_execute(&"CREATE TABLE t_stale (id bigint, name text)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_stale")

    let sql = "SELECT * FROM t_stale WHERE id = $1"
    let _ = db.execute(&"INSERT INTO t_stale VALUES (1, 'a')", &#[])?
    let before = db.query(&sql, &#[pgsql::int(1)])?
    let _ = testing::check_eq(&before[0].width(), &2, "two columns before the change")

    // A migration moves the result shape out from under the cached plan.
    db.batch_execute(&"ALTER TABLE t_stale ADD COLUMN extra text")?
    let after = db.query(&sql, &#[pgsql::int(1)])?
    let _ = testing::check_eq(&after[0].width(), &3, "the widened row comes back")

    // Dropping and recreating the table invalidates it the same way.
    db.batch_execute(&"DROP TABLE t_stale")?
    db.batch_execute(&"CREATE TABLE t_stale (id bigint, name text)")?
    let _ = db.execute(&"INSERT INTO t_stale VALUES (1, 'a')", &#[])?
    let recreated = db.query(&sql, &#[pgsql::int(1)])?
    let _ = testing::check_eq(&recreated[0].width(), &2, "the narrowed row comes back")

    // An `execute` reaches the same path.
    db.batch_execute(&"ALTER TABLE t_stale ADD COLUMN third text")?
    let affected = db.execute(&"UPDATE t_stale SET name = $1 WHERE id = 1", &#[pgsql::text("b")])?
    let _ = testing::check_eq(&affected, &1, "the update runs against the current schema")
    Ok(())
}

#[test]
fn a_failure_that_is_not_a_stale_plan_is_still_reported() {
    let _ = testing::check_ok(a_failure_that_is_not_a_stale_plan_is_still_reported_steps(), "steps")
}

fn a_failure_that_is_not_a_stale_plan_is_still_reported_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_notstale")?
    db.batch_execute(&"CREATE TABLE t_notstale (id bigint primary key)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_notstale")
    let _ = db.execute(&"INSERT INTO t_notstale VALUES (1)", &#[])?

    let outcome = db.execute(&"INSERT INTO t_notstale VALUES ($1)", &#[pgsql::int(1)])
    let _ = testing::check(outcome.is_err(), "a duplicate key is reported, not retried away")
    if let Err(e) = outcome {
        let _ = testing::check(pgsql::unique_violation(&e), &format!("classified: {}", e))
    }
    db.ping()?
    Ok(())
}

#[test]
fn a_sqlstate_survives_being_wrapped_by_a_caller() {
    let _ = testing::check_ok(a_sqlstate_survives_being_wrapped_by_a_caller_steps(), "steps")
}

fn a_sqlstate_survives_being_wrapped_by_a_caller_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_wrapped")?
    db.batch_execute(&"CREATE TABLE t_wrapped (id bigint primary key)")?
    defer db.batch_execute(&"DROP TABLE IF EXISTS t_wrapped")
    let _ = db.execute(&"INSERT INTO t_wrapped VALUES (1)", &#[])?

    let Err(direct) = db.execute(&"INSERT INTO t_wrapped VALUES (1)", &#[]) else {
        return Err(errors::new("expected a unique violation"))
    }
    let _ = testing::check_eq(&pgsql::sqlstate_of(&direct), &"23505", "the code as reported")

    let wrapped = errors::wrap(direct, "saving the row")
    let _ = testing::check_eq(&pgsql::sqlstate_of(&wrapped), &"23505", "through one wrap")
    let _ = testing::check(pgsql::unique_violation(&wrapped), "classified through one wrap")

    let twice = errors::wrap(wrapped, "handling the request")
    let _ = testing::check_eq(&pgsql::sqlstate_of(&twice), &"23505", "through two wraps")

    let local = errors::new("connecting to 127.0.0.1:5432: refused")
    let _ = testing::check_eq(&pgsql::sqlstate_of(&local), &"", "a local failure carries none")
    Ok(())
}

// --- timeouts -----------------------------------------------------

#[test]
fn a_connect_timeout_bounds_connecting_and_nothing_after_it() {
    let _ = testing::check_ok(a_connect_timeout_bounds_connecting_and_nothing_after_it_steps(), "steps")
}

fn a_connect_timeout_bounds_connecting_and_nothing_after_it_steps() -> Result<(), errors::Error> {
    // `connect_timeout` is libpq's bound on establishing the session. A
    // query that outlasts it is not the thing it bounds.
    let mut db = pgsql::connect(&format!("{} connect_timeout=2", test_url()))?
    defer db.close()
    let slept = db.query(&"SELECT pg_sleep(3)", &#[])
    let _ = testing::check(slept.is_ok(), &format!("a longer query still runs: {:?}", slept.is_ok()))
    let _ = testing::check(!db.is_closed(), "and leaves the connection open")
    Ok(())
}

#[test]
fn a_socket_timeout_bounds_a_wait_on_the_server() {
    // The deadline is a socket read deadline, which only a TCP socket
    // carries. Skipped when no TCP server is configured.
    match env::var("GOS_PGSQL_TCP_URL") {
        Some(url) => {
            let _ = testing::check_ok(a_socket_timeout_bounds_a_wait_on_the_server_steps(&url), "steps")
        }
        None => { let _ = testing::check(true, "no TCP server configured") }
    }
}

fn a_socket_timeout_bounds_a_wait_on_the_server_steps(url: &String) -> Result<(), errors::Error> {
    let mut db = pgsql::connect(&format!("{} socket_timeout=1", url))?
    defer db.close()
    let started = time::now_ms()
    let outcome = db.query(&"SELECT pg_sleep(5)", &#[])
    let waited = time::now_ms() - started
    let _ = testing::check(outcome.is_err(), "a server that outlasts the deadline is reported")
    let _ = testing::check(waited < 4_000, &format!("and reported at the deadline, after {} ms", waited))
    if let Err(e) = outcome {
        let _ = testing::check(
            format!("{}", e).contains("socket_timeout")
            &format!("the report names the deadline: {}", e)
        )
    }
    let _ = testing::check(db.is_closed(), "a connection abandoned mid-exchange is not reusable")
    Ok(())
}

#[test]
fn a_socket_timeout_is_not_a_bound_a_unix_socket_can_carry() {
    let _ = testing::check_ok(a_socket_timeout_is_not_a_bound_a_unix_socket_can_carry_steps(), "steps")
}

fn a_socket_timeout_is_not_a_bound_a_unix_socket_can_carry_steps() -> Result<(), errors::Error> {
    // A Unix socket has no read deadline to set, so the parameter parses and
    // connects and the wait is unbounded. A local peer that dies closes the
    // socket rather than going silent, which is the failure the deadline is
    // there for over a network.
    let url = test_url()
    if !url.contains("host=/") {
        let _ = testing::check(true, "the configured server is not a Unix socket")
        return Ok(())
    }
    let mut db = pgsql::connect(&format!("{} socket_timeout=1", url))?
    defer db.close()
    let slept = db.query(&"SELECT pg_sleep(2)", &#[])
    let _ = testing::check(slept.is_ok(), "the query runs to completion")
    let _ = testing::check(!db.is_closed(), "and the connection stays usable")
    Ok(())
}

#[test]
fn a_connection_reports_how_long_it_has_been_open() {
    let _ = testing::check_ok(a_connection_reports_how_long_it_has_been_open_steps(), "steps")
}

fn a_connection_reports_how_long_it_has_been_open_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    // A multi-host configuration reports whichever host answered, which is
    // what a program logging where it landed needs.
    let reached = db.host_addr()
    let _ = testing::check(
        reached.is_unix() || reached.tcp_addr() != ""
        &format!("the connection names the host it reached: {}", reached.tcp_addr())
    )
    let _ = testing::check(!db.in_failed_transaction(), "a fresh session is not poisoned")
    let _ = testing::check(db.age_ms() >= 0, "an age is reported")
    time::sleep(time::Duration::from_millis(120))
    let _ = testing::check(db.age_ms() >= 100, &format!("and it grows: {} ms", db.age_ms()))
    Ok(())
}

#[test]
fn a_statement_timeout_outlives_a_reset_because_startup_carries_it() {
    let _ = testing::check_ok(a_statement_timeout_outlives_a_reset_because_startup_carries_it_steps(), "steps")
}

fn a_statement_timeout_outlives_a_reset_because_startup_carries_it_steps() -> Result<(), errors::Error> {
    let mut db = pgsql::connect(&format!("{} statement_timeout=750", test_url()))?
    defer db.close()
    let set = db.query_value(&"SHOW statement_timeout", &#[])?
    let _ = testing::check_eq(&set.render(), &"750ms", "the session opens with it")

    db.reset_session()?
    let after = db.query_value(&"SHOW statement_timeout", &#[])?
    let _ = testing::check_eq(&after.render(), &"750ms", "and a reset does not drop it")

    let outcome = db.query(&"SELECT pg_sleep(3)", &#[])
    let _ = testing::check(outcome.is_err(), "a statement past it is cancelled")
    if let Err(e) = outcome {
        let _ = testing::check_eq(&pgsql::sqlstate_of(&e), &"57014", &format!("query_canceled: {}", e))
    }
    Ok(())
}

// --- the pool's session hygiene -----------------------------------

#[test]
fn a_returning_connection_leaves_none_of_its_session_behind() {
    let _ = testing::check_ok(a_returning_connection_leaves_none_of_its_session_behind_steps(), "steps")
}

fn a_returning_connection_leaves_none_of_its_session_behind_steps() -> Result<(), errors::Error> {
    let mut pool = pgsql::pool_open(&test_url(), 1)?
    let mut first = pool.acquire()?
    let opened = first.backend_pid()
    first.batch_execute(&"SET search_path = pg_catalog")?
    first.batch_execute(&"SET statement_timeout = 1234")?
    first.batch_execute(&"CREATE TEMP TABLE t_left_behind (x int)")?
    first.listen("t_left_behind_channel")?
    // A cached statement is the client's own, and outlives the reset.
    let _ = first.query(&"SELECT $1::bigint AS n", &#[pgsql::int(1)])?
    pool.release(first)

    let mut second = pool.acquire()?
    let _ = testing::check_eq(&second.backend_pid(), &opened, "the same connection came back")
    let _ = testing::check_eq(
        &second.query_value(&"SHOW search_path", &#[])?.render()
        &"\"$user\", public"
        "search_path is back to the session default"
    )
    let _ = testing::check_eq(
        &second.query_value(&"SHOW statement_timeout", &#[])?.render()
        &"0"
        "statement_timeout is back to the session default"
    )
    let temps = second.query_value(
        &"SELECT count(*) FROM pg_class WHERE relname = 't_left_behind'"
        &#[]
    )?
    let _ = testing::check_eq(&temps.as_int().unwrap_or(-1), &0, "the temporary table is gone")
    let listens = second.query_value(
        &"SELECT count(*) FROM pg_listening_channels() c WHERE c = 't_left_behind_channel'"
        &#[]
    )?
    let _ = testing::check_eq(&listens.as_int().unwrap_or(-1), &0, "the listen registration is gone")

    let cached = second.query(&"SELECT $1::bigint AS n", &#[pgsql::int(2)])?
    let _ = testing::check_eq(&cached[0].i64_of("n")?, &2, "a cached statement still runs")
    pool.release(second)
    pool.close_idle()
    Ok(())
}

#[test]
fn the_session_reset_can_be_turned_off() {
    let _ = testing::check_ok(the_session_reset_can_be_turned_off_steps(), "steps")
}

fn the_session_reset_can_be_turned_off_steps() -> Result<(), errors::Error> {
    let mut pool = pgsql::pool_open(&test_url(), 1)?
    pool.set_reset_on_release(false)
    let mut first = pool.acquire()?
    first.batch_execute(&"SET search_path = pg_catalog")?
    pool.release(first)
    let mut second = pool.acquire()?
    let _ = testing::check_eq(
        &second.query_value(&"SHOW search_path", &#[])?.render()
        &"pg_catalog"
        "what a borrower set stays when the reset is off"
    )
    pool.release(second)
    pool.close_idle()
    Ok(())
}

#[test]
fn a_pool_retires_a_connection_that_has_lived_long_enough() {
    let _ = testing::check_ok(a_pool_retires_a_connection_that_has_lived_long_enough_steps(), "steps")
}

fn a_pool_retires_a_connection_that_has_lived_long_enough_steps() -> Result<(), errors::Error> {
    let mut pool = pgsql::pool_open(&test_url(), 2)?
    pool.set_max_lifetime(300)

    let mut first = pool.acquire()?
    let opened = first.backend_pid()
    pool.release(first)
    let mut within = pool.acquire()?
    let _ = testing::check_eq(&within.backend_pid(), &opened, "a young connection is reused")
    pool.release(within)

    time::sleep(time::Duration::from_millis(400))
    let mut past = pool.acquire()?
    let _ = testing::check(past.backend_pid() != opened, "an aged one is replaced")
    let _ = testing::check_eq(&pool.live_count(), &1, "and is not still counted as live")
    let _ = testing::check_eq(&past.query_value(&"SELECT 1", &#[])?.as_int().unwrap_or(0), &1, "usable")
    pool.release(past)
    pool.close_idle()
    let _ = testing::check_eq(&pool.live_count(), &0, "closing the idle ones empties the pool")
    Ok(())
}

#[test]
fn a_pool_reuses_its_connections_and_caps_them() {
    let _ = testing::check_ok(a_pool_reuses_its_connections_and_caps_them_steps(), "steps")
}

fn a_pool_reuses_its_connections_and_caps_them_steps() -> Result<(), errors::Error> {
    let mut pool = pgsql::pool_open(&test_url(), 2)?
    pool.warm(2)?
    let _ = testing::check_eq(&pool.idle_count(), &2, "two connections warmed")

    let mut first = pool.acquire()?
    let mut second = pool.acquire()?
    let _ = testing::check_eq(&pool.idle_count(), &0, "both are checked out")
    let _ = testing::check(
        pool.acquire().is_err()
        "a third checkout reports the pool is at its cap"
    )

    let a = first.query_value(&"SELECT 1", &#[])?
    let b = second.query_value(&"SELECT 2", &#[])?
    let _ = testing::check_eq(&a.as_int().unwrap_or(0), &1, "the first connection works")
    let _ = testing::check_eq(&b.as_int().unwrap_or(0), &2, "the second connection works")
    let _ = testing::check(
        first.backend_pid() != second.backend_pid()
        "they are different sessions"
    )

    pool.release(first)
    pool.release(second)
    let _ = testing::check_eq(&pool.idle_count(), &2, "both came back")

    // A connection left in a transaction is cleaned before it is reused.
    let mut third = pool.acquire()?
    let _ = third.transaction()?
    pool.release(third)
    let mut fourth = pool.acquire()?
    let _ = testing::check(
        !fourth.in_transaction()
        "the reused connection is not in a transaction"
    )
    pool.release(fourth)
    pool.close_idle()
    let _ = testing::check_eq(&pool.idle_count(), &0, "closing drops the idle connections")
    Ok(())
}

// --- concurrency --------------------------------------------------

#[test]
fn goroutines_each_work_on_their_own_connection() {
    let _ = testing::check_ok(goroutines_each_work_on_their_own_connection_steps(), "steps")
}

fn goroutines_each_work_on_their_own_connection_steps() -> Result<(), errors::Error> {
    // A connection is a request/response stream, so concurrent work takes
    // one connection each; a cohort keeps them accounted for.
    let url = test_url()
    cohort {
        let a = spawn(|| shard_total(&url, 1, 100))
        let b = spawn(|| shard_total(&url, 101, 200))
        let first = a.join()??
        let second = b.join()??
        let _ = testing::check_eq(&first, &5_050, "the first shard's sum")
        let _ = testing::check_eq(&second, &15_050, "the second shard's sum")
    }?
    Ok(())
}

fn shard_total(url: &String, low: i64, high: i64) -> Result<i64, errors::Error> {
    let mut db = pgsql::connect(url)?
    defer db.close()
    let total = db.query_value(
        &"SELECT sum(i)::int8 FROM generate_series($1::int4, $2::int4) AS s(i)"
        &#[pgsql::int(low), pgsql::int(high)]
    )?
    Ok(total.as_int().unwrap_or(0))
}
