        &"INSERT INTO t_returning (name) VALUES ($1) RETURNING id"
        &#[pgsql::text("first")]
    )?
    let _ = testing::check_eq(&id.as_int().unwrap_or(-1), &1, "the first serial id")
    db.batch_execute(&"DROP TABLE t_returning")?
    Ok(())
}

#[test]
fn query_one_and_query_opt_report_the_wrong_row_count() {
    let _ = testing::check_ok(query_one_and_query_opt_report_the_wrong_row_count_steps(), "steps")
}

fn query_one_and_query_opt_report_the_wrong_row_count_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let _ = testing::check(
        db.query_one(&"SELECT 1 WHERE false", &#[]).is_err()
        "query_one reports an empty result"
    )
    let _ = testing::check(
        db.query_one(&"SELECT * FROM (VALUES (1), (2)) AS v", &#[]).is_err()
        "query_one reports two rows"
    )
    let _ = testing::check(
        db.query_opt(&"SELECT 1 WHERE false", &#[])?.is_none()
        "query_opt accepts no rows"
    )
    let _ = testing::check(
        db.query_opt(&"SELECT 1", &#[])?.is_some()
        "query_opt accepts one row"
    )
    let _ = testing::check(
        db.query_opt(&"SELECT * FROM (VALUES (1), (2)) AS v", &#[]).is_err()
        "query_opt reports two rows"
    )
    Ok(())
}

#[test]
fn a_row_stream_reads_a_large_result_without_holding_it() {
    let _ = testing::check_ok(a_row_stream_reads_a_large_result_without_holding_it_steps(), "steps")
}

fn a_row_stream_reads_a_large_result_without_holding_it_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let mut stream = db.query_raw(&"SELECT i FROM generate_series(1, 5000) AS s(i)", &#[])?
    let mut count = 0
    let mut total = 0
    loop {
        match db.next_row(&mut stream)? {
            Some(row) => {
                count += 1
                total += row.i64_at(0)?
            }
            None => break
        }
    }
    let _ = testing::check_eq(&count, &5_000, "every row arrived")
    let _ = testing::check_eq(&total, &12_502_500, "the values are the series")
    let _ = testing::check(stream.is_done(), "the stream reports it is finished")
    // The connection is usable straight after a drained stream.
    db.ping()?
    Ok(())
}

#[test]
fn an_abandoned_stream_leaves_the_connection_usable() {
    let _ = testing::check_ok(an_abandoned_stream_leaves_the_connection_usable_steps(), "steps")
}

fn an_abandoned_stream_leaves_the_connection_usable_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let mut stream = db.query_raw(&"SELECT i FROM generate_series(1, 5000) AS s(i)", &#[])?
    let _ = db.next_row(&mut stream)?
    db.close_stream(&mut stream)?
    // Whatever the server was still sending has been drained.
    let after = db.query_value(&"SELECT 7", &#[])?
    let _ = testing::check_eq(&after.as_int().unwrap_or(0), &7, "the next query is unaffected")
    Ok(())
}

#[test]
fn a_prepared_statement_runs_repeatedly_and_reports_its_shape() {
    let _ = testing::check_ok(a_prepared_statement_runs_repeatedly_and_reports_its_shape_steps(), "steps")
}

fn a_prepared_statement_runs_repeatedly_and_reports_its_shape_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let stmt = db.prepare(&"SELECT $1::int4 + $2::int4 AS total")?
    let _ = testing::check_eq(&stmt.param_count(), &2, "two parameters")
    let _ = testing::check_eq(&stmt.columns.len(), &1, "one column")
    let _ = testing::check_eq(&stmt.columns[0].name, &"total", "column name")
    let _ = testing::check_eq(
        &stmt.columns[0].type_oid
        &pgsql::oid::INT4
        "column type"
    )
    let mut sum = 0
    let inputs: Vec<i64> = #[1, 2, 3]
    for n in inputs {
        let row = db.query_one(&"SELECT $1::int4 + $2::int4 AS total", &#[pgsql::int(n), pgsql::int(10)])?
        sum += row.i64_of("total")?
    }
    let _ = testing::check_eq(&sum, &36, "three runs of the cached statement")
    db.close_statement(&stmt)?
    Ok(())
}

#[test]
fn the_statement_cache_is_bounded_and_deallocates_what_it_drops() {
    let _ = testing::check_ok(the_statement_cache_is_bounded_and_deallocates_what_it_drops_steps(), "steps")
}

fn the_statement_cache_is_bounded_and_deallocates_what_it_drops_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let _ = testing::check_eq(
        &db.statement_cache_capacity()
        &pgsql::client::DEFAULT_STATEMENT_CACHE_CAPACITY
        "a client starts with the default capacity"
    )
    db.set_statement_cache_capacity(4)

    // Ten distinct statements through a cache that holds four.
    for n in 0..10 {
        let row = db.query_one(&format!("SELECT {}::int4 + $1::int4 AS total", n), &#[pgsql::int(1)])?
        let _ = testing::check_eq(&row.i64_of("total")?, &(n + 1), "the statement ran")
    }
    let _ = testing::check_eq(&db.statement_cache_len(), &4, "the cache holds its capacity")

    // The server holds no more than the cache does: an evicted statement is
    // deallocated rather than left behind for the session's lifetime. The
    // count goes through the simple protocol, so asking does not prepare a
    // statement of its own and perturb what it measures.
    let _ = testing::check_eq(
        &prepared_count(&mut db)?
        &4
        "the server holds only what the cache holds"
    )

    // The most recent four are the ones kept, so re-running one does not
    // grow the cache.
    let _ = db.query_one(&"SELECT 9::int4 + $1::int4 AS total", &#[pgsql::int(1)])?
    let _ = testing::check_eq(&db.statement_cache_len(), &4, "a cached statement does not grow it")

    db.clear_statement_cache()
    let _ = testing::check_eq(&db.statement_cache_len(), &0, "clearing empties the cache")
    let _ = testing::check_eq(
        &prepared_count(&mut db)?
        &0
        "clearing deallocates on the server too"
    )
    db.ping()?
    Ok(())
}

#[test]
fn the_least_recently_used_statement_is_the_one_evicted() {
    let _ = testing::check_ok(the_least_recently_used_statement_is_the_one_evicted_steps(), "steps")
}

fn the_least_recently_used_statement_is_the_one_evicted_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.set_statement_cache_capacity(2)
    let first = "SELECT 1::int4 AS n"
    let second = "SELECT 2::int4 AS n"
    let third = "SELECT 3::int4 AS n"
    let _ = db.query_one(&first, &#[])?
    let _ = db.query_one(&second, &#[])?
    // Reaching for the first again makes the second the least recent.
    let _ = db.query_one(&first, &#[])?
    let _ = db.query_one(&third, &#[])?
    let _ = testing::check_eq(&db.statement_cache_len(), &2, "still two")

    // The kept pair is the first and the third, so re-running either leaves
    // the cache alone while the second has to be prepared again.
    let _ = db.query_one(&first, &#[])?
    let _ = db.query_one(&third, &#[])?
    let _ = testing::check_eq(&db.statement_cache_len(), &2, "the recent pair was kept")
    Ok(())
}

#[test]
fn a_cache_capacity_of_zero_prepares_every_call() {
    let _ = testing::check_ok(a_cache_capacity_of_zero_prepares_every_call_steps(), "steps")
}

fn a_cache_capacity_of_zero_prepares_every_call_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.set_statement_cache_capacity(0)
    for n in 0..3 {
        let row = db.query_one(&format!("SELECT {}::int4 AS n", n), &#[])?
        let _ = testing::check_eq(&row.i64_of("n")?, &n, "the statement still runs")
    }
    let _ = testing::check_eq(&db.statement_cache_len(), &0, "nothing is cached")
    Ok(())
}

