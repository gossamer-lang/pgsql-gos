// Integration tests: every one of these talks to a real PostgreSQL server.
//
// The server is named by `GOS_PGSQL_TEST_URL`, defaulting to a local Unix
// socket. Every test opens its own connection, so an unreachable server
// fails them all with the same report.
//
//     GOS_PGSQL_TEST_URL='host=/var/run/postgresql dbname=gos_pgsql_test' \
//         gos test .
//
// Each test owns its own tables, named after the test, and drops them on the
// way in, so a run leaves nothing behind and a crashed run does not poison
// the next one.
//
// A test whose steps are fallible is a wrapper around a `_steps` function
// that returns them: `check_ok` records the failure, so a step that fails
// reports as one rather than as a test that ended early.

use std::sync::channel_unbounded
use std::{env, errors, testing, time}

use "github.com/danpozmanter/pgsql-gos" as pgsql

fn test_url() -> String {
    match env::var("GOS_PGSQL_TEST_URL") {
        Some(v) => v
        None => "host=/var/run/postgresql dbname=gos_pgsql_test"
    }
}

// Named for the package, not `connect`: a bare `connect()` would be
// ambiguous with the driver's own one-argument `connect`.
fn open_test_db() -> Result<pgsql::client::Client, errors::Error> {
    pgsql::connect(&test_url())
}

// The statements this session holds on the server, counted through the
// simple query protocol so the question does not prepare one of its own.
fn prepared_count(db: &mut pgsql::client::Client) -> Result<i64, errors::Error> {
    let results = db.simple_query(&"SELECT count(*) FROM pg_prepared_statements")?
    match results.first() {
        Some(result) => match result.rows.first() {
            Some(row) => Ok(row[0].as_int().unwrap_or(-1))
            None => Err(errors::new("pg_prepared_statements answered no row"))
        }
        None => Err(errors::new("pg_prepared_statements answered no result"))
    }
}

// --- connection and session ---------------------------------------

#[test]
fn a_limiter_caps_connections_opened_from_several_goroutines() {
    let _ = testing::check_ok(a_limiter_caps_connections_opened_from_several_goroutines_steps(), "steps")
}

fn a_limiter_caps_connections_opened_from_several_goroutines_steps() -> Result<(), errors::Error> {
    let limiter = pgsql::limit_open(&test_url(), 3)?
    let _ = testing::check_eq(&limiter.size(), &3, "the cap is reported")
    let (results, collected) = channel_unbounded()
    cohort {
        for n in 0..9 {
            spawn(|| results.send(limited_shard(&limiter, n).unwrap_or(-1)))
        }
    }?
    results.close()
    let mut total = 0
    let mut counted = 0
    while let Some(doubled) = collected.recv() {
        total += doubled
        counted += 1
    }
    let _ = testing::check_eq(&counted, &9, "every goroutine answered")
    let _ = testing::check_eq(&total, &72, "each doubled its own number")

    // The permits come back, so the limiter is reusable.
    let mut again = limiter.acquire()?
    let _ = testing::check(!again.is_closed(), "a connection is still available")
    limiter.release(again)
    Ok(())
}

fn limited_shard(limiter: &pgsql::pool::Limiter, n: i64) -> Result<i64, errors::Error> {
    let mut db = limiter.acquire()?
    let row = db.query_one(&"SELECT $1::int4 * 2 AS doubled", &#[pgsql::int(n)])?
    let doubled = row.i64_of("doubled")?
    limiter.release(db)
    Ok(doubled)
}

#[test]
fn a_limiter_gives_its_permit_back_when_a_connection_fails() {
    let _ = testing::check_ok(a_limiter_gives_its_permit_back_when_a_connection_fails_steps(), "steps")
}

fn a_limiter_gives_its_permit_back_when_a_connection_fails_steps() -> Result<(), errors::Error> {
    let limiter = pgsql::limit_open(&"host=127.0.0.1 port=59999 dbname=nothing connect_timeout=1", 1)?
    // Both attempts have to reach the server, which means the first gave its
    // permit back rather than draining the only one.
    for _attempt in 0..2 {
        let _ = testing::check(limiter.acquire().is_err(), "an unreachable server is reported")
    }
    Ok(())
}

#[test]
fn a_connection_reports_the_session_it_opened() {
    let _ = testing::check_ok(a_connection_reports_the_session_it_opened_steps(), "steps")
}

fn a_connection_reports_the_session_it_opened_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let _ = testing::check(db.server_version() != "", "server_version is reported")
    let _ = testing::check(db.backend_pid() > 0, "backend pid is reported")
    let _ = testing::check(!db.is_closed(), "connection is open")
    let _ = testing::check(!db.in_transaction(), "session starts outside a transaction")
    let _ = testing::check_eq(
        &db.parameter("client_encoding").unwrap_or("")
        &"UTF8"
        "client_encoding was set by the startup message"
    )
    let _ = testing::check(
        db.parameter("application_name").unwrap_or("") == "pgsql-gos"
        "application_name defaults to the driver name"
    )
    db.ping()?
    Ok(())
}

#[test]
fn a_bad_password_is_reported_rather_than_hanging() {
    // A TCP connection to a server that wants a password, with none given,
    // must report that plainly. Skipped when no TCP server is configured.
    match env::var("GOS_PGSQL_TCP_URL") {
        Some(url) => {
            let stripped = url.replace("password=gos_pgsql_test", "")
            match pgsql::connect(&stripped) {
                Ok(mut db) => {
                    // A trust-authenticated server is a valid answer too.
                    db.close()
                    let _ = testing::check(true, "server did not ask for a password")
                }
                Err(e) => {
                    let text = format!("{}", e)
                    let _ = testing::check(
                        text.contains("password") || text.contains("authentication")
                        &format!("reported: {}", text)
                    )
                }
            }
        }
        None => { let _ = testing::check(true, "no TCP server configured") }
    }
}

#[test]
fn an_unreachable_host_reports_the_address_it_tried() {
    // Port 1 is reserved and never a PostgreSQL server.
    match pgsql::connect(&"host=127.0.0.1 port=1 dbname=nothing user=nobody connect_timeout=2") {
        Ok(mut db) => { db.close(); let _ = testing::check(false, "expected a failure") }
        Err(e) => {
            let text = format!("{}", e)
            let _ = testing::check(
                text.contains("127.0.0.1:1")
                &format!("names the address it tried: {}", text)
            )
        }
    }
}

// --- statements and types -----------------------------------------

#[test]
fn scalars_round_trip_through_bound_parameters() {
    let _ = testing::check_ok(scalars_round_trip_through_bound_parameters_steps(), "steps")
}

fn scalars_round_trip_through_bound_parameters_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"SELECT $1::int4 AS i, $2::int8 AS big, $3::float8 AS f, $4::bool AS b, $5::text AS t"
        &#[pgsql::int(42), pgsql::int(9_007_199_254_740_991), pgsql::float(1.5), pgsql::boolean(true), pgsql::text("hello")]
    )?
    let _ = testing::check_eq(&row.i64_of("i")?, &42, "int4")
    let _ = testing::check_eq(&row.i64_of("big")?, &9_007_199_254_740_991, "int8")
    let _ = testing::check_eq(&row.f64_of("f")?, &1.5, "float8")
    let _ = testing::check(row.bool_of("b")?, "bool")
    let _ = testing::check_eq(&row.text_of("t")?, &"hello", "text")
    Ok(())
}

#[test]
fn null_binds_and_reads_back_as_null() {
    let _ = testing::check_ok(null_binds_and_reads_back_as_null_steps(), "steps")
}

fn null_binds_and_reads_back_as_null_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"SELECT $1::int4 AS maybe, $2::text AS words"
        &#[pgsql::null(), pgsql::opt_text(None)]
    )?
    let _ = testing::check(row.is_null_of("maybe"), "null int is null")
    let _ = testing::check(row.is_null_of("words"), "null text is null")
    let _ = testing::check(row.opt_i64_of("maybe")?.is_none(), "opt_i64 answers None")
    let _ = testing::check(row.opt_text_of("words")?.is_none(), "opt_text answers None")
    Ok(())
}

#[test]
fn numeric_keeps_every_digit_the_server_sent() {
    let _ = testing::check_ok(numeric_keeps_every_digit_the_server_sent_steps(), "steps")
}

fn numeric_keeps_every_digit_the_server_sent_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"SELECT $1::numeric AS exact, 12345678901234567890.123456789::numeric AS wide"
        &#[pgsql::numeric("0.10000000000000000001")]
    )?
    let _ = testing::check_eq(
        &row.text_of("exact")?
        &"0.10000000000000000001"
        "a bound numeric round-trips exactly"
    )
    let _ = testing::check_eq(
        &row.text_of("wide")?
        &"12345678901234567890.123456789"
        "a numeric wider than f64 keeps its digits"
    )
    Ok(())
}

#[test]
fn bytea_round_trips_including_embedded_nul() {
    let _ = testing::check_ok(bytea_round_trips_including_embedded_nul_steps(), "steps")
}

fn bytea_round_trips_including_embedded_nul_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let payload: Vec<u8> = #[0, 1, 254, 255, 10, 13, 92]
    let row = db.query_one(&"SELECT $1::bytea AS blob", &#[pgsql::bytes(payload)])?
    let back = row.bytes_of("blob")?
    let _ = testing::check_eq(&back.len(), &7, "byte count")
    let _ = testing::check_eq(&(back[0] as i64), &0, "embedded NUL survives")
    let _ = testing::check_eq(&(back[3] as i64), &255, "high byte survives")
    let _ = testing::check_eq(&(back[6] as i64), &92, "backslash survives")
    Ok(())
}

#[test]
fn arrays_round_trip_with_nulls_and_quoting() {
    let _ = testing::check_ok(arrays_round_trip_with_nulls_and_quoting_steps(), "steps")
}

fn arrays_round_trip_with_nulls_and_quoting_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"SELECT $1::int4[] AS ints, $2::text[] AS words, ARRAY[1, NULL, 3]::int4[] AS holey"
        &#[pgsql::int_array(#[1, 2, 3]), pgsql::text_array(#["plain", "has,comma", "has\"quote"])]
    )?
    let ints = row.array_of("ints")?
    let _ = testing::check_eq(&ints.len(), &3, "three ints")
    let _ = testing::check_eq(&ints[2].as_int().unwrap_or(0), &3, "third int")

    let words = row.array_of("words")?
    let _ = testing::check_eq(&words.len(), &3, "three words")
    let _ = testing::check_eq(&words[1].as_text().unwrap_or(""), &"has,comma", "comma survives")
    let _ = testing::check_eq(&words[2].as_text().unwrap_or(""), &"has\"quote", "quote survives")

    let holey = row.array_of("holey")?
    let _ = testing::check_eq(&holey.len(), &3, "three slots")
    let _ = testing::check(holey[1].is_null(), "the middle element is NULL")
    Ok(())
}

#[test]
fn a_nested_array_keeps_its_shape() {
    let _ = testing::check_ok(a_nested_array_keeps_its_shape_steps(), "steps")
}

fn a_nested_array_keeps_its_shape_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(&"SELECT ARRAY[ARRAY[1,2],ARRAY[3,4]]::int4[][] AS grid", &#[])?
    let rows = row.array_of("grid")?
    let _ = testing::check_eq(&rows.len(), &2, "two rows")
    match rows[1].as_array() {
        Some(second) => {
            let _ = testing::check_eq(&second.len(), &2, "two columns")
            let _ = testing::check_eq(&second[0].as_int().unwrap_or(0), &3, "value at [1][0]")
        }
        None => { let _ = testing::check(false, "the second row is an array") }
    }
    Ok(())
}

#[test]
fn a_composite_and_a_range_decode_to_their_parts() {
    let _ = testing::check_ok(a_composite_and_a_range_decode_to_their_parts_steps(), "steps")
}

fn a_composite_and_a_range_decode_to_their_parts_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"SELECT ROW(1, 'two, three', NULL)::record AS r, int4range(1, 5) AS span"
        &#[]
    )?
    let fields = row.record_of("r")?
    let _ = testing::check_eq(&fields.len(), &3, "three fields")
    let _ = testing::check_eq(&fields[0].as_int().unwrap_or(0), &1, "first field")
    let _ = testing::check_eq(
        &fields[1].as_text().unwrap_or("")
        &"two, three"
        "a field with a comma keeps it"
    )
    let _ = testing::check(fields[2].is_null(), "the empty field is NULL")

    let span = row.range_of("span")?
    let _ = testing::check(span.lower_inclusive, "lower bound is inclusive")
    let _ = testing::check(!span.upper_inclusive, "upper bound is exclusive")
    let _ = testing::check_eq(&span.lower.as_int().unwrap_or(0), &1, "lower bound")
    let _ = testing::check_eq(&span.upper.as_int().unwrap_or(0), &5, "upper bound")
    Ok(())
}

#[test]
fn timestamps_uuids_and_json_read_as_their_text_and_typed_forms() {
    let _ = testing::check_ok(timestamps_uuids_and_json_read_as_their_text_and_typed_forms_steps(), "steps")
}

fn timestamps_uuids_and_json_read_as_their_text_and_typed_forms_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(
        &"""
        SELECT '2026-08-16 12:34:56+00'::timestamptz AS at,
               '00112233-4455-6677-8899-aabbccddeeff'::uuid AS id,
               '{"a": 1}'::jsonb AS doc,
               '192.168.1.1'::inet AS addr
        """
        &#[]
    )?
    let _ = testing::check_eq(
        &row.text_of("id")?
        &"00112233-4455-6677-8899-aabbccddeeff"
        "uuid text"
    )
    let _ = testing::check(row.text_of("doc")?.contains("\"a\""), "jsonb text")
    let _ = testing::check_eq(&row.text_of("addr")?, &"192.168.1.1", "inet text")
    let at = row.timestamp_of("at")?
    let _ = testing::check_eq(
        &at.to_utc().to_rfc3339()
        &"2026-08-16T12:34:56Z"
        "timestamptz parsed"
    )
    let _ = testing::check_eq(
        &time::format_rfc3339(row.system_time_of("at")?)?
        &"2026-08-16T12:34:56Z"
        "the same instant as a std wall-clock reading"
    )
    Ok(())
}

#[test]
fn temporal_columns_read_as_typed_values_at_full_precision() {
    let _ = testing::check_ok(temporal_columns_read_as_typed_values_at_full_precision_steps(), "steps")
}

fn temporal_columns_read_as_typed_values_at_full_precision_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"SET TIME ZONE 'UTC'")?
    let row = db.query_one(
        &"""
        SELECT '2026-08-16 12:34:56.789012+00'::timestamptz AS at,
               '2026-08-16 12:34:56.789012'::timestamp AS naive,
               '2026-08-16'::date AS on_day,
               '12:34:56.5'::time AS at_time,
               '1 year 2 mons 3 days 04:05:06.789'::interval AS span,
               '00112233-4455-6677-8899-aabbccddeeff'::uuid AS id,
               '{"a": 1}'::jsonb AS doc
        """
        &#[]
    )?
    let at = row.timestamp_of("at")?
    let _ = testing::check_eq(&at.micros, &789_012, "microseconds survive the typed reader")
    let _ = testing::check_eq(
        &at.to_utc().to_rfc3339()
        &"2026-08-16T12:34:56.789012Z"
        "the instant, in RFC 3339"
    )
    let _ = testing::check_eq(&at.to_string(), &"2026-08-16 12:34:56.789012+00", "as the server wrote it")

    let naive = row.timestamp_of("naive")?
    let _ = testing::check(naive.offset_minutes.is_none(), "a timestamp without a zone carries none")

    let day = row.date_of("on_day")?
    let _ = testing::check_eq(&day.to_string(), &"2026-08-16", "date")
    let _ = testing::check_eq(&day.year, &2026, "date year")

    let clock = row.time_of("at_time")?
    let _ = testing::check_eq(&clock.to_string(), &"12:34:56.5", "time")
    let _ = testing::check_eq(&clock.micros, &500_000, "half a second")

    let span = row.interval_of("span")?
    let _ = testing::check_eq(&span.months, &14, "interval months")
    let _ = testing::check_eq(&span.days, &3, "interval days")
    let _ = testing::check_eq(&span.to_string(), &"1 year 2 mons 3 days 04:05:06.789", "interval text")

    let id = row.uuid_of("id")?
    let _ = testing::check_eq(&id.bytes.len(), &16, "a uuid is sixteen bytes")
    let _ = testing::check_eq(
        &id.to_string()
        &"00112233-4455-6677-8899-aabbccddeeff"
        "uuid renders canonically"
    )
    let _ = testing::check(row.json_of("doc")?.contains("\"a\""), "jsonb document")

    // And every one of them still reads as the text the server wrote.
    let _ = testing::check_eq(
        &row.text_of("at")?
        &"2026-08-16 12:34:56.789012+00"
        "the text reading is unchanged"
    )
    Ok(())
}

#[test]
fn typed_values_round_trip_as_parameters() {
    let _ = testing::check_ok(typed_values_round_trip_as_parameters_steps(), "steps")
}

fn typed_values_round_trip_as_parameters_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"SET TIME ZONE 'UTC'")?
    db.batch_execute(&"DROP TABLE IF EXISTS t_typed")?
    db.batch_execute(
        &"""
        CREATE TABLE t_typed (
            at timestamptz, on_day date, at_time time,
            span interval, id uuid, doc jsonb
        )
        """
    )?
    let at = pgsql::parse_timestamp(&"2026-08-16 12:34:56.789012+00")?
    let day = pgsql::parse_date(&"2026-08-16")?
    let clock = pgsql::parse_time(&"12:34:56.5")?
    let span = pgsql::parse_interval(&"1 year 2 mons 3 days 04:05:06.789")?
    let id = pgsql::parse_uuid(&"00112233-4455-6677-8899-aabbccddeeff")?
    let inserted = db.execute(
        &"INSERT INTO t_typed VALUES ($1, $2, $3, $4, $5, $6)"
        &#[
            pgsql::timestamp(at)
            pgsql::date(day)
            pgsql::time(clock)
            pgsql::interval(span)
            pgsql::uuid(id)
            pgsql::json("{\"a\": 1}")
        ]
    )?
    let _ = testing::check_eq(&inserted, &1, "one row inserted")

    for format in #[pgsql::value::FORMAT_TEXT, pgsql::value::FORMAT_BINARY] {
        db.set_result_format(format)
        let row = db.query_one(&"SELECT * FROM t_typed", &#[])?
        let _ = testing::check_eq(
            &row.timestamp_of("at")?.to_utc().to_rfc3339()
            &"2026-08-16T12:34:56.789012Z"
            &format!("timestamptz round trip in format {}", format)
        )
        let _ = testing::check_eq(
            &row.date_of("on_day")?.to_string()
            &"2026-08-16"
            &format!("date round trip in format {}", format)
        )
        let _ = testing::check_eq(
            &row.time_of("at_time")?.to_string()
            &"12:34:56.5"
            &format!("time round trip in format {}", format)
        )
        let _ = testing::check_eq(
            &row.interval_of("span")?.to_string()
            &"1 year 2 mons 3 days 04:05:06.789"
            &format!("interval round trip in format {}", format)
        )
        let _ = testing::check_eq(
            &row.uuid_of("id")?.to_string()
            &"00112233-4455-6677-8899-aabbccddeeff"
            &format!("uuid round trip in format {}", format)
        )
        let _ = testing::check(
            row.json_of("doc")?.contains("\"a\"")
            &format!("jsonb round trip in format {}", format)
        )
    }
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    db.batch_execute(&"DROP TABLE t_typed")?
    Ok(())
}

#[test]
fn the_two_infinities_survive_a_round_trip() {
    let _ = testing::check_ok(the_two_infinities_survive_a_round_trip_steps(), "steps")
}

fn the_two_infinities_survive_a_round_trip_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    for format in #[pgsql::value::FORMAT_TEXT, pgsql::value::FORMAT_BINARY] {
        db.set_result_format(format)
        let row = db.query_one(
            &"SELECT 'infinity'::timestamptz AS hi, '-infinity'::date AS lo"
            &#[]
        )?
        let _ = testing::check_eq(
            &row.timestamp_of("hi")?.to_string()
            &"infinity"
            &format!("infinity in format {}", format)
        )
        let _ = testing::check_eq(
            &row.date_of("lo")?.to_string()
            &"-infinity"
            &format!("-infinity in format {}", format)
        )
    }
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    Ok(())
}

#[test]
fn a_multirange_reads_as_its_ranges() {
    let _ = testing::check_ok(a_multirange_reads_as_its_ranges_steps(), "steps")
}

fn a_multirange_reads_as_its_ranges_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    // Multiranges arrived in PostgreSQL 14; an older server has nothing to
    // read here.
    let supported = db.query_one(
        &"SELECT current_setting('server_version_num')::int >= 140000 AS ok"
        &#[]
    )?
    if !supported.bool_of("ok")? {
        return Ok(())
    }
    let row = db.query_one(
        &"""
        SELECT '{[1,4),[7,10)}'::int4multirange AS spans,
               '{}'::int4multirange AS none
        """
        &#[]
    )?
    let spans = row.multirange_of("spans")?
    let _ = testing::check_eq(&spans.len(), &2, "two ranges")
    let _ = testing::check_eq(&spans[0].lower.as_int().unwrap_or(0), &1, "first lower bound")
    let _ = testing::check(spans[0].lower_inclusive, "first lower bound is inclusive")
    let _ = testing::check(!spans[0].upper_inclusive, "first upper bound is exclusive")
    let _ = testing::check_eq(&spans[1].upper.as_int().unwrap_or(0), &10, "second upper bound")
    let _ = testing::check_eq(&row.multirange_of("none")?.len(), &0, "an empty multirange")

    // The binary format carries the same ranges.
    db.set_result_format(pgsql::value::FORMAT_BINARY)
    let binary = db.query_one(&"SELECT '{[1,4),[7,10)}'::int4multirange AS spans", &#[])?
    let binary_spans = binary.multirange_of("spans")?
    let _ = testing::check_eq(&binary_spans.len(), &2, "two ranges in binary")
    let _ = testing::check_eq(
        &binary_spans[1].upper.as_int().unwrap_or(0)
        &10
        "second upper bound in binary"
    )
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    Ok(())
}

#[test]
fn a_range_reads_the_same_in_both_wire_formats() {
    let _ = testing::check_ok(a_range_reads_the_same_in_both_wire_formats_steps(), "steps")
}

fn a_range_reads_the_same_in_both_wire_formats_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"SET TIME ZONE 'UTC'")?
    let sql = """
    SELECT '[1,5)'::int4range AS bounded,
           '(,10]'::int8range AS unbounded_below,
           '[3,)'::int8range AS unbounded_above,
           'empty'::int4range AS none,
           '["2026-08-16 00:00:00+00","2026-08-17 00:00:00+00")'::tstzrange AS window
    """
    for format in #[pgsql::value::FORMAT_TEXT, pgsql::value::FORMAT_BINARY] {
        db.set_result_format(format)
        let row = db.query_one(&sql, &#[])?
        let bounded = row.range_of("bounded")?
        let _ = testing::check_eq(
            &bounded.lower.as_int().unwrap_or(0)
            &1
            &format!("lower bound in format {}", format)
        )
        let _ = testing::check(bounded.lower_inclusive, "lower bound is inclusive")
        let _ = testing::check(!bounded.upper_inclusive, "upper bound is exclusive")

        let below = row.range_of("unbounded_below")?
        let _ = testing::check(
            below.lower.is_null()
            &format!("no lower bound in format {}", format)
        )
        let _ = testing::check_eq(
            &below.upper.as_int().unwrap_or(0)
            &11
            "an inclusive int upper bound is normalized to the exclusive one"
        )

        let above = row.range_of("unbounded_above")?
        let _ = testing::check(
            above.upper.is_null()
            &format!("no upper bound in format {}", format)
        )

        let _ = testing::check(
            row.range_of("none")?.is_empty
            &format!("the empty range in format {}", format)
        )

        let window = row.range_of("window")?
        let _ = testing::check_eq(
            &window.lower.as_text().unwrap_or("")
            &"2026-08-16 00:00:00+00"
            &format!("a timestamptz bound in format {}", format)
        )
    }
    db.set_result_format(pgsql::value::FORMAT_TEXT)
    Ok(())
}

#[test]
fn a_row_renders_as_json_typed_by_its_columns() {
    let _ = testing::check_ok(a_row_renders_as_json_typed_by_its_columns_steps(), "steps")
}

fn a_row_renders_as_json_typed_by_its_columns_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"SET TIME ZONE 'UTC'")?
    let document = db.query_one_json(
        &"""
        SELECT 7::int8 AS id, 'Ada'::text AS name, 1.5::float8 AS ratio,
               true AS active, NULL::text AS note,
               ARRAY['one', 'two']::text[] AS tags,
               '{"a": 1}'::jsonb AS doc
        """
        &#[]
    )?
    let _ = testing::check_eq(
        &document
        &"{\"id\":7,\"name\":\"Ada\",\"ratio\":1.5,\"active\":true,\"note\":null,\"tags\":[\"one\",\"two\"],\"doc\":{\"a\": 1}}"
        "one row as json"
    )
    let rows = db.query_json(&"SELECT generate_series(1, 3) AS n", &#[])?
    let _ = testing::check_eq(&rows, &"[{\"n\":1},{\"n\":2},{\"n\":3}]", "a result set as json")
    Ok(())
}

#[test]
fn binary_result_format_decodes_the_same_values() {
    let _ = testing::check_ok(binary_result_format_decodes_the_same_values_steps(), "steps")
}

fn binary_result_format_decodes_the_same_values_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.set_result_format(pgsql::value::FORMAT_BINARY)
    let row = db.query_one(
        &"""
        SELECT 42::int4 AS i, 9007199254740991::int8 AS big, true AS b,
               'hello'::text AS t, '\\x00ff'::bytea AS blob,
               '00112233-4455-6677-8899-aabbccddeeff'::uuid AS id,
               123.45::numeric AS n
        """
        &#[]
    )?
    let _ = testing::check_eq(&row.i64_of("i")?, &42, "int4 in binary")
    let _ = testing::check_eq(&row.i64_of("big")?, &9_007_199_254_740_991, "int8 in binary")
    let _ = testing::check(row.bool_of("b")?, "bool in binary")
    let _ = testing::check_eq(&row.text_of("t")?, &"hello", "text in binary")
    let _ = testing::check_eq(&row.bytes_of("blob")?.len(), &2, "bytea in binary")
    let _ = testing::check_eq(
        &row.text_of("id")?
        &"00112233-4455-6677-8899-aabbccddeeff"
        "uuid in binary"
    )
    let _ = testing::check_eq(&row.text_of("n")?, &"123.45", "numeric in binary")
    Ok(())
}

#[test]
fn every_type_with_a_binary_reading_decodes_alike_in_either_wire_format() {
    let _ = testing::check_ok(
        every_type_with_a_binary_reading_decodes_alike_in_either_wire_format_steps()
        "steps"
    )
}

// The types the driver documents as carrying a binary reading. A value that
// decodes to one thing in text format and another in binary is a codec bug
// that a caller only sees after switching formats, so the two are compared
// against each other rather than against a spelling written here.
fn cross_format_cases() -> Vec<String> {
    #[
        "true", "false"
        "0::int2", "(-32768)::int2", "32767::int2"
        "0::int4", "(-2147483648)::int4", "2147483647::int4"
        "0::int8", "(-9223372036854775808)::int8", "9223372036854775807::int8"
        "1.5::float4", "(-0.125)::float4", "'NaN'::float4", "'Infinity'::float4"
        "1.5::float8", "1e-300::float8", "'NaN'::float8", "'-Infinity'::float8"
        "0::numeric", "1::numeric", "(-1)::numeric", "0.1::numeric"
        "0.00000001::numeric", "(-0.00000001)::numeric", "1e-25::numeric"
        "12345.6789::numeric", "'NaN'::numeric", "0.5000::numeric"
        "''::text", "'ascii'::text", "'h\u{e9}llo \u{65e5}\u{672c}\u{8a9e}'::text"
        "'x'::varchar", "'y'::bpchar", "'z'::name", "'c'::\"char\""
        "'\\x'::bytea", "'\\x00ff00'::bytea"
        "'{\"a\":[1,2,null]}'::json", "'{\"a\":[1,2,null]}'::jsonb"
        "'0193c1f4-1f10-7000-8000-0123456789ab'::uuid"
        "2200::oid"
        "'2026-08-22'::date", "'0001-01-01'::date", "'infinity'::date", "'-infinity'::date"
        "'12:34:56.789012'::time", "'00:00:00'::time", "'23:59:59.999999'::time"
        "'12:34:56.789012+02'::timetz"
        "'2026-08-22 12:34:56.789012'::timestamp", "'infinity'::timestamp"
        "'2026-08-22 12:34:56.789012+02'::timestamptz", "'-infinity'::timestamptz"
        "'1 year 2 mons 3 days 04:05:06.789'::interval", "'-1 day'::interval", "'0'::interval"
        "ARRAY[1,2,3]::int8[]", "ARRAY[]::int8[]", "ARRAY[NULL]::int8[]"
        "ARRAY['a',NULL,'b,c']::text[]", "ARRAY[[1,2],[3,4]]::int8[]"
        "ARRAY[1.5,2.5]::float8[]", "ARRAY[true,false]::bool[]"
        "'[1,10)'::int4range", "'empty'::int4range", "'(,5]'::int4range"
        "'[2020-01-01,2021-01-01)'::daterange"
        "'{[1,3),[5,7)}'::int4multirange", "'{}'::int4multirange"
        "NULL::int8", "NULL::text", "NULL::numeric"
    ]
}

fn every_type_with_a_binary_reading_decodes_alike_in_either_wire_format_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    // The zone decides what a `timestamptz` renders as, so it is pinned
    // rather than inherited from the server's own setting.
    db.batch_execute(&"SET TimeZone = 'UTC'")?

    let mut disagreed: Vec<String> = #[]
    for case in cross_format_cases() {
        let sql = format!("SELECT {} AS v", case)
        db.set_result_format(pgsql::value::FORMAT_TEXT)
        let as_text = db.query_value(&sql, &#[])?.render()
        db.set_result_format(pgsql::value::FORMAT_BINARY)
        let as_binary = db.query_value(&sql, &#[])?.render()
        if as_text != as_binary {
            disagreed.push(format!("{}: text `{}` vs binary `{}`", case, as_text, as_binary))
        }
    }
    let _ = testing::check_eq(
        &disagreed.len()
        &0
        &format!("the two wire formats agree: {}", disagreed.join("; "))
    )
    let _ = testing::check(cross_format_cases().len() > 60, "the sweep covers the surface")
    Ok(())
}

#[test]
fn every_column_reads_the_same_by_index_as_it_does_by_name() {
    let _ = testing::check_ok(every_column_reads_the_same_by_index_as_it_does_by_name_steps(), "steps")
}

fn every_column_reads_the_same_by_index_as_it_does_by_name_steps() -> Result<(), errors::Error> {
    // `_at` and `_of` are the same reading reached two ways, so the whole
    // index-addressed half of `Row` is checked against the named half rather
    // than against spellings written here.
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"SET TimeZone = 'UTC'")?
    let row = db.query_one(
        &"""
        SELECT 42::int8 AS a_int, 1.5::float8 AS a_float, true AS a_bool,
               'hello'::text AS a_text, '\\x00ff'::bytea AS a_bytes,
               ARRAY[1,2,3]::int8[] AS an_array, ROW(1,'x')::record AS a_record,
               '[1,10)'::int4range AS a_range, '{[1,3),[5,7)}'::int4multirange AS a_multirange,
               '2026-08-23 12:34:56.789012+00'::timestamptz AS a_stamp,
               '2026-08-23'::date AS a_date, '12:34:56'::time AS a_time,
               '1 day'::interval AS a_span,
               '0193c1f4-1f10-7000-8000-0123456789ab'::uuid AS an_id,
               '{"k":1}'::jsonb AS a_doc, NULL::int8 AS a_null
        """
        &#[]
    )?
    let _ = testing::check_eq(&row.width(), &16, "every column arrived")

    let _ = testing::check_eq(&row.i64_at(0)?, &row.i64_of("a_int")?, "i64")
    let _ = testing::check_eq(&row.f64_at(1)?, &row.f64_of("a_float")?, "f64")
    let _ = testing::check_eq(&row.bool_at(2)?, &row.bool_of("a_bool")?, "bool")
    let _ = testing::check_eq(&row.text_at(3)?, &row.text_of("a_text")?, "text")
    let _ = testing::check_eq(&row.bytes_at(4)?, &row.bytes_of("a_bytes")?, "bytes")
    let _ = testing::check_eq(
        &row.array_at(5)?.map(|v| v.render())
        &row.array_of("an_array")?.map(|v| v.render())
        "array"
    )
    let _ = testing::check_eq(
        &row.record_at(6)?.map(|v| v.render())
        &row.record_of("a_record")?.map(|v| v.render())
        "record"
    )
    let _ = testing::check_eq(
        &row.range_at(7)?.lower.render()
        &row.range_of("a_range")?.lower.render()
        "range"
    )
    let _ = testing::check_eq(
        &row.multirange_at(8)?.len()
        &row.multirange_of("a_multirange")?.len()
        "multirange"
    )
    let _ = testing::check_eq(
        &row.timestamp_at(9)?.to_unix_micros()
        &row.timestamp_of("a_stamp")?.to_unix_micros()
        "timestamp"
    )
    let _ = testing::check_eq(
        &row.system_time_at(9)?
        &row.system_time_of("a_stamp")?
        "the millisecond reading of the same column"
    )
    let _ = testing::check_eq(&row.date_at(10)?.to_string(), &row.date_of("a_date")?.to_string(), "date")
    let _ = testing::check_eq(&row.time_at(11)?.to_string(), &row.time_of("a_time")?.to_string(), "time")
    let _ = testing::check_eq(
        &row.interval_at(12)?.to_string()
        &row.interval_of("a_span")?.to_string()
        "interval"
    )
    let _ = testing::check_eq(&row.uuid_at(13)?.to_string(), &row.uuid_of("an_id")?.to_string(), "uuid")
    let _ = testing::check_eq(&row.json_at(14)?, &row.json_of("a_doc")?, "json")
    let _ = testing::check_eq(&row.is_null_at(15), &row.is_null_of("a_null"), "is_null")

    // The optional readings agree too, and answer `None` for the NULL.
    let _ = testing::check_eq(&row.opt_i64_at(0)?, &row.opt_i64_of("a_int")?, "opt_i64")
    let _ = testing::check_eq(&row.opt_f64_at(1)?, &row.opt_f64_of("a_float")?, "opt_f64")
    let _ = testing::check_eq(&row.opt_text_at(3)?, &row.opt_text_of("a_text")?, "opt_text")
    let _ = testing::check(row.opt_i64_at(15)?.is_none(), "a NULL column is None by index")
    let _ = testing::check(row.opt_i64_of("a_null")?.is_none(), "and by name")

    // The column's own OID is what the JSON rendering reads.
    let _ = testing::check_eq(&row.type_at(0), &pgsql::oid::INT8, "the first column's type")
    let _ = testing::check_eq(&row.type_at(3), &pgsql::oid::TEXT, "and the fourth's")
    let _ = testing::check_eq(&row.type_at(99), &0, "a column past the end has no type")
    Ok(())
}

#[test]
fn a_read_past_the_last_column_reports_rather_than_ending_the_program() {
    let _ = testing::check_ok(
        a_read_past_the_last_column_reports_rather_than_ending_the_program_steps()
        "steps"
    )
}

fn a_read_past_the_last_column_reports_rather_than_ending_the_program_steps()
-> Result<(), errors::Error>
{
    let mut db = open_test_db()?
    defer db.close()
    let row = db.query_one(&"SELECT 1 AS only", &#[])?
    let _ = testing::check_eq(&row.width(), &1, "one column")
    let _ = testing::check(row.i64_at(5).is_err(), "an index past the end reports")
    let _ = testing::check(row.text_at(-1).is_err(), "and so does a negative one")
    let _ = testing::check(row.i64_of("absent").is_err(), "as does an unknown name")
    let _ = testing::check_eq(&row.index_of("absent"), &-1, "which has no index")
    let _ = testing::check_eq(&row.index_of("only"), &0, "and the one that is there does")
    let _ = testing::check(row.is_null_at(5), "past the end reads as NULL rather than panicking")
    // Reading a text column as an integer is a report, not a wrong answer.
    let word = db.query_one(&"SELECT 'abc' AS w", &#[])?
    let _ = testing::check(word.i64_at(0).is_err(), "a word is no integer")
    Ok(())
}

// --- executing and querying ---------------------------------------

#[test]
fn a_table_takes_inserts_updates_and_deletes() {
    let _ = testing::check_ok(a_table_takes_inserts_updates_and_deletes_steps(), "steps")
}

fn a_table_takes_inserts_updates_and_deletes_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_crud")?
    db.batch_execute(&"CREATE TABLE t_crud (id serial PRIMARY KEY, name text NOT NULL, score int4)")?

    let inserted = db.execute(
        &"INSERT INTO t_crud (name, score) VALUES ($1, $2), ($3, $4)"
        &#[pgsql::text("ada"), pgsql::int(10), pgsql::text("grace"), pgsql::int(20)]
    )?
    let _ = testing::check_eq(&inserted, &2, "two rows inserted")

    let updated = db.execute(&"UPDATE t_crud SET score = score + 1 WHERE name = $1", &#[pgsql::text("ada")])?
    let _ = testing::check_eq(&updated, &1, "one row updated")

    let rows = db.query(&"SELECT name, score FROM t_crud ORDER BY name", &#[])?
    let _ = testing::check_eq(&rows.len(), &2, "two rows read back")
    let _ = testing::check_eq(&rows[0].text_of("name")?, &"ada", "first name")
    let _ = testing::check_eq(&rows[0].i64_of("score")?, &11, "updated score")

    let deleted = db.execute(&"DELETE FROM t_crud WHERE score > $1", &#[pgsql::int(15)])?
    let _ = testing::check_eq(&deleted, &1, "one row deleted")

    let remaining = db.query_value(&"SELECT count(*) FROM t_crud", &#[])?
    let _ = testing::check_eq(&remaining.as_int().unwrap_or(-1), &1, "one row remains")

    db.batch_execute(&"DROP TABLE t_crud")?
    Ok(())
}

#[test]
fn returning_answers_the_generated_row() {
    let _ = testing::check_ok(returning_answers_the_generated_row_steps(), "steps")
}

fn returning_answers_the_generated_row_steps() -> Result<(), errors::Error> {
    let mut db = open_test_db()?
    defer db.close()
    db.batch_execute(&"DROP TABLE IF EXISTS t_returning")?
    db.batch_execute(&"CREATE TABLE t_returning (id serial PRIMARY KEY, name text)")?
