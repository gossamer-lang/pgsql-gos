// The value model crossing the wire, and its codecs.
//
// A `Value` is what a parameter is bound from and what a column decodes to.
// The set is deliberately small - the shapes a program computes with - and
// the column's type OID stays alongside it, so a caller that wants the
// server's exact spelling of a `numeric`, a timestamp, or a geometric type
// reads `Text` and parses it, while integers, floats, booleans, byte
// strings, arrays, and composites arrive already structured.
//
// Both wire formats are implemented in both directions. Text is the
// default: every PostgreSQL type has a text representation, including ones
// with no binary reading here, so a query never fails because the driver
// lacks a binary decoder. Binary is available per statement for the types
// that carry one.

use std::{errors, math}

use crate::{buf, oid}

// Wire format codes, as the Bind message spells them. Text is the default
// because every type has a text representation; binary is per statement.
pub const FORMAT_TEXT: i64 = 0
pub const FORMAT_BINARY: i64 = 1

// A bound parameter or a decoded column.
pub enum Value {
    // SQL NULL.
    Null
    // `bool`.
    Bool(bool)
    // Any integer type, and `oid`.
    Int(i64)
    // `float4` / `float8`.
    Float(f64)
    // `numeric`, and any type whose exact spelling matters: the digits the
    // server sent, unrounded.
    Numeric(String)
    // Character data, and every type read as its text form.
    Text(String)
    // `bytea`.
    Bytes(Vec<u8>)
}

impl Value {
    // True for SQL NULL.
    pub fn is_null(&self) -> bool {
        matches!(self, Value::Null)
    }

    // The value as an `i64`, converting a float, a numeric, or a decimal
    // text form; `None` for NULL or a non-numeric reading.
    pub fn as_int(&self) -> Option<i64> {
        match self {
            Value::Int(v) => Some(v)
            Value::Bool(b) => Some(if b { 1 } else { 0 })
            Value::Float(f) => Some(f as i64)
            Value::Numeric(text) | Value::Text(text) => text.to_i64()
            _ => None
        }
    }

    // The value as an `f64`; `None` for NULL or a non-numeric reading.
    pub fn as_float(&self) -> Option<f64> {
        match self {
            Value::Float(f) => Some(f)
            Value::Int(v) => Some(v as f64)
            Value::Numeric(text) | Value::Text(text) => text.to_f64()
            _ => None
        }
    }

    // The value as a `bool`, reading the server's `t` / `f` text form too.
    pub fn as_bool(&self) -> Option<bool> {
        match self {
            Value::Bool(b) => Some(b)
            Value::Int(v) => Some(v != 0)
            Value::Text(text) => match text {
                "t" | "true" | "TRUE" | "y" | "yes" | "on" | "1" => Some(true)
                "f" | "false" | "FALSE" | "n" | "no" | "off" | "0" => Some(false)
                _ => None
            }
            _ => None
        }
    }

    // The value's text form. Every non-NULL value has one, so this is the
    // reading that always answers.
    pub fn as_text(&self) -> Option<String> {
        match self {
            Value::Null => None
            _ => Some(self.render())
        }
    }

    // The value's bytes: a `bytea` directly, any other value's text form
    // as UTF-8.
    pub fn as_bytes(&self) -> Option<Vec<u8>> {
        match self {
            Value::Null => None
            Value::Bytes(data) => Some(data.clone())
            _ => Some(self.render().as_bytes())
        }
    }

    // The elements of an array literal, with each element read as text.
    //
    // A column's own element type is known to the row that holds it, so
    // `Row::array_at` decodes the elements under that type; this reads them
    // as the text the server wrote.
    pub fn as_array(&self) -> Option<Vec<Value>> {
        let Some(text) = self.as_text() else { return None }
        parse_array_literal(&text, oid::TEXT).ok()
    }

    // The fields of a composite literal, each read as text.
    pub fn as_record(&self) -> Option<Vec<Value>> {
        let Some(text) = self.as_text() else { return None }
        parse_record_literal(&text).ok()
    }

    // The value rendered the way PostgreSQL writes it in text format. This
    // is what a text-format parameter sends and what `as_text` answers.
    pub fn render(&self) -> String {
        match self {
            Value::Null => ""
            Value::Bool(b) => if b { "t" } else { "f" }
            Value::Int(v) => v.to_string()
            Value::Float(f) => render_float(f)
            Value::Numeric(text) | Value::Text(text) => text.clone()
            Value::Bytes(data) => "\\x" + &buf::to_hex(data)
        }
    }
}

// A float in the form PostgreSQL accepts and emits: infinities and NaN by
// name, everything else in the shortest round-tripping decimal form.
pub fn render_float(f: f64) -> String {
    if math::is_nan(f) {
        return "NaN"
    }
    if math::is_inf(f, 1) {
        return "Infinity"
    }
    if math::is_inf(f, -1) {
        return "-Infinity"
    }
    f.to_string()
}

// The array literal for `items`, quoting each element the grammar needs
// quoted. This is what an array parameter binds as and what an array column
// reads back as, so building and reading share one spelling.
pub fn render_array_literal(items: &Vec<Value>) -> String {
    let mut parts: Vec<String> = #[]
    for item in items {
        parts.push(match item {
            Value::Null => "NULL"
            _ => quote_composite_element(&item.render())
        })
    }
    "{" + &parts.join(",") + "}"
}

// The array literal for a list of already-rendered element literals, used to
// nest one array inside another: a nested literal is not quoted.
pub fn render_nested_array_literal(elements: &Vec<String>) -> String {
    "{" + &elements.join(",") + "}"
}

// A composite literal (`(1,two,)`).
pub fn render_record_literal(fields: &Vec<Value>) -> String {
    let mut parts: Vec<String> = #[]
    for field in fields {
        parts.push(match field {
            Value::Null => ""
            _ => quote_composite_element(&field.render())
        })
    }
    "(" + &parts.join(",") + ")"
}

// Quotes an array or composite element when it holds a byte the literal
// grammar would otherwise read as structure, or when it is empty or spells
// NULL.
//
// Byte offsets throughout: every character the grammar reserves is ASCII, so
// a multi-byte character copies through untouched.
fn quote_composite_element(text: &String) -> String {
    let needs = text.is_empty() || text.to_uppercase() == "NULL" ||
        text.bytes().any(|byte| is_reserved_byte(byte as i64))
    if !needs {
        return text.clone()
    }
    let mut out: Vec<u8> = #[34]
    for byte in text.bytes() {
        // A quote or a backslash inside a quoted element is escaped.
        if byte == 34 || byte == 92 {
            out.push(92)
        }
        out.push(byte)
    }
    out.push(34)
    buf::utf8_lossy(&out)
}

// The bytes an array or composite literal reads as structure rather than as
// element text: the delimiters, the quote, the escape, and whitespace.
fn is_reserved_byte(byte: i64) -> bool {
    matches!(byte, 44 | 123 | 125 | 40 | 41 | 34 | 92 | 32 | 9 | 10 | 13)
}

// --- text decoding -------------------------------------------------

// Decodes a column's text form under its type OID.
//
// A type with no more specific reading answers `Text` carrying exactly what
// the server sent, so nothing is ever lost: the caller can parse the
// server's spelling itself.
pub fn decode_text(type_oid: i64, raw: &Vec<u8>) -> Value {
    let text = buf::utf8_lossy(raw)
    // An array or a composite keeps the literal the server wrote. It is the
    // exact value, and the element types belong to the column rather than to
    // the value, so parsing waits for a caller that knows them.
    if oid::is_array(type_oid) {
        return Value::Text(text)
    }
    match type_oid {
        oid::BOOL => Value::Bool(text == "t")
        oid::BYTEA => match decode_bytea_text(&text) {
            Ok(data) => Value::Bytes(data)
            Err(_) => Value::Text(text)
        }
        oid::FLOAT4 | oid::FLOAT8 => match parse_float_text(&text) {
            Some(f) => Value::Float(f)
            None => Value::Text(text)
        }
        oid::NUMERIC | oid::MONEY => Value::Numeric(text)
        _ => {
            if oid::is_integer(type_oid) {
                match text.to_i64() {
                    Some(v) => Value::Int(v)
                    None => Value::Text(text)
                }
            } else {
                Value::Text(text)
            }
        }
    }
}

// A float in PostgreSQL's text form, including the named infinities.
pub fn parse_float_text(text: &String) -> Option<f64> {
    match text {
        "NaN" => Some(nan())
        "Infinity" | "inf" | "+Infinity" => Some(infinity())
        "-Infinity" | "-inf" => Some(-infinity())
        _ => text.to_f64()
    }
}

// IEEE-754 not-a-number.
pub fn nan() -> f64 {
    math::sqrt(-1.0)
}

// IEEE-754 positive infinity.
pub fn infinity() -> f64 {
    math::MAX_F64 * 2.0
}

// Decodes `bytea` text output: hex (`\x00ff`, the default since 9.0) or the
// historical escape format.
pub fn decode_bytea_text(text: &String) -> Result<Vec<u8>, errors::Error> {
    if text.starts_with("\\x") {
        return buf::from_hex(&text.substring(2, text.byte_len()))
    }
    let n = text.byte_len()
    let mut out: Vec<u8> = #[]
    let mut i = 0
    while i < n {
        let c = text.byte_at(i)
        if c != 92 {
            out.push(c as u8)
            i += 1
            continue
        }
        // A backslash escapes either itself or a three-digit octal byte.
        if i + 1 < n && text.byte_at(i + 1) == 92 {
            out.push(92)
            i += 2
            continue
        }
        if i + 3 < n {
            let a = text.byte_at(i + 1) - 48
            let b = text.byte_at(i + 2) - 48
            let c3 = text.byte_at(i + 3) - 48
            if a >= 0 && a <= 7 && b >= 0 && b <= 7 && c3 >= 0 && c3 <= 7 {
                out.push(((a << 6) | (b << 3) | c3) as u8)
                i += 4
                continue
            }
        }
        return Err(errors::newf("bytea escape format: bad escape at offset {}", i))
    }
    Ok(out)
}

// Parses an array literal into elements, decoding each under `elem_oid`.
//
// Handles any dimensionality, the explicit-bounds prefix
// (`[1:2]={a,b}`), quoted elements with backslash escapes, and the
// unquoted `NULL` element.
pub fn parse_array_literal(text: &String, elem_oid: i64) -> Result<Vec<Value>, errors::Error> {
    let body = strip_dimension_prefix(text)
    let trimmed = body.trim()
    if trimmed == "" {
        return Ok(#[])
    }
    if !trimmed.starts_with("{") {
        return Err(errors::newf("array literal must start with `{{`: {}", trimmed))
    }
    let close = matching_brace(&trimmed, 0)?
    let rest = trimmed.substring(close + 1, trimmed.byte_len()).trim()
    if rest != "" {
        return Err(errors::newf("trailing text after array literal: {}", rest))
    }
    parse_array_body(&trimmed.substring(0, close + 1), elem_oid)
}

// Drops an explicit-bounds prefix like `[1:3]=` that the server emits when
// an array's lower bound is not 1.
fn strip_dimension_prefix(text: &String) -> String {
    let t = text.trim()
    if !t.starts_with("[") {
        return t
    }
    match t.find("=") {
        Some(eq) => t.substring(eq + 1, t.byte_len())
        None => t
    }
}

// Parses the `{...}` at the start of `text` into its elements.
//
// One flat pass: a nested array is carried as its own literal, found by
// matching its braces, so an array of any dimensionality is read without
// recursion and every element is the text the server wrote.
fn parse_array_body(text: &String, elem_oid: i64) -> Result<Vec<Value>, errors::Error> {
    let n = text.byte_len()
    let mut items: Vec<Value> = #[]
    let mut i = 1
    while i < n && is_space_byte(text.byte_at(i)) {
        i += 1
    }
    // `{}` closes immediately.
    if i < n && text.byte_at(i) == 125 {
        return Ok(items)
    }
    while i < n {
        while i < n && is_space_byte(text.byte_at(i)) {
            i += 1
        }
        if i >= n {
            break
        }
        let c = text.byte_at(i)
        if c == 123 {
            let close = matching_brace(text, i)?
            items.push(Value::Text(text.substring(i, close + 1)))
            i = close + 1
        } else if c == 34 {
            let (raw, next) = read_quoted(text, i)?
            items.push(decode_text(elem_oid, &raw.as_bytes()))
            i = next
        } else {
            let (raw, next) = read_bare(text, i)
            if raw.to_uppercase() == "NULL" {
                items.push(Value::Null)
            } else {
                items.push(decode_text(elem_oid, &raw.as_bytes()))
            }
            i = next
        }
        while i < n && is_space_byte(text.byte_at(i)) {
            i += 1
        }
        if i >= n {
            return Err(errors::new("unterminated array literal"))
        }
        let sep = text.byte_at(i)
        if sep == 125 {
            return Ok(items)
        }
        if sep != 44 {
            return Err(errors::newf("unexpected byte in array literal at offset {}", i))
        }
        i += 1
    }
    Err(errors::new("unterminated array literal"))
}

// Offset of the `}` closing the `{` at `open`, honoring nesting and quoted
// elements.
fn matching_brace(text: &String, open: i64) -> Result<i64, errors::Error> {
    let n = text.byte_len()
    let mut depth = 0
    let mut i = open
    let mut quoted = false
    while i < n {
        let c = text.byte_at(i)
        if quoted {
            if c == 92 {
                i += 2
                continue
            }
            if c == 34 {
                quoted = false
            }
            i += 1
            continue
        }
        if c == 34 {
            quoted = true
        } else if c == 123 {
            depth += 1
        } else if c == 125 {
            depth -= 1
            if depth == 0 {
                return Ok(i)
            }
        }
        i += 1
    }
    Err(errors::new("unterminated array literal"))
}

// Parses a composite literal (`(1,"two",)`) into its fields. Every field
// decodes as text: a record's field types are not on the wire, so the
// caller converts with the accessors on `Value`.
pub fn parse_record_literal(text: &String) -> Result<Vec<Value>, errors::Error> {
    let t = text.trim()
    if !t.starts_with("(") || !t.ends_with(")") {
        return Err(errors::newf("composite literal must be parenthesized: {}", t))
    }
    let n = t.byte_len()
    let mut fields: Vec<Value> = #[]
    let mut i = 1
    // `()` is the no-field composite.
    if n == 2 {
        return Ok(fields)
    }
    loop {
        if i >= n {
            return Err(errors::new("unterminated composite literal"))
        }
        let c = t.byte_at(i)
        if c == 34 {
            let (raw, next) = read_quoted(t, i)?
            fields.push(Value::Text(raw))
            i = next
        } else if c == 44 || c == 41 {
            // An empty field is NULL.
            fields.push(Value::Null)
        } else {
            let (raw, next) = read_bare_record(t, i)
            fields.push(Value::Text(raw))
            i = next
        }
        if i >= n {
            return Err(errors::new("unterminated composite literal"))
        }
        let sep = t.byte_at(i)
        if sep == 41 {
            return Ok(fields)
        }
        if sep != 44 {
            return Err(errors::newf("unexpected byte in composite literal at offset {}", i))
        }
        i += 1
    }
}

// A range literal's bounds and inclusivity, as the server writes them
// (`[1,5)`, `empty`).
pub struct Range {
    pub is_empty: bool
    pub lower_inclusive: bool
    pub upper_inclusive: bool
    // A NULL bound is unbounded on that side.
    pub lower: Value
    pub upper: Value
}

// Parses a range literal, decoding each bound under `elem_oid`.
pub fn parse_range_literal(text: &String, elem_oid: i64) -> Result<Range, errors::Error> {
    let t = text.trim()
    if t.to_lowercase() == "empty" {
        return Ok(Range {
            is_empty: true
            lower_inclusive: false
            upper_inclusive: false
            lower: Value::Null
            upper: Value::Null
        })
    }
    let n = t.byte_len()
    if n < 3 {
        return Err(errors::newf("range literal too short: {}", t))
    }
    let open = t.byte_at(0)
    let close = t.byte_at(n - 1)
    if (open != 91 && open != 40) || (close != 93 && close != 41) {
        return Err(errors::newf("range literal must be bracketed: {}", t))
    }
    let inner = t.substring(1, n - 1)
    let (lower_raw, upper_raw) = split_range_bounds(&inner)?
    Ok(Range {
        is_empty: false
        lower_inclusive: open == 91
        upper_inclusive: close == 93
        lower: decode_bound(&lower_raw, elem_oid)
        upper: decode_bound(&upper_raw, elem_oid)
    })
}

fn decode_bound(raw: &String, elem_oid: i64) -> Value {
    if raw == "" {
        return Value::Null
    }
    if raw.starts_with("\"") {
        return match read_quoted(raw, 0) {
            Ok((text, _)) => decode_text(elem_oid, &text.as_bytes())
            Err(_) => Value::Text(raw.clone())
        }
    }
    decode_text(elem_oid, &raw.as_bytes())
}

// Splits a range's inner text at the comma that separates the bounds,
// ignoring a comma inside a quoted bound.
fn split_range_bounds(inner: &String) -> Result<(String, String), errors::Error> {
    let n = inner.byte_len()
    let mut i = 0
    let mut quoted = false
    while i < n {
        let c = inner.byte_at(i)
        if c == 92 && quoted {
            i += 2
            continue
        }
        if c == 34 {
            quoted = !quoted
        } else if c == 44 && !quoted {
            return Ok((inner.substring(0, i), inner.substring(i + 1, n)))
        }
        i += 1
    }
    Err(errors::newf("range literal has no bound separator: {}", inner))
}

fn is_space_byte(c: i64) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

// Reads a double-quoted element starting at `start`, returning its
// unescaped contents and the offset just past the closing quote.
fn read_quoted(text: &String, start: i64) -> Result<(String, i64), errors::Error> {
    let n = text.byte_len()
    // Byte offsets, so a multi-byte character inside the element is copied
    // through unchanged rather than re-decoded per byte.
    let mut out_bytes: Vec<u8> = #[]
    let mut i = start + 1
    while i < n {
        let c = text.byte_at(i)
        if c == 92 {
            if i + 1 >= n {
                return Err(errors::new("literal ends in a backslash"))
            }
            out_bytes.push(text.byte_at(i + 1) as u8)
            i += 2
            continue
        }
        if c == 34 {
            return Ok((buf::utf8_lossy(&out_bytes), i + 1))
        }
        out_bytes.push(c as u8)
        i += 1
    }
    Err(errors::new("unterminated quoted element"))
}

// Reads an unquoted array element: everything up to a comma or a brace.
fn read_bare(text: &String, start: i64) -> (String, i64) {
    let n = text.byte_len()
    let mut end = start
    while end < n {
        let c = text.byte_at(end)
        if c == 44 || c == 125 || c == 123 {
            break
        }
        end += 1
    }
    // Trailing whitespace before the separator is not part of the value.
    let mut stop = end
    while stop > start && is_space_byte(text.byte_at(stop - 1)) {
        stop -= 1
    }
    (text.substring(start, stop), end)
}

// Reads an unquoted composite field: everything up to a comma or the
// closing parenthesis. Unlike an array element, whitespace is significant.
fn read_bare_record(text: &String, start: i64) -> (String, i64) {
    let n = text.byte_len()
    let mut end = start
    while end < n {
        let c = text.byte_at(end)
        if c == 44 || c == 41 {
            break
        }
        end += 1
    }
    (text.substring(start, end), end)
}

// --- binary coding -------------------------------------------------

// Decodes a column's binary form under its type OID.
//
// Only the types with a binary reading here are decoded; anything else
// answers its bytes as `Bytes`, since a binary payload has no text form to
// fall back on. Ask for text format for those (the default).
pub fn decode_binary(type_oid: i64, raw: &Vec<u8>) -> Value {
    if oid::is_array(type_oid) {
        return match decode_binary_array(raw) {
            Ok(literal) => Value::Text(literal)
            Err(_) => Value::Bytes(raw.clone())
        }
    }
    match type_oid {
        oid::BOOL => Value::Bool(buf::u8_at(raw, 0) != 0)
        oid::CHAR => Value::Int(buf::u8_at(raw, 0))
        oid::INT2 => Value::Int(buf::i16_at(raw, 0))
        oid::INT4 | oid::OID | oid::XID | oid::CID | oid::REGPROC => Value::Int(buf::i32_at(raw, 0))
        oid::INT8 => Value::Int(buf::i64_at(raw, 0))
        oid::FLOAT4 => Value::Float(f32_from_bits(buf::u32_at(raw, 0)))
        oid::FLOAT8 => Value::Float(f64_from_bits(buf::i64_at(raw, 0)))
        oid::TEXT | oid::VARCHAR | oid::BPCHAR | oid::NAME | oid::JSON | oid::XML
        | oid::CSTRING => Value::Text(buf::utf8_lossy(raw))
        oid::JSONB => {
            // A jsonb binary payload is a one-byte version prefix then the
            // document as text.
            if buf::u8_at(raw, 0) == 1 {
                Value::Text(buf::utf8_lossy(&buf::slice(raw, 1, raw.len())))
            } else {
                Value::Text(buf::utf8_lossy(raw))
            }
        }
        oid::UUID => Value::Text(render_uuid(raw))
        oid::NUMERIC => match decode_binary_numeric(raw) {
            Ok(text) => Value::Numeric(text)
            Err(_) => Value::Bytes(raw.clone())
        }
        // `bytea` is already its bytes, and a type with no binary reading
        // here has no text form to fall back on, so it answers them too.
        _ => Value::Bytes(raw.clone())
    }
}

// Encodes a value in the binary format for `type_oid`, or `None` when the
// pair has no binary encoding here - the caller then sends it as text.
pub fn encode_binary(v: &Value, type_oid: i64) -> Option<Vec<u8>> {
    match v {
        Value::Bool(b) => encode_binary_bool(b, type_oid)
        Value::Int(n) => encode_binary_int(n, type_oid)
        Value::Text(text) => encode_binary_text(text, type_oid)
        Value::Bytes(data) => encode_binary_bytes(data, type_oid)
        // A float goes as text: its shortest round-tripping decimal form
        // names exactly one binary64, so nothing is lost. An array, a
        // composite, and a numeric go as their literal for the same reason.
        _ => None
    }
}

fn encode_binary_bool(b: bool, type_oid: i64) -> Option<Vec<u8>> {
    if type_oid != oid::BOOL {
        return None
    }
    let mut out: Vec<u8> = #[]
    buf::put_u8(&mut out, if b { 1 } else { 0 })
    Some(out)
}

fn encode_binary_int(n: i64, type_oid: i64) -> Option<Vec<u8>> {
    let mut out: Vec<u8> = #[]
    match type_oid {
        oid::INT2 => buf::put_i16(&mut out, n)
        oid::INT4 | oid::OID => buf::put_i32(&mut out, n)
        oid::INT8 => buf::put_i64(&mut out, n)
        _ => return None
    }
    Some(out)
}

fn encode_binary_text(text: &String, type_oid: i64) -> Option<Vec<u8>> {
    match type_oid {
        oid::TEXT | oid::VARCHAR | oid::BPCHAR | oid::NAME | oid::JSON | oid::XML
        | oid::CSTRING => Some(text.as_bytes())
        _ => None
    }
}

fn encode_binary_bytes(data: &Vec<u8>, type_oid: i64) -> Option<Vec<u8>> {
    if type_oid != oid::BYTEA {
        return None
    }
    Some(data.clone())
}

// A `uuid`'s 16 binary bytes in the canonical hyphenated form.
fn render_uuid(raw: &Vec<u8>) -> String {
    let hex = buf::to_hex(raw)
    if hex.byte_len() != 32 {
        return hex
    }
    hex.substring(0, 8) + "-" + &hex.substring(8, 12) + "-" + &hex.substring(12, 16) + "-"
    + &hex.substring(16, 20) + "-" + &hex.substring(20, 32)
}

// Decodes the binary `numeric` representation into its exact decimal text.
//
// The wire form is a count of base-10000 digit groups, the weight of the
// first group, a sign, a display scale, then the groups.
fn decode_binary_numeric(raw: &Vec<u8>) -> Result<String, errors::Error> {
    if raw.len() < 8 {
        return Err(errors::new("numeric binary payload too short"))
    }
    let ndigits = buf::u16_at(raw, 0)
    let weight = buf::i16_at(raw, 2)
    let sign = buf::u16_at(raw, 4)
    let dscale = buf::u16_at(raw, 6)
    if sign == 49_152 {
        return Ok("NaN")
    }
    if sign == 53_248 {
        return Ok("Infinity")
    }
    if sign == 61_440 {
        return Ok("-Infinity")
    }
    if raw.len() < 8 + ndigits * 2 {
        return Err(errors::new("numeric binary payload truncated"))
    }
    let mut groups: Vec<i64> = #[]
    for i in 0..ndigits {
        groups.push(buf::u16_at(raw, 8 + i * 2))
    }

    // Integer part: groups from `weight` down to 0, each four digits wide
    // after the first.
    let mut int_part = ""
    for g in 0..=weight {
        let group = if g < groups.len() { groups[g] } else { 0 }
        if int_part == "" {
            int_part = group.to_string()
        } else {
            int_part += format!("{:04}", group)
        }
    }
    if int_part == "" {
        int_part = "0"
    }

    // Fractional digits: the groups past the integer part, cut to the
    // declared display scale.
    let mut frac = ""
    for fg in max(weight + 1, 0)..groups.len() {
        frac += format!("{:04}", groups[fg])
    }
    while frac.byte_len() < dscale {
        frac += "0"
    }
    let frac_shown = frac.substring(0, dscale)

    let mut text = if sign == 16_384 { "-" + &int_part } else { int_part }
    if dscale > 0 {
        text += "." + &frac_shown
    }
    Ok(text)
}

// Decodes the binary array form into its text literal: dimensions, a null
// bitmap flag, the element OID, then each element length-prefixed. The
// literal is the value an array column carries, so a binary-format array
// reads back the same way a text-format one does.
fn decode_binary_array(raw: &Vec<u8>) -> Result<String, errors::Error> {
    if raw.len() < 12 {
        return Err(errors::new("array binary payload too short"))
    }
    let ndim = buf::i32_at(raw, 0)
    let elem_oid = buf::u32_at(raw, 8)
    if ndim == 0 {
        return Ok("{}")
    }
    if ndim < 0 {
        return Err(errors::new("array binary payload has a negative dimension count"))
    }
    let mut dims: Vec<i64> = #[]
    for i in 0..ndim {
        dims.push(buf::i32_at(raw, 12 + i * 8))
    }
    let mut total = 1
    for d in dims {
        total *= d
    }
    let mut off = 12 + ndim * 8
    let mut flat: Vec<Value> = #[]
    for _element in 0..total {
        let length = buf::i32_at(raw, off)
        off += 4
        if length < 0 {
            flat.push(Value::Null)
        } else {
            flat.push(decode_binary(elem_oid, &buf::slice(raw, off, off + length)))
            off += length
        }
    }
    Ok(nest_literal(&flat, &dims, 0))
}

// Reshapes a flat element list into a `dims`-shaped nested array literal.
fn nest_literal(flat: &Vec<Value>, dims: &Vec<i64>, depth: i64) -> String {
    if depth >= dims.len() - 1 {
        return render_array_literal(flat)
    }
    let mut inner_len = 1
    for d in dims.iter().skip(depth + 1) {
        inner_len *= d
    }
    let mut rows: Vec<String> = #[]
    let mut start = 0
    while start < flat.len() {
        let chunk: Vec<Value> = flat.iter().skip(start).take(inner_len).collect()
        rows.push(nest_literal(&chunk, dims, depth + 1))
        start += inner_len
    }
    render_nested_array_literal(&rows)
}

fn f64_from_bits(bits: i64) -> f64 {
    let sign = if (bits >> 63) & 1 == 1 { -1.0 } else { 1.0 }
    let exponent = (bits >> 52) & 2_047
    let mantissa = bits & 4_503_599_627_370_495
    if exponent == 2_047 {
        if mantissa == 0 {
            return sign * infinity()
        }
        return nan()
    }
    if exponent == 0 {
        return sign * (mantissa as f64) * pow2(-1_074)
    }
    sign * (1.0 + (mantissa as f64) * pow2(-52)) * pow2(exponent - 1_023)
}

fn f32_from_bits(bits: i64) -> f64 {
    let sign = if (bits >> 31) & 1 == 1 { -1.0 } else { 1.0 }
    let exponent = (bits >> 23) & 255
    let mantissa = bits & 8_388_607
    if exponent == 255 {
        if mantissa == 0 {
            return sign * infinity()
        }
        return nan()
    }
    if exponent == 0 {
        // Subnormal: no implicit leading one.
        return sign * (mantissa as f64) * pow2(-149)
    }
    sign * (1.0 + (mantissa as f64) * pow2(-23)) * pow2(exponent - 127)
}

// Two raised to `e`, by squaring. Exact for every exponent a binary32 or
// binary64 decode reaches, and no `math` dependency for one power.
fn pow2(e: i64) -> f64 {
    let mut acc = 1.0
    let mut base = 2.0
    let mut n = if e < 0 { -e } else { e }
    while n > 0 {
        if n % 2 == 1 {
            acc *= base
        }
        base *= base
        n /= 2
    }
    if e < 0 { 1.0 / acc } else { acc }
}

#[cfg(test)]
mod value_tests {
    use std::testing

    #[test]
    fn render_writes_postgres_text_forms() {
        let _ = testing::check_eq(&super::Value::Bool(true).render(), &"t", "true")
        let _ = testing::check_eq(&super::Value::Bool(false).render(), &"f", "false")
        let _ = testing::check_eq(&super::Value::Int(-7).render(), &"-7", "int")
        let _ = testing::check_eq(
            &super::Value::Bytes(#[0, 255]).render()
            &"\\x00ff"
            "bytea hex"
        )
    }

    #[test]
    fn decode_text_reads_scalars_by_oid() {
        let v = super::decode_text(oid::INT4, &"42".as_bytes())
        let _ = testing::check_eq(&v.as_int().unwrap_or(0), &42, "int4")
        let b = super::decode_text(oid::BOOL, &"t".as_bytes())
        let _ = testing::check(b.as_bool().unwrap_or(false), "bool true")
        let f = super::decode_text(oid::FLOAT8, &"1.5".as_bytes())
        let _ = testing::check_eq(&f.as_float().unwrap_or(0.0), &1.5, "float8")
    }

    #[test]
    fn numeric_keeps_every_digit_the_server_sent() {
        let v = super::decode_text(oid::NUMERIC, &"123456789012345678.90".as_bytes())
        let _ = testing::check_eq(
            &v.as_text().unwrap_or("")
            &"123456789012345678.90"
            "exact numeric"
        )
    }

    #[test]
    fn bytea_hex_and_escape_forms_both_decode() {
        match super::decode_bytea_text(&"\\x00ff10") {
            Ok(data) => {
                let _ = testing::check_eq(&data.len(), &3, "hex length")
                let _ = testing::check_eq(&(data[1] as i64), &255, "hex byte")
            }
            Err(e) => { let _ = testing::check(false, &format!("hex: {}", e)) }
        }
        match super::decode_bytea_text(&"ab\\000cd\\\\") {
            Ok(data) => {
                let _ = testing::check_eq(&data.len(), &6, "escape length")
                let _ = testing::check_eq(&(data[2] as i64), &0, "octal escape")
                let _ = testing::check_eq(&(data[5] as i64), &92, "escaped backslash")
            }
            Err(e) => { let _ = testing::check(false, &format!("escape: {}", e)) }
        }
    }

    #[test]
    fn array_literals_parse_with_nulls_quotes_and_nesting() {
        match super::parse_array_literal(&"{1,2,NULL}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(&items.len(), &3, "three elements")
                let _ = testing::check_eq(&items[0].as_int().unwrap_or(0), &1, "first")
                let _ = testing::check(items[2].is_null(), "third is NULL")
            }
            Err(e) => { let _ = testing::check(false, &format!("flat: {}", e)) }
        }
        match super::parse_array_literal(&"{{1,2},{3,4}}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(&items.len(), &2, "two rows")
                let row = items[0].as_array().unwrap_or(#[])
                let _ = testing::check_eq(&row.len(), &2, "two columns")
                let _ = testing::check_eq(&row[1].as_int().unwrap_or(0), &2, "nested value")
            }
            Err(e) => { let _ = testing::check(false, &format!("nested: {}", e)) }
        }
        match super::parse_array_literal(&"{\"a,b\",\"c\\\"d\",NULL}", oid::TEXT) {
            Ok(items) => {
                let _ = testing::check_eq(&items[0].as_text().unwrap_or(""), &"a,b", "quoted comma")
                let _ = testing::check_eq(&items[1].as_text().unwrap_or(""), &"c\"d", "escaped quote")
            }
            Err(e) => { let _ = testing::check(false, &format!("quoted: {}", e)) }
        }
    }

    #[test]
    fn an_empty_array_literal_has_no_elements() {
        match super::parse_array_literal(&"{}", oid::INT4) {
            Ok(items) => { let _ = testing::check_eq(&items.len(), &0, "empty") }
            Err(e) => { let _ = testing::check(false, &format!("empty: {}", e)) }
        }
    }

    #[test]
    fn an_explicit_bounds_prefix_is_dropped() {
        match super::parse_array_literal(&"[2:3]={7,8}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(&items.len(), &2, "two elements")
                let _ = testing::check_eq(&items[0].as_int().unwrap_or(0), &7, "first")
            }
            Err(e) => { let _ = testing::check(false, &format!("bounds: {}", e)) }
        }
    }

    #[test]
    fn arrays_round_trip_through_render_and_parse() {
        let text = super::render_array_literal(&#[
            super::Value::Text("plain"),
            super::Value::Text("has,comma"),
            super::Value::Null,
            super::Value::Text(""),
        ])
        match super::parse_array_literal(&text, oid::TEXT) {
            Ok(items) => {
                let _ = testing::check_eq(&items.len(), &4, "element count")
                let _ = testing::check_eq(&items[1].as_text().unwrap_or(""), &"has,comma", "comma")
                let _ = testing::check(items[2].is_null(), "null preserved")
                let _ = testing::check_eq(&items[3].as_text().unwrap_or("x"), &"", "empty string")
            }
            Err(e) => { let _ = testing::check(false, &format!("round trip of {}: {}", text, e)) }
        }
    }

    #[test]
    fn composite_literals_parse_fields_and_nulls() {
        match super::parse_record_literal(&"(1,\"two, three\",)") {
            Ok(fields) => {
                let _ = testing::check_eq(&fields.len(), &3, "three fields")
                let _ = testing::check_eq(&fields[0].as_int().unwrap_or(0), &1, "first")
                let _ = testing::check_eq(
                    &fields[1].as_text().unwrap_or("")
                    &"two, three"
                    "quoted field"
                )
                let _ = testing::check(fields[2].is_null(), "empty field is NULL")
            }
            Err(e) => { let _ = testing::check(false, &format!("composite: {}", e)) }
        }
    }

    #[test]
    fn range_literals_parse_bounds_and_inclusivity() {
        match super::parse_range_literal(&"[1,5)", oid::INT4) {
            Ok(r) => {
                let _ = testing::check(r.lower_inclusive, "lower inclusive")
                let _ = testing::check(!r.upper_inclusive, "upper exclusive")
                let _ = testing::check_eq(&r.lower.as_int().unwrap_or(0), &1, "lower bound")
                let _ = testing::check_eq(&r.upper.as_int().unwrap_or(0), &5, "upper bound")
            }
            Err(e) => { let _ = testing::check(false, &format!("range: {}", e)) }
        }
        match super::parse_range_literal(&"empty", oid::INT4) {
            Ok(r) => { let _ = testing::check(r.is_empty, "empty range") }
            Err(e) => { let _ = testing::check(false, &format!("empty range: {}", e)) }
        }
        match super::parse_range_literal(&"(,10]", oid::INT4) {
            Ok(r) => {
                let _ = testing::check(r.lower.is_null(), "unbounded lower")
                let _ = testing::check_eq(&r.upper.as_int().unwrap_or(0), &10, "upper bound")
            }
            Err(e) => { let _ = testing::check(false, &format!("unbounded: {}", e)) }
        }
    }

    #[test]
    fn binary_scalars_decode() {
        let _ = testing::check_eq(
            &super::decode_binary(oid::INT4, &#[0, 0, 1, 0]).as_int().unwrap_or(0)
            &256
            "int4 binary"
        )
        let _ = testing::check_eq(
            &super::decode_binary(oid::INT2, &#[255, 254]).as_int().unwrap_or(0)
            &-2
            "int2 binary negative"
        )
        let _ = testing::check(
            super::decode_binary(oid::BOOL, &#[1]).as_bool().unwrap_or(false)
            "bool binary"
        )
    }

    #[test]
    fn binary_uuid_renders_hyphenated() {
        let raw: Vec<u8> = #[
            0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255,
        ]
        let _ = testing::check_eq(
            &super::decode_binary(oid::UUID, &raw).as_text().unwrap_or("")
            &"00112233-4455-6677-8899-aabbccddeeff"
            "uuid text"
        )
    }

    #[test]
    fn binary_int_parameters_encode_at_their_width() {
        match super::encode_binary(&super::Value::Int(258), oid::INT2) {
            Some(bytes) => {
                let _ = testing::check_eq(&bytes.len(), &2, "int2 width")
                let _ = testing::check_eq(&(bytes[0] as i64), &1, "high byte")
                let _ = testing::check_eq(&(bytes[1] as i64), &2, "low byte")
            }
            None => { let _ = testing::check(false, "int2 has a binary encoding") }
        }
        let _ = testing::check(
            super::encode_binary(&super::Value::Int(1), oid::NUMERIC).is_none()
            "numeric has no binary encoding here"
        )
    }
}
