// The value model crossing the wire, and its codecs.
//
// A `Value` is what a parameter is bound from and what a column decodes to.
// The set is deliberately small - the shapes a program computes with - and
// the column's type OID stays alongside it, so a caller that wants the
// server's exact spelling of a `numeric`, a timestamp, or a geometric type
// reads `Text` and parses it, while integers, floats, booleans, byte
// strings, arrays, and composites arrive already structured.
//
// Both wire formats are implemented in both directions. Text is the
// default: every PostgreSQL type has a text representation, including ones
// with no binary reading here, so a query never fails because the driver
// lacks a binary decoder. Binary is available per statement for the types
// that carry one.

use std::{errors, math}

use crate::{buf, oid, temporal}

// Wire format codes, as the Bind message spells them. Text is the default
// because every type has a text representation; binary is per statement.
pub const FORMAT_TEXT: i64 = 0
pub const FORMAT_BINARY: i64 = 1

// A bound parameter or a decoded column.
pub enum Value {
    // SQL NULL.
    Null
    // `bool`.
    Bool(bool)
    // Any integer type, and `oid`.
    Int(i64)
    // `float4` / `float8`.
    Float(f64)
    // `numeric`, and any type whose exact spelling matters: the digits the
    // server sent, unrounded.
    Numeric(String)
    // Character data, and every type read as its text form.
    Text(String)
    // `bytea`.
    Bytes(Vec<u8>)
    // `timestamp` and `timestamptz`, at the microsecond resolution the
    // server keeps.
    Timestamp(temporal::Timestamp)
    // `date`.
    Date(temporal::Date)
    // `time` and `timetz`.
    Time(temporal::Time)
    // `interval`, as its three independent components.
    Interval(temporal::Interval)
    // `uuid`, as its sixteen bytes.
    Uuid(temporal::Uuid)
    // `json` and `jsonb`, as the document text the server holds.
    Json(String)
}

impl Value {
    // True for SQL NULL.
    pub fn is_null(&self) -> bool {
        matches(self, Value::Null)
    }

    // The value as an `i64`, converting a float, a numeric, or a decimal
    // text form; `None` for NULL or a non-numeric reading.
    pub fn as_int(&self) -> Option<i64> {
        match self {
            Value::Int(v) => Some(v)
            Value::Bool(b) => Some(if b { 1 } else { 0 })
            Value::Float(f) => Some(f as i64)
            Value::Numeric(text) | Value::Text(text) | Value::Json(text) => text.to_i64()
            // A timestamp's integer reading is its microsecond count from
            // the Unix epoch, which is the number arithmetic on it uses.
            Value::Timestamp(ts) => Some(ts.to_unix_micros())
            Value::Date(date) => Some(date.to_unix_days())
            Value::Time(t) => Some(t.to_day_micros())
            Value::Interval(interval) => Some(interval.to_approximate_micros())
            _ => None
        }
    }

    // The value as an `f64`; `None` for NULL or a non-numeric reading.
    pub fn as_float(&self) -> Option<f64> {
        match self {
            Value::Float(f) => Some(f)
            Value::Int(v) => Some(v as f64)
            Value::Numeric(text) | Value::Text(text) | Value::Json(text) => text.to_f64()
            _ => None
        }
    }

    // The value as a `bool`, reading the server's `t` / `f` text form too.
    pub fn as_bool(&self) -> Option<bool> {
        match self {
            Value::Bool(b) => Some(b)
            Value::Int(v) => Some(v != 0)
            Value::Text(text) | Value::Json(text) => match text {
                "t" | "true" | "TRUE" | "y" | "yes" | "on" | "1" => Some(true)
                "f" | "false" | "FALSE" | "n" | "no" | "off" | "0" => Some(false)
                _ => None
            }
            _ => None
        }
    }

    // The value's text form. Every non-NULL value has one, so this is the
    // reading that always answers.
    pub fn as_text(&self) -> Option<String> {
        match self {
            Value::Null => None
            _ => Some(self.render())
        }
    }

    // The value's bytes: a `bytea` directly, any other value's text form
    // as UTF-8.
    pub fn as_bytes(&self) -> Option<Vec<u8>> {
        match self {
            Value::Null => None
            Value::Bytes(data) => Some(data)
            _ => Some(self.render().as_bytes())
        }
    }

    // The elements of an array literal, with each element read as text.
    //
    // A column's own element type is known to the row that holds it, so
    // `Row::array_at` decodes the elements under that type; this reads them
    // as the text the server wrote.
    pub fn as_array(&self) -> Option<Vec<Value>> {
        let Some(text) = self.as_text() else { return None }
        parse_array_literal(text, oid::TEXT).ok()
    }

    // The fields of a composite literal, each read as text.
    pub fn as_record(&self) -> Option<Vec<Value>> {
        let Some(text) = self.as_text() else { return None }
        parse_record_literal(text).ok()
    }

    // The value as a timestamp, parsing a text form when the column was
    // read as text; `None` for NULL or a value that carries no date.
    pub fn as_timestamp(&self) -> Option<temporal::Timestamp> {
        match self {
            Value::Timestamp(ts) => Some(ts)
            Value::Date(date) => Some(date.at_midnight())
            Value::Text(text) => temporal::parse_timestamp(text).ok()
            _ => None
        }
    }

    // The value as a date; `None` for NULL or a value that carries none.
    pub fn as_date(&self) -> Option<temporal::Date> {
        match self {
            Value::Date(date) => Some(date)
            Value::Timestamp(ts) => Some(ts.date())
            Value::Text(text) => temporal::parse_date(text).ok()
            _ => None
        }
    }

    // The value as a time of day; `None` for NULL or a value that carries
    // none.
    pub fn as_time(&self) -> Option<temporal::Time> {
        match self {
            Value::Time(t) => Some(t)
            Value::Timestamp(ts) => Some(ts.time())
            Value::Text(text) => temporal::parse_time(text).ok()
            _ => None
        }
    }

    // The value as an interval; `None` for NULL or a value that is not one.
    pub fn as_interval(&self) -> Option<temporal::Interval> {
        match self {
            Value::Interval(interval) => Some(interval)
            Value::Text(text) => temporal::parse_interval(text).ok()
            _ => None
        }
    }

    // The value as a UUID; `None` for NULL or a value that is not one.
    pub fn as_uuid(&self) -> Option<temporal::Uuid> {
        match self {
            Value::Uuid(id) => Some(id)
            Value::Text(text) => temporal::parse_uuid(text).ok()
            _ => None
        }
    }

    // The value's JSON document text; `None` for NULL. A column of any
    // other type answers its own text, which is what a caller building a
    // document from it wants.
    pub fn as_json_text(&self) -> Option<String> {
        match self {
            Value::Null => None
            _ => Some(self.render())
        }
    }

    // The value rendered the way PostgreSQL writes it in text format. This
    // is what a text-format parameter sends and what `as_text` answers.
    pub fn render(&self) -> String {
        match self {
            Value::Null => ""
            Value::Bool(b) => if b { "t" } else { "f" }
            Value::Int(v) => v.to_string()
            Value::Float(f) => render_float(f)
            Value::Numeric(text) | Value::Text(text) | Value::Json(text) => text
            Value::Bytes(data) => "\\x" + buf::to_hex(data)
            Value::Timestamp(ts) => ts.to_string()
            Value::Date(date) => date.to_string()
            Value::Time(t) => t.to_string()
            Value::Interval(interval) => interval.to_string()
            Value::Uuid(id) => id.to_string()
        }
    }
}

// A float in the form PostgreSQL accepts and emits: infinities and NaN by
// name, everything else in the shortest round-tripping decimal form.
pub fn render_float(f: f64) -> String {
    if math::is_nan(f) {
        return "NaN"
    }
    if math::is_inf(f, 1) {
        return "Infinity"
    }
    if math::is_inf(f, -1) {
        return "-Infinity"
    }
    f.to_string()
}

// The array literal for `items`, quoting each element the grammar needs
// quoted. This is what an array parameter binds as and what an array column
// reads back as, so building and reading share one spelling.
pub fn render_array_literal(items: Vec<Value>) -> String {
    let mut parts: Vec<String> = #[]
    for item in items {
        parts.push(match item {
            Value::Null => "NULL"
            _ => quote_composite_element(item.render())
        })
    }
    "{" + parts.join(",") + "}"
}

// The array literal for a list of already-rendered element literals, used to
// nest one array inside another: a nested literal is not quoted.
pub fn render_nested_array_literal(elements: Vec<String>) -> String {
    "{" + elements.join(",") + "}"
}

// A composite literal (`(1,two,)`).
pub fn render_record_literal(fields: Vec<Value>) -> String {
    let mut parts: Vec<String> = #[]
    for field in fields {
        parts.push(match field {
            Value::Null => ""
            _ => quote_composite_element(field.render())
        })
    }
    "(" + parts.join(",") + ")"
}

// Quotes an array or composite element when it holds a byte the literal
// grammar would otherwise read as structure, or when it is empty or spells
// NULL.
//
// Byte offsets throughout: every character the grammar reserves is ASCII, so
// a multi-byte character copies through untouched.
fn quote_composite_element(text: String) -> String {
    let needs = text.is_empty() || text.to_uppercase() == "NULL" ||
        text.bytes().any(|byte| is_reserved_byte(byte as i64))
    if !needs {
        return text
    }
    let mut out: Vec<u8> = #[34]
    for byte in text.bytes() {
        // A quote or a backslash inside a quoted element is escaped.
        if byte == 34 || byte == 92 {
            out.push(92)
        }
        out.push(byte)
    }
    out.push(34)
    buf::utf8_lossy(out)
}

// The bytes an array or composite literal reads as structure rather than as
// element text: the delimiters, the quote, the escape, and whitespace.
fn is_reserved_byte(byte: i64) -> bool {
    matches(byte, 44 | 123 | 125 | 40 | 41 | 34 | 92 | 32 | 9 | 10 | 13)
}

// --- text decoding -------------------------------------------------

// Decodes a column's text form under its type OID.
//
// A type with no more specific reading answers `Text` carrying exactly what
// the server sent, so nothing is ever lost: the caller can parse the
// server's spelling itself.
pub fn decode_text(type_oid: i64, raw: Vec<u8>) -> Value {
    let text = buf::utf8_lossy(raw)
    // An array or a composite keeps the literal the server wrote. It is the
    // exact value, and the element types belong to the column rather than to
    // the value, so parsing waits for a caller that knows them.
    if oid::is_array(type_oid) {
        return Value::Text(text)
    }
    match type_oid {
        oid::BOOL => Value::Bool(text == "t")
        oid::BYTEA => match decode_bytea_text(text) {
            Ok(data) => Value::Bytes(data)
            Err(_) => Value::Text(text)
        }
        oid::FLOAT4 | oid::FLOAT8 => match parse_float_text(text) {
            Some(f) => Value::Float(f)
            None => Value::Text(text)
        }
        oid::NUMERIC | oid::MONEY => Value::Numeric(text)
        oid::JSON | oid::JSONB => Value::Json(text)
        oid::UUID => match temporal::parse_uuid(text) {
            Ok(id) => Value::Uuid(id)
            Err(_) => Value::Text(text)
        }
        oid::DATE => match temporal::parse_date(text) {
            Ok(date) => Value::Date(date)
            Err(_) => Value::Text(text)
        }
        oid::TIME | oid::TIMETZ => match temporal::parse_time(text) {
            Ok(t) => Value::Time(t)
            Err(_) => Value::Text(text)
        }
        oid::TIMESTAMP | oid::TIMESTAMPTZ => match temporal::parse_timestamp(text) {
            Ok(ts) => Value::Timestamp(ts)
            Err(_) => Value::Text(text)
        }
        oid::INTERVAL => match temporal::parse_interval(text) {
            Ok(interval) => Value::Interval(interval)
            Err(_) => Value::Text(text)
        }
        _ => {
            if oid::is_integer(type_oid) {
                match text.to_i64() {
                    Some(v) => Value::Int(v)
                    None => Value::Text(text)
                }
            } else {
                Value::Text(text)
            }
        }
    }
}

// A float in PostgreSQL's text form, including the named infinities.
pub fn parse_float_text(text: String) -> Option<f64> {
    match text {
        "NaN" => Some(nan())
        "Infinity" | "inf" | "+Infinity" => Some(infinity())
        "-Infinity" | "-inf" => Some(-infinity())
        _ => text.to_f64()
    }
}

// IEEE-754 not-a-number.
pub fn nan() -> f64 {
    math::sqrt(-1.0)
}

// IEEE-754 positive infinity.
pub fn infinity() -> f64 {
    math::MAX_F64 * 2.0
}

// Decodes `bytea` text output: hex (`\x00ff`, the default since 9.0) or the
// historical escape format.
pub fn decode_bytea_text(text: String) -> Result<Vec<u8>, errors::Error> {
    if text.starts_with("\\x") {
        return buf::from_hex(text.substring(2, text.byte_len()))
    }
    let n = text.byte_len()
    let mut out: Vec<u8> = #[]
    let mut i = 0
    while i < n {
        let c = text.byte_at(i)
        if c != 92 {
            out.push(c as u8)
            i += 1
            continue
        }
        // A backslash escapes either itself or a three-digit octal byte.
        if i + 1 < n && text.byte_at(i + 1) == 92 {
            out.push(92)
            i += 2
            continue
        }
        if i + 3 < n {
            let a = text.byte_at(i + 1) - 48
            let b = text.byte_at(i + 2) - 48
            let c3 = text.byte_at(i + 3) - 48
            if a >= 0 && a <= 7 && b >= 0 && b <= 7 && c3 >= 0 && c3 <= 7 {
                out.push(((a << 6) | (b << 3) | c3) as u8)
                i += 4
                continue
            }
        }
        return Err(errors::newf("bytea escape format: bad escape at offset {}", i))
    }
    Ok(out)
}

// Parses an array literal into elements, decoding each under `elem_oid`.
//
// Handles any dimensionality, the explicit-bounds prefix
// (`[1:2]={a,b}`), quoted elements with backslash escapes, and the
// unquoted `NULL` element.
pub fn parse_array_literal(text: String, elem_oid: i64) -> Result<Vec<Value>, errors::Error> {
    let body = strip_dimension_prefix(text)
    let trimmed = body.trim()
    if trimmed == "" {
        return Ok(#[])
    }
    if !trimmed.starts_with("{") {
        return Err(errors::newf("array literal must start with `{{`: {}", trimmed))
    }
    let close = matching_brace(trimmed, 0)?
    let rest = trimmed.substring(close + 1, trimmed.byte_len()).trim()
    if rest != "" {
        return Err(errors::newf("trailing text after array literal: {}", rest))
    }
    parse_array_body(trimmed.substring(0, close + 1), elem_oid)
}

// Drops an explicit-bounds prefix like `[1:3]=` that the server emits when
// an array's lower bound is not 1.
fn strip_dimension_prefix(text: String) -> String {
    let t = text.trim()
    if !t.starts_with("[") {
        return t
    }
    match t.find("=") {
        Some(eq) => t.substring(eq + 1, t.byte_len())
        None => t
    }
}

// Parses the `{...}` at the start of `text` into its elements.
//
// One flat pass: a nested array is carried as its own literal, found by
// matching its braces, so an array of any dimensionality is read without
// recursion and every element is the text the server wrote.
fn parse_array_body(text: String, elem_oid: i64) -> Result<Vec<Value>, errors::Error> {
    let n = text.byte_len()
    let mut items: Vec<Value> = #[]
    let mut i = 1
    while i < n && is_space_byte(text.byte_at(i)) {
        i += 1
    }
    // `{}` closes immediately.
    if i < n && text.byte_at(i) == 125 {
        return Ok(items)
    }
    while i < n {
        while i < n && is_space_byte(text.byte_at(i)) {
            i += 1
        }
        if i >= n {
            break
        }
        let c = text.byte_at(i)
        if c == 123 {
            let close = matching_brace(text, i)?
            items.push(Value::Text(text.substring(i, close + 1)))
            i = close + 1
        } else if c == 34 {
            let raw, next = read_quoted(text, i)?
            items.push(decode_text(elem_oid, raw.as_bytes()))
            i = next
        } else {
            let raw, next = read_bare(text, i)
            if raw.to_uppercase() == "NULL" {
                items.push(Value::Null)
            } else {
                items.push(decode_text(elem_oid, raw.as_bytes()))
            }
            i = next
        }
        while i < n && is_space_byte(text.byte_at(i)) {
            i += 1
        }
        if i >= n {
            return Err(errors::new("unterminated array literal"))
        }
        let sep = text.byte_at(i)
        if sep == 125 {
            return Ok(items)
        }
        if sep != 44 {
            return Err(errors::newf("unexpected byte in array literal at offset {}", i))
        }
        i += 1
    }
    Err(errors::new("unterminated array literal"))
}

// Offset of the `}` closing the `{` at `open`, honoring nesting and quoted
// elements.
fn matching_brace(text: String, open: i64) -> Result<i64, errors::Error> {
    let n = text.byte_len()
    let mut depth = 0
    let mut i = open
    let mut quoted = false
    while i < n {
        let c = text.byte_at(i)
        if quoted {
            if c == 92 {
                i += 2
                continue
            }
            if c == 34 {
                quoted = false
            }
            i += 1
            continue
        }
        if c == 34 {
            quoted = true
        } else if c == 123 {
            depth += 1
        } else if c == 125 {
            depth -= 1
            if depth == 0 {
                return Ok(i)
            }
        }
        i += 1
    }
    Err(errors::new("unterminated array literal"))
}

// Parses a composite literal (`(1,"two",)`) into its fields. Every field
// decodes as text: a record's field types are not on the wire, so the
// caller converts with the accessors on `Value`.
pub fn parse_record_literal(text: String) -> Result<Vec<Value>, errors::Error> {
    let t = text.trim()
    if !t.starts_with("(") || !t.ends_with(")") {
        return Err(errors::newf("composite literal must be parenthesized: {}", t))
    }
    let n = t.byte_len()
    let mut fields: Vec<Value> = #[]
    let mut i = 1
    // `()` is the no-field composite.
    if n == 2 {
        return Ok(fields)
    }
    loop {
        if i >= n {
            return Err(errors::new("unterminated composite literal"))
        }
        let c = t.byte_at(i)
        if c == 34 {
            let raw, next = read_quoted(t, i)?
            fields.push(Value::Text(raw))
            i = next
        } else if c == 44 || c == 41 {
            // An empty field is NULL.
            fields.push(Value::Null)
        } else {
            let raw, next = read_bare_record(t, i)
            fields.push(Value::Text(raw))
            i = next
        }
        if i >= n {
            return Err(errors::new("unterminated composite literal"))
        }
        let sep = t.byte_at(i)
        if sep == 41 {
            return Ok(fields)
        }
        if sep != 44 {
            return Err(errors::newf("unexpected byte in composite literal at offset {}", i))
        }
        i += 1
    }
}

// A range literal's bounds and inclusivity, as the server writes them
// (`[1,5)`, `empty`).
pub struct Range {
    pub is_empty: bool
    pub lower_inclusive: bool
    pub upper_inclusive: bool
    // A NULL bound is unbounded on that side.
    pub lower: Value
    pub upper: Value
}

// Parses a range literal, decoding each bound under `elem_oid`.
pub fn parse_range_literal(text: String, elem_oid: i64) -> Result<Range, errors::Error> {
    let t = text.trim()
    if t.to_lowercase() == "empty" {
        return Ok(Range {
            is_empty: true
            lower_inclusive: false
            upper_inclusive: false
            lower: Value::Null
            upper: Value::Null
        })
    }
    let n = t.byte_len()
    if n < 3 {
        return Err(errors::newf("range literal too short: {}", t))
    }
    let open = t.byte_at(0)
    let close = t.byte_at(n - 1)
    if (open != 91 && open != 40) || (close != 93 && close != 41) {
        return Err(errors::newf("range literal must be bracketed: {}", t))
    }
    let inner = t.substring(1, n - 1)
    let lower_raw, upper_raw = split_range_bounds(inner)?
    Ok(Range {
        is_empty: false
        lower_inclusive: open == 91
        upper_inclusive: close == 93
        lower: decode_bound(lower_raw, elem_oid)
        upper: decode_bound(upper_raw, elem_oid)
    })
}

// Parses a multirange literal into its ranges, decoding each bound under
// `elem_oid`.
//
// A multirange is a brace-wrapped, comma-separated list of range literals
// (`{[1,3),[5,7)}`), and `{}` is the empty multirange. The ranges never
// overlap and are already in ascending order, which is what the server
// normalizes them to.
pub fn parse_multirange_literal(
    text: String
    elem_oid: i64
) -> Result<Vec<Range>, errors::Error> {
    let trimmed = text.trim()
    if !trimmed.starts_with("{") || !trimmed.ends_with("}") {
        return Err(errors::newf("multirange literal must be braced: {}", trimmed))
    }
    let inner = trimmed.substring(1, trimmed.byte_len() - 1).trim()
    if inner == "" {
        return Ok(#[])
    }
    let mut ranges: Vec<Range> = #[]
    let n = inner.byte_len()
    let mut i = 0
    while i < n {
        let c = inner.byte_at(i)
        if c == 44 || is_space_byte(c) {
            i += 1
            continue
        }
        if c != 91 && c != 40 {
            return Err(errors::newf("multirange element must be bracketed: {}", inner))
        }
        let end = closing_bracket(inner, i)?
        ranges.push(parse_range_literal(inner.substring(i, end + 1), elem_oid)?)
        i = end + 1
    }
    Ok(ranges)
}

// The index of the bracket closing the range that opens at `open`, skipping
// one inside a quoted bound.
fn closing_bracket(text: String, open: i64) -> Result<i64, errors::Error> {
    let n = text.byte_len()
    let mut i = open + 1
    let mut quoted = false
    while i < n {
        let c = text.byte_at(i)
        if quoted && c == 92 {
            i += 2
            continue
        }
        if c == 34 {
            quoted = !quoted
        } else if !quoted && (c == 93 || c == 41) {
            return Ok(i)
        }
        i += 1
    }
    Err(errors::newf("multirange element is unterminated: {}", text.substring(open, n)))
}

fn decode_bound(raw: String, elem_oid: i64) -> Value {
    if raw == "" {
        return Value::Null
    }
    if raw.starts_with("\"") {
        return match read_quoted(raw, 0) {
            Ok((text, _)) => decode_text(elem_oid, text.as_bytes())
            Err(_) => Value::Text(raw)
        }
    }
    decode_text(elem_oid, raw.as_bytes())
}

// Splits a range's inner text at the comma that separates the bounds,
// ignoring a comma inside a quoted bound.
fn split_range_bounds(inner: String) -> Result<(String, String), errors::Error> {
    let n = inner.byte_len()
    let mut i = 0
    let mut quoted = false
    while i < n {
        let c = inner.byte_at(i)
        if c == 92 && quoted {
            i += 2
            continue
        }
        if c == 34 {
            quoted = !quoted
        } else if c == 44 && !quoted {
            return Ok((inner.substring(0, i), inner.substring(i + 1, n)))
        }
        i += 1
    }
    Err(errors::newf("range literal has no bound separator: {}", inner))
}

fn is_space_byte(c: i64) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

// Reads a double-quoted element starting at `start`, returning its
// unescaped contents and the offset just past the closing quote.
fn read_quoted(text: String, start: i64) -> Result<(String, i64), errors::Error> {
    let n = text.byte_len()
    // Byte offsets, so a multi-byte character inside the element is copied
    // through unchanged rather than re-decoded per byte.
    let mut out_bytes: Vec<u8> = #[]
    let mut i = start + 1
    while i < n {
        let c = text.byte_at(i)
        if c == 92 {
            if i + 1 >= n {
                return Err(errors::new("literal ends in a backslash"))
            }
            out_bytes.push(text.byte_at(i + 1) as u8)
            i += 2
            continue
        }
        if c == 34 {
            return Ok((buf::utf8_lossy(out_bytes), i + 1))
        }
        out_bytes.push(c as u8)
        i += 1
    }
    Err(errors::new("unterminated quoted element"))
}

// Reads an unquoted array element: everything up to a comma or a brace.
fn read_bare(text: String, start: i64) -> (String, i64) {
    let n = text.byte_len()
    let mut end = start
    while end < n {
        let c = text.byte_at(end)
        if c == 44 || c == 125 || c == 123 {
            break
        }
        end += 1
    }
    // Trailing whitespace before the separator is not part of the value.
    let mut stop = end
    while stop > start && is_space_byte(text.byte_at(stop - 1)) {
        stop -= 1
    }
    (text.substring(start, stop), end)
}

// Reads an unquoted composite field: everything up to a comma or the
// closing parenthesis. Unlike an array element, whitespace is significant.
fn read_bare_record(text: String, start: i64) -> (String, i64) {
    let n = text.byte_len()
    let mut end = start
    while end < n {
        let c = text.byte_at(end)
        if c == 44 || c == 41 {
            break
        }
        end += 1
    }
    (text.substring(start, end), end)
}

// --- binary coding -------------------------------------------------

// Decodes a column's binary form under its type OID.
//
// Only the types with a binary reading here are decoded; anything else
// answers its bytes as `Bytes`, since a binary payload has no text form to
// fall back on. Ask for text format for those (the default).
pub fn decode_binary(type_oid: i64, raw: Vec<u8>) -> Value {
    if oid::is_array(type_oid) {
        return match decode_binary_array(raw) {
            Ok(literal) => Value::Text(literal)
            Err(_) => Value::Bytes(raw)
        }
    }
    // A range and a multirange decode to the literal the text format
    // writes, so a caller reads either wire format through one parser and
    // the bounds keep the column's own element type.
    if oid::is_range(type_oid) {
        return match decode_binary_range(raw, oid::range_element_of(type_oid)) {
            Ok(literal) => Value::Text(literal)
            Err(_) => Value::Bytes(raw)
        }
    }
    if oid::is_multirange(type_oid) {
        return match decode_binary_multirange(raw, oid::range_element_of(type_oid)) {
            Ok(literal) => Value::Text(literal)
            Err(_) => Value::Bytes(raw)
        }
    }
    match type_oid {
        oid::BOOL => Value::Bool(buf::u8_at(raw, 0) != 0)
        oid::INT2 => Value::Int(buf::i16_at(raw, 0))
        oid::INT4 | oid::OID | oid::XID | oid::CID | oid::REGPROC => Value::Int(buf::i32_at(raw, 0))
        oid::INT8 => Value::Int(buf::i64_at(raw, 0))
        oid::FLOAT4 => Value::Float(f32_from_bits(buf::u32_at(raw, 0)))
        oid::FLOAT8 => Value::Float(f64_from_bits(buf::i64_at(raw, 0)))
        // `"char"` is one byte, and what the server writes for it in text
        // format is the character itself, so it reads as its text alike.
        oid::TEXT | oid::VARCHAR | oid::BPCHAR | oid::NAME | oid::XML
        | oid::CSTRING | oid::CHAR => Value::Text(buf::utf8_lossy(raw))
        oid::JSON => Value::Json(buf::utf8_lossy(raw))
        oid::JSONB => {
            // A jsonb binary payload is a one-byte version prefix then the
            // document as text.
            if buf::u8_at(raw, 0) == 1 {
                Value::Json(buf::utf8_lossy(buf::slice(raw, 1, raw.len())))
            } else {
                Value::Json(buf::utf8_lossy(raw))
            }
        }
        oid::UUID => match temporal::Uuid::from_bytes(raw) {
            Ok(id) => Value::Uuid(id)
            Err(_) => Value::Bytes(raw)
        }
        oid::DATE => match temporal::date_from_binary(raw) {
            Ok(date) => Value::Date(date)
            Err(_) => Value::Bytes(raw)
        }
        oid::TIME | oid::TIMETZ => match temporal::time_from_binary(raw) {
            Ok(t) => Value::Time(t)
            Err(_) => Value::Bytes(raw)
        }
        oid::TIMESTAMP | oid::TIMESTAMPTZ => {
            match temporal::timestamp_from_binary(raw, type_oid == oid::TIMESTAMPTZ) {
                Ok(ts) => Value::Timestamp(ts)
                Err(_) => Value::Bytes(raw)
            }
        }
        oid::INTERVAL => match temporal::interval_from_binary(raw) {
            Ok(interval) => Value::Interval(interval)
            Err(_) => Value::Bytes(raw)
        }
        oid::NUMERIC => match decode_binary_numeric(raw) {
            Ok(text) => Value::Numeric(text)
            Err(_) => Value::Bytes(raw)
        }
        // `bytea` is already its bytes, and a type with no binary reading
        // here has no text form to fall back on, so it answers them too.
        _ => Value::Bytes(raw)
    }
}

// Encodes a value in the binary format for `type_oid`, or `None` when the
// pair has no binary encoding here - the caller then sends it as text.
pub fn encode_binary(v: Value, type_oid: i64) -> Option<Vec<u8>> {
    match v {
        Value::Bool(b) => encode_binary_bool(b, type_oid)
        Value::Int(n) => encode_binary_int(n, type_oid)
        Value::Text(text) => encode_binary_text(text, type_oid)
        Value::Bytes(data) => encode_binary_bytes(data, type_oid)
        Value::Json(text) => encode_binary_json(text, type_oid)
        Value::Uuid(id) => if type_oid == oid::UUID { Some(id.bytes) } else { None }
        Value::Timestamp(ts) => match type_oid {
            oid::TIMESTAMP | oid::TIMESTAMPTZ => Some(temporal::timestamp_to_binary(ts))
            _ => None
        }
        Value::Date(date) => match type_oid {
            oid::DATE => Some(temporal::date_to_binary(date))
            _ => None
        }
        Value::Time(t) => match type_oid {
            // The binary `timetz` carries an offset the value must have,
            // and the binary `time` must not carry one.
            oid::TIME => if t.offset_minutes.is_none() {
                Some(temporal::time_to_binary(t))
            } else {
                None
            }
            oid::TIMETZ => if t.offset_minutes.is_some() {
                Some(temporal::time_to_binary(t))
            } else {
                None
            }
            _ => None
        }
        Value::Interval(interval) => match type_oid {
            oid::INTERVAL => Some(temporal::interval_to_binary(interval))
            _ => None
        }
        // A float goes as text: its shortest round-tripping decimal form
        // names exactly one binary64, so nothing is lost. An array, a
        // composite, and a numeric go as their literal for the same reason.
        _ => None
    }
}

fn encode_binary_bool(b: bool, type_oid: i64) -> Option<Vec<u8>> {
    if type_oid != oid::BOOL {
        return None
    }
    let mut out: Vec<u8> = #[]
    buf::put_u8(&mut out, if b { 1 } else { 0 })
    Some(out)
}

fn encode_binary_int(n: i64, type_oid: i64) -> Option<Vec<u8>> {
    let mut out: Vec<u8> = #[]
    match type_oid {
        oid::INT2 => buf::put_i16(&mut out, n)
        oid::INT4 | oid::OID => buf::put_i32(&mut out, n)
        oid::INT8 => buf::put_i64(&mut out, n)
        _ => return None
    }
    Some(out)
}

fn encode_binary_text(text: String, type_oid: i64) -> Option<Vec<u8>> {
    match type_oid {
        oid::TEXT | oid::VARCHAR | oid::BPCHAR | oid::NAME | oid::JSON | oid::XML
        | oid::CSTRING => Some(text.as_bytes())
        _ => None
    }
}

// A JSON document in binary: `json` is its bytes, and `jsonb` prefixes them
// with the one-byte format version the server expects.
fn encode_binary_json(text: String, type_oid: i64) -> Option<Vec<u8>> {
    match type_oid {
        oid::JSON => Some(text.as_bytes())
        oid::JSONB => {
            let mut out: Vec<u8> = #[1]
            out.extend(text.as_bytes())
            Some(out)
        }
        _ => None
    }
}

fn encode_binary_bytes(data: Vec<u8>, type_oid: i64) -> Option<Vec<u8>> {
    if type_oid != oid::BYTEA {
        return None
    }
    Some(data)
}

// Range flag bits, as `rangetypes.h` defines them.
const RANGE_EMPTY: i64 = 1
const RANGE_LB_INC: i64 = 2
const RANGE_UB_INC: i64 = 4
const RANGE_LB_INF: i64 = 8
const RANGE_UB_INF: i64 = 16
const RANGE_LB_NULL: i64 = 32
const RANGE_UB_NULL: i64 = 64

// Decodes the binary range representation into the literal the text format
// writes: a flags byte, then each bound the flags say is present as a
// length and its own binary value.
fn decode_binary_range(raw: Vec<u8>, elem_oid: i64) -> Result<String, errors::Error> {
    let literal, _ = read_binary_range(raw, 0, raw.len(), elem_oid)?
    Ok(literal)
}

// Decodes the binary multirange representation: a count, then each range as
// a length and its own binary payload.
fn decode_binary_multirange(raw: Vec<u8>, elem_oid: i64) -> Result<String, errors::Error> {
    if raw.len() < 4 {
        return Err(errors::new("multirange binary payload too short"))
    }
    let count = buf::i32_at(raw, 0)
    if count < 0 {
        return Err(errors::new("multirange binary payload has a negative range count"))
    }
    let mut parts: Vec<String> = #[]
    let mut offset = 4
    for _range in 0..count {
        if offset + 4 > raw.len() {
            return Err(errors::new("multirange binary payload ends inside a range"))
        }
        let length = buf::i32_at(raw, offset)
        offset += 4
        if length < 0 || offset + length > raw.len() {
            return Err(errors::new("multirange binary payload has a bad range length"))
        }
        let literal, _ = read_binary_range(raw, offset, offset + length, elem_oid)?
        parts.push(literal)
        offset += length
    }
    Ok("{" + parts.join(",") + "}")
}

// One binary range between `start` and `end`, as its literal and the offset
// just past it.
fn read_binary_range(
    raw: Vec<u8>
    start: i64
    end: i64
    elem_oid: i64
) -> Result<(String, i64), errors::Error> {
    if start >= end {
        return Err(errors::new("range binary payload is empty"))
    }
    let flags = buf::u8_at(raw, start)
    if flags & RANGE_EMPTY != 0 {
        return Ok(("empty", start + 1))
    }
    let mut offset = start + 1
    let has_lower = flags & (RANGE_LB_INF | RANGE_LB_NULL) == 0
    let has_upper = flags & (RANGE_UB_INF | RANGE_UB_NULL) == 0
    let mut lower = ""
    let mut upper = ""
    if has_lower {
        let bound, next = read_binary_bound(raw, offset, end, elem_oid)?
        lower = bound
        offset = next
    }
    if has_upper {
        let bound, next = read_binary_bound(raw, offset, end, elem_oid)?
        upper = bound
        offset = next
    }
    let open = if flags & RANGE_LB_INC != 0 { "[" } else { "(" }
    let close = if flags & RANGE_UB_INC != 0 { "]" } else { ")" }
    Ok((open + lower + "," + upper + close, offset))
}

fn read_binary_bound(
    raw: Vec<u8>
    offset: i64
    end: i64
    elem_oid: i64
) -> Result<(String, i64), errors::Error> {
    if offset + 4 > end {
        return Err(errors::new("range binary payload ends inside a bound"))
    }
    let length = buf::i32_at(raw, offset)
    if length < 0 || offset + 4 + length > end {
        return Err(errors::new("range binary payload has a bad bound length"))
    }
    let bound = decode_binary(elem_oid, buf::slice(raw, offset + 4, offset + 4 + length))
    Ok((quote_range_bound(bound.render()), offset + 4 + length))
}

// Quotes a range bound when it holds a byte the range grammar would
// otherwise read as structure, or when it is empty.
//
// Byte offsets: every character the grammar reserves is ASCII, so a
// multi-byte character copies through untouched.
fn quote_range_bound(text: String) -> String {
    let needs = text.is_empty()
    || text.bytes().any(|byte| is_reserved_byte(byte as i64) || byte == 91 || byte == 93)
    if !needs {
        return text
    }
    let mut out: Vec<u8> = #[34]
    for byte in text.bytes() {
        if byte == 34 || byte == 92 {
            out.push(92)
        }
        out.push(byte)
    }
    out.push(34)
    buf::utf8_lossy(out)
}

// Decodes the binary `numeric` representation into its exact decimal text.
//
// The wire form is a count of base-10000 digit groups, the weight of the
// first group, a sign, a display scale, then the groups.
fn decode_binary_numeric(raw: Vec<u8>) -> Result<String, errors::Error> {
    if raw.len() < 8 {
        return Err(errors::new("numeric binary payload too short"))
    }
    let ndigits = buf::u16_at(raw, 0)
    let weight = buf::i16_at(raw, 2)
    let sign = buf::u16_at(raw, 4)
    let dscale = buf::u16_at(raw, 6)
    if sign == 49_152 {
        return Ok("NaN")
    }
    if sign == 53_248 {
        return Ok("Infinity")
    }
    if sign == 61_440 {
        return Ok("-Infinity")
    }
    if raw.len() < 8 + ndigits * 2 {
        return Err(errors::new("numeric binary payload truncated"))
    }
    let mut groups: Vec<i64> = #[]
    for i in 0..ndigits {
        groups.push(buf::u16_at(raw, 8 + i * 2))
    }

    // Integer part: groups from `weight` down to 0, each four digits wide
    // after the first.
    let mut int_part = ""
    for g in 0..=weight {
        let group = if g < groups.len() { groups[g] } else { 0 }
        if int_part == "" {
            int_part = group.to_string()
        } else {
            int_part += format("{:04}", group)
        }
    }
    if int_part == "" {
        int_part = "0"
    }

    // Fractional digits: the groups past the integer part, cut to the
    // declared display scale.
    //
    // A weight below -1 puts the first stored group that many whole groups
    // past the point, and the groups in between are not on the wire: the
    // encoding stores significant digits and says where they sit, so the
    // zeros leading up to them are written back here.
    let mut frac = ""
    for _leading in 0..max(-weight - 1, 0) {
        frac += "0000"
    }
    for fg in max(weight + 1, 0)..groups.len() {
        frac += format("{:04}", groups[fg])
    }
    while frac.byte_len() < dscale {
        frac += "0"
    }
    let frac_shown = frac.substring(0, dscale)

    let mut text = if sign == 16_384 { "-" + int_part } else { int_part }
    if dscale > 0 {
        text += "." + frac_shown
    }
    Ok(text)
}

// Decodes the binary array form into its text literal: dimensions, a null
// bitmap flag, the element OID, then each element length-prefixed. The
// literal is the value an array column carries, so a binary-format array
// reads back the same way a text-format one does.
fn decode_binary_array(raw: Vec<u8>) -> Result<String, errors::Error> {
    if raw.len() < 12 {
        return Err(errors::new("array binary payload too short"))
    }
    let ndim = buf::i32_at(raw, 0)
    let elem_oid = buf::u32_at(raw, 8)
    if ndim == 0 {
        return Ok("{}")
    }
    if ndim < 0 {
        return Err(errors::new("array binary payload has a negative dimension count"))
    }
    let mut dims: Vec<i64> = #[]
    for i in 0..ndim {
        dims.push(buf::i32_at(raw, 12 + i * 8))
    }
    let mut total = 1
    for d in dims {
        total *= d
    }
    let mut off = 12 + ndim * 8
    let mut flat: Vec<Value> = #[]
    for _element in 0..total {
        let length = buf::i32_at(raw, off)
        off += 4
        if length < 0 {
            flat.push(Value::Null)
        } else {
            flat.push(decode_binary(elem_oid, buf::slice(raw, off, off + length)))
            off += length
        }
    }
    Ok(nest_literal(flat, dims, 0))
}

// Reshapes a flat element list into a `dims`-shaped nested array literal.
fn nest_literal(flat: Vec<Value>, dims: Vec<i64>, depth: i64) -> String {
    if depth >= dims.len() - 1 {
        return render_array_literal(flat)
    }
    let mut inner_len = 1
    for d in dims.iter().skip(depth + 1) {
        inner_len *= d
    }
    let mut rows: Vec<String> = #[]
    for chunk in flat.chunks(inner_len) {
        rows.push(nest_literal(chunk, dims, depth + 1))
    }
    render_nested_array_literal(rows)
}

fn f64_from_bits(bits: i64) -> f64 {
    let sign = if (bits >> 63) & 1 == 1 { -1.0 } else { 1.0 }
    let exponent = (bits >> 52) & 2_047
    let mantissa = bits & 4_503_599_627_370_495
    if exponent == 2_047 {
        if mantissa == 0 {
            return sign * infinity()
        }
        return nan()
    }
    if exponent == 0 {
        return sign * (mantissa as f64) * pow2(-1_074)
    }
    sign * (1.0 + (mantissa as f64) * pow2(-52)) * pow2(exponent - 1_023)
}

fn f32_from_bits(bits: i64) -> f64 {
    let sign = if (bits >> 31) & 1 == 1 { -1.0 } else { 1.0 }
    let exponent = (bits >> 23) & 255
    let mantissa = bits & 8_388_607
    if exponent == 255 {
        if mantissa == 0 {
            return sign * infinity()
        }
        return nan()
    }
    if exponent == 0 {
        // Subnormal: no implicit leading one.
        return sign * (mantissa as f64) * pow2(-149)
    }
    sign * (1.0 + (mantissa as f64) * pow2(-23)) * pow2(exponent - 127)
}

// Two raised to `e`, by squaring. Exact for every exponent a binary32 or
// binary64 decode reaches, and no `math` dependency for one power.
fn pow2(e: i64) -> f64 {
    let mut acc = 1.0
    let mut base = 2.0
    let mut n = if e < 0 { -e } else { e }
    while n > 0 {
        if n % 2 == 1 {
            acc *= base
        }
        base *= base
        n /= 2
    }
    if e < 0 { 1.0 / acc } else { acc }
}

#[cfg(test)]
mod value_tests {
    use std::testing

    #[test]
    fn render_writes_postgres_text_forms() {
        let _ = testing::check_eq(super::Value::Bool(true).render(), "t", "true")
        let _ = testing::check_eq(super::Value::Bool(false).render(), "f", "false")
        let _ = testing::check_eq(super::Value::Int(-7).render(), "-7", "int")
        let _ = testing::check_eq(
            super::Value::Bytes(#[0, 255]).render()
            "\\x00ff"
            "bytea hex"
        )
    }

    #[test]
    fn decode_text_reads_scalars_by_oid() {
        let v = super::decode_text(oid::INT4, "42".as_bytes())
        let _ = testing::check_eq(v.as_int().unwrap_or(0), 42, "int4")
        let b = super::decode_text(oid::BOOL, "t".as_bytes())
        let _ = testing::check(b.as_bool().unwrap_or(false), "bool true")
        let f = super::decode_text(oid::FLOAT8, "1.5".as_bytes())
        let _ = testing::check_eq(f.as_float().unwrap_or(0.0), 1.5, "float8")
    }

    #[test]
    fn numeric_keeps_every_digit_the_server_sent() {
        let v = super::decode_text(oid::NUMERIC, "123456789012345678.90".as_bytes())
        let _ = testing::check_eq(
            v.as_text().unwrap_or("")
            "123456789012345678.90"
            "exact numeric"
        )
    }

    #[test]
    fn bytea_hex_and_escape_forms_both_decode() {
        match super::decode_bytea_text("\\x00ff10") {
            Ok(data) => {
                let _ = testing::check_eq(data.len(), 3, "hex length")
                let _ = testing::check_eq((data[1] as i64), 255, "hex byte")
            }
            Err(e) => { let _ = testing::check(false, format("hex: {}", e)) }
        }
        match super::decode_bytea_text("ab\\000cd\\\\") {
            Ok(data) => {
                let _ = testing::check_eq(data.len(), 6, "escape length")
                let _ = testing::check_eq((data[2] as i64), 0, "octal escape")
                let _ = testing::check_eq((data[5] as i64), 92, "escaped backslash")
            }
            Err(e) => { let _ = testing::check(false, format("escape: {}", e)) }
        }
    }

    #[test]
    fn array_literals_parse_with_nulls_quotes_and_nesting() {
        match super::parse_array_literal("{1,2,NULL}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(items.len(), 3, "three elements")
                let _ = testing::check_eq(items[0].as_int().unwrap_or(0), 1, "first")
                let _ = testing::check(items[2].is_null(), "third is NULL")
            }
            Err(e) => { let _ = testing::check(false, format("flat: {}", e)) }
        }
        match super::parse_array_literal("{{1,2},{3,4}}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(items.len(), 2, "two rows")
                let row = items[0].as_array().unwrap_or(#[])
                let _ = testing::check_eq(row.len(), 2, "two columns")
                let _ = testing::check_eq(row[1].as_int().unwrap_or(0), 2, "nested value")
            }
            Err(e) => { let _ = testing::check(false, format("nested: {}", e)) }
        }
        match super::parse_array_literal("{\"a,b\",\"c\\\"d\",NULL}", oid::TEXT) {
            Ok(items) => {
                let _ = testing::check_eq(items[0].as_text().unwrap_or(""), "a,b", "quoted comma")
                let _ = testing::check_eq(items[1].as_text().unwrap_or(""), "c\"d", "escaped quote")
            }
            Err(e) => { let _ = testing::check(false, format("quoted: {}", e)) }
        }
    }

    #[test]
    fn an_empty_array_literal_has_no_elements() {
        match super::parse_array_literal("{}", oid::INT4) {
            Ok(items) => { let _ = testing::check_eq(items.len(), 0, "empty") }
            Err(e) => { let _ = testing::check(false, format("empty: {}", e)) }
        }
    }

    #[test]
    fn an_explicit_bounds_prefix_is_dropped() {
        match super::parse_array_literal("[2:3]={7,8}", oid::INT4) {
            Ok(items) => {
                let _ = testing::check_eq(items.len(), 2, "two elements")
                let _ = testing::check_eq(items[0].as_int().unwrap_or(0), 7, "first")
            }
            Err(e) => { let _ = testing::check(false, format("bounds: {}", e)) }
        }
    }

    #[test]
    fn arrays_round_trip_through_render_and_parse() {
        let text = super::render_array_literal(#[
            super::Value::Text("plain")
            super::Value::Text("has,comma")
            super::Value::Null
            super::Value::Text("")
        ])
        match super::parse_array_literal(text, oid::TEXT) {
            Ok(items) => {
                let _ = testing::check_eq(items.len(), 4, "element count")
                let _ = testing::check_eq(items[1].as_text().unwrap_or(""), "has,comma", "comma")
                let _ = testing::check(items[2].is_null(), "null preserved")
                let _ = testing::check_eq(items[3].as_text().unwrap_or("x"), "", "empty string")
            }
            Err(e) => { let _ = testing::check(false, format("round trip of {}: {}", text, e)) }
        }
    }

    #[test]
    fn composite_literals_parse_fields_and_nulls() {
        match super::parse_record_literal("(1,\"two, three\",)") {
            Ok(fields) => {
                let _ = testing::check_eq(fields.len(), 3, "three fields")
                let _ = testing::check_eq(fields[0].as_int().unwrap_or(0), 1, "first")
                let _ = testing::check_eq(
                    fields[1].as_text().unwrap_or("")
                    "two, three"
                    "quoted field"
                )
                let _ = testing::check(fields[2].is_null(), "empty field is NULL")
            }
            Err(e) => { let _ = testing::check(false, format("composite: {}", e)) }
        }
    }

    #[test]
    fn range_literals_parse_bounds_and_inclusivity() {
        match super::parse_range_literal("[1,5)", oid::INT4) {
            Ok(r) => {
                let _ = testing::check(r.lower_inclusive, "lower inclusive")
                let _ = testing::check(!r.upper_inclusive, "upper exclusive")
                let _ = testing::check_eq(r.lower.as_int().unwrap_or(0), 1, "lower bound")
                let _ = testing::check_eq(r.upper.as_int().unwrap_or(0), 5, "upper bound")
            }
            Err(e) => { let _ = testing::check(false, format("range: {}", e)) }
        }
        match super::parse_range_literal("empty", oid::INT4) {
            Ok(r) => { let _ = testing::check(r.is_empty, "empty range") }
            Err(e) => { let _ = testing::check(false, format("empty range: {}", e)) }
        }
        match super::parse_range_literal("(,10]", oid::INT4) {
            Ok(r) => {
                let _ = testing::check(r.lower.is_null(), "unbounded lower")
                let _ = testing::check_eq(r.upper.as_int().unwrap_or(0), 10, "upper bound")
            }
            Err(e) => { let _ = testing::check(false, format("unbounded: {}", e)) }
        }
    }

    #[test]
    fn binary_scalars_decode() {
        let _ = testing::check_eq(
            super::decode_binary(oid::INT4, #[0, 0, 1, 0]).as_int().unwrap_or(0)
            256
            "int4 binary"
        )
        let _ = testing::check_eq(
            super::decode_binary(oid::INT2, #[255, 254]).as_int().unwrap_or(0)
            -2
            "int2 binary negative"
        )
        let _ = testing::check(
            super::decode_binary(oid::BOOL, #[1]).as_bool().unwrap_or(false)
            "bool binary"
        )
    }

    // A binary numeric, built as the server writes it: ndigits, weight,
    // sign, dscale, then base-10000 digit groups.
    fn numeric_wire(weight: i64, negative: bool, dscale: i64, groups: Vec<i64>) -> Vec<u8> {
        let mut raw: Vec<u8> = #[]
        super::buf::put_i16(&mut raw, groups.len())
        super::buf::put_i16(&mut raw, weight)
        super::buf::put_i16(&mut raw, if negative { 16_384 } else { 0 })
        super::buf::put_i16(&mut raw, dscale)
        for group in groups {
            super::buf::put_i16(&mut raw, group)
        }
        raw
    }

    #[test]
    fn a_binary_numeric_writes_the_zeros_its_weight_stands_for() {
        // The encoding stores significant digits and says where they sit, so
        // a value smaller than one whole base-10000 group has leading zeros
        // that are not on the wire.
        let cases: Vec<(i64, bool, i64, Vec<i64>, String)> = #[
            (0, false, 0, #[1], "1")
            (0, true, 0, #[1], "-1")
            (-1, false, 1, #[1_000], "0.1")
            (-1, true, 1, #[1_000], "-0.1")
            (-2, false, 8, #[1], "0.00000001")
            (-2, true, 8, #[1], "-0.00000001")
            (-3, false, 12, #[1], "0.000000000001")
            (-5, false, 20, #[1], "0.00000000000000000001")
            (1, false, 4, #[1, 2_345, 6_789], "12345.6789")
            (0, false, 4, #[0, 5_000], "0.5000")
            (-1, false, 4, #[1], "0.0001")
            (-1, false, 8, #[1], "0.00010000")
        ]
        for (weight, negative, dscale, groups, expected) in cases {
            let raw = numeric_wire(weight, negative, dscale, groups)
            let _ = testing::check_eq(
                super::decode_binary(oid::NUMERIC, raw).render()
                expected
                format("weight {} dscale {}", weight, dscale)
            )
        }
    }

    #[test]
    fn a_binary_char_reads_as_the_character_its_text_form_writes() {
        let _ = testing::check_eq(
            super::decode_binary(oid::CHAR, #[120]).render()
            "x"
            "the byte is the character"
        )
        let _ = testing::check_eq(
            super::decode_text(oid::CHAR, "x".as_bytes()).render()
            super::decode_binary(oid::CHAR, #[120]).render()
            "both wire formats agree"
        )
    }

    #[test]
    fn a_typed_accessor_answers_only_for_what_it_can_read() {
        // Reading a column as a type it cannot carry is a `None` a caller
        // branches on rather than a wrong value. Text is the exception by
        // design: it is what the server wrote, so a typed reading of it is a
        // parse that either succeeds or does not.
        let word = super::Value::Text("hello")
        let _ = testing::check_eq(word.as_text().unwrap_or(""), "hello", "text reads as text")
        let _ = testing::check(word.as_int().is_none(), "a word is no integer")
        let _ = testing::check(word.as_float().is_none(), "nor a float")
        let _ = testing::check(word.as_bool().is_none(), "nor a bool")
        let _ = testing::check(word.as_uuid().is_none(), "nor a uuid")
        let _ = testing::check(word.as_timestamp().is_none(), "nor a timestamp")
        let _ = testing::check(word.as_date().is_none(), "nor a date")
        let _ = testing::check(word.as_time().is_none(), "nor a time")
        let _ = testing::check(word.as_interval().is_none(), "nor an interval")

        let number = super::Value::Int(7)
        let _ = testing::check_eq(number.as_int().unwrap_or(0), 7, "an integer reads")
        let _ = testing::check_eq(number.as_text().unwrap_or(""), "7", "and has a text form")
        let _ = testing::check(number.as_bool().unwrap_or(false), "a non-zero integer is true")
        let _ = testing::check(!super::Value::Int(0).as_bool().unwrap_or(true), "and zero is false")
        let _ = testing::check(number.as_uuid().is_none(), "but names no uuid")
    }

    #[test]
    fn null_answers_no_accessor_at_all() {
        let null = super::Value::Null
        let _ = testing::check(null.is_null(), "NULL knows itself")
        let _ = testing::check(null.as_text().is_none(), "no text")
        let _ = testing::check(null.as_int().is_none(), "no integer")
        let _ = testing::check(null.as_float().is_none(), "no float")
        let _ = testing::check(null.as_bool().is_none(), "no bool")
        let _ = testing::check(null.as_bytes().is_none(), "no bytes")
        let _ = testing::check(null.as_array().is_none(), "no array")
        let _ = testing::check(null.as_record().is_none(), "no record")
        let _ = testing::check(null.as_json_text().is_none(), "no document")
        let _ = testing::check(null.as_uuid().is_none(), "no uuid")
        let _ = testing::check(null.as_timestamp().is_none(), "no timestamp")
        let _ = testing::check_eq(null.render(), "", "and renders as nothing")
    }

    #[test]
    fn the_bool_spellings_postgres_accepts_all_read() {
        for spelling in #["t", "true", "TRUE", "y", "yes", "on", "1"] {
            let _ = testing::check(
                super::Value::Text(spelling).as_bool().unwrap_or(false)
                format("{} is true", spelling)
            )
        }
        for spelling in #["f", "false", "FALSE", "n", "no", "off", "0"] {
            let _ = testing::check(
                !super::Value::Text(spelling).as_bool().unwrap_or(true)
                format("{} is false", spelling)
            )
        }
        let _ = testing::check(super::Value::Text("maybe").as_bool().is_none(), "and nothing else does")
    }

    #[test]
    fn the_typed_temporal_arms_read_back_through_their_own_accessors() {
        match super::temporal::parse_timestamp("2026-08-23 12:34:56.789012+00") {
            Ok(at) => {
                let v = super::Value::Timestamp(at)
                let _ = testing::check(v.as_timestamp().is_some(), "a timestamp arm reads")
                let _ = testing::check(
                    v.render().starts_with("2026-08-23 12:34:56.789012")
                    format("rendering keeps the microseconds: {}", v.render())
                )
                // A timestamp carries a date and a time, so both project.
                let _ = testing::check(v.as_date().is_some(), "and projects to its date")
                let _ = testing::check(v.as_time().is_some(), "and to its time of day")
                let _ = testing::check(v.as_interval().is_none(), "but names no span")
            }
            Err(e) => { let _ = testing::check(false, format("timestamp: {}", e)) }
        }
        match super::temporal::parse_interval("1 mon 2 days 03:04:05") {
            Ok(span) => {
                let v = super::Value::Interval(span)
                let _ = testing::check(v.as_interval().is_some(), "an interval arm reads")
                let _ = testing::check(v.as_timestamp().is_none(), "and names no instant")
                let _ = testing::check(v.as_date().is_none(), "nor a date")
            }
            Err(e) => { let _ = testing::check(false, format("interval: {}", e)) }
        }
    }

    #[test]
    fn a_json_document_keeps_its_own_arm_and_its_text() {
        let doc = super::Value::Json("{\"a\":1}")
        let _ = testing::check_eq(doc.as_json_text().unwrap_or(""), "{\"a\":1}", "the document")
        let _ = testing::check_eq(doc.render(), "{\"a\":1}", "rendered as written")
        // A column of any other type answers its own text here, which is what
        // a caller assembling a document out of one wants.
        let _ = testing::check_eq(
            super::Value::Int(7).as_json_text().unwrap_or("")
            "7"
            "a scalar answers its own text"
        )
    }

    #[test]
    fn an_array_and_a_record_read_out_of_the_literal_they_are_carried_as() {
        // Both arrive as the literal the server wrote, so the accessors parse.
        let arr = super::Value::Text("{1,2,3}")
        match arr.as_array() {
            Some(items) => {
                let _ = testing::check_eq(items.len(), 3, "three elements")
                let _ = testing::check_eq(items[2].render(), "3", "the last one")
            }
            None => { let _ = testing::check(false, "an array literal reads as an array") }
        }
        let record = super::Value::Text("(1,ada,)")
        match record.as_record() {
            Some(fields) => {
                let _ = testing::check_eq(fields.len(), 3, "three fields")
                let _ = testing::check_eq(fields[1].render(), "ada", "the second")
                let _ = testing::check(fields[2].is_null(), "an empty field is NULL")
            }
            None => { let _ = testing::check(false, "a composite literal reads as a record") }
        }
        let _ = testing::check(super::Value::Text("not a literal").as_array().is_none(), "and nothing else does")
    }

    #[test]
    fn a_float_renders_in_the_spelling_postgres_reads_back() {
        let _ = testing::check_eq(super::render_float(1.5), "1.5", "a plain decimal")
        let _ = testing::check_eq(super::render_float(-0.25), "-0.25", "a negative one")
        let _ = testing::check_eq(super::render_float(super::nan()), "NaN", "not a number")
        let _ = testing::check_eq(super::render_float(super::infinity()), "Infinity", "infinity")
        // Whatever the spelling, it has to parse back to the same value, or a
        // float bound as a parameter is not the float that was read.
        for text in #["1.5", "-0.25", "NaN", "Infinity", "-Infinity"] {
            match super::parse_float_text(text) {
                Some(f) => {
                    let _ = testing::check_eq(
                        super::render_float(f)
                        text
                        format("round trip {}", text)
                    )
                }
                None => { let _ = testing::check(false, format("{} must parse", text)) }
            }
        }
        let _ = testing::check(super::parse_float_text("not a number").is_none(), "a word is rejected")
    }

    #[test]
    fn a_multirange_literal_parses_to_the_ranges_it_holds() {
        match super::parse_multirange_literal("{[1,3),[5,7)}", oid::INT4) {
            Ok(ranges) => {
                let _ = testing::check_eq(ranges.len(), 2, "two ranges")
                let _ = testing::check_eq(ranges[0].lower.render(), "1", "the first lower bound")
                let _ = testing::check_eq(ranges[1].upper.render(), "7", "the second upper bound")
                let _ = testing::check(ranges[0].lower_inclusive, "a square bracket includes")
                let _ = testing::check(!ranges[0].upper_inclusive, "a round one does not")
            }
            Err(e) => { let _ = testing::check(false, format("parse failed: {}", e)) }
        }
        let _ = testing::check_eq(
            super::parse_multirange_literal("{}", oid::INT4).unwrap_or(#[]).len()
            0
            "an empty multirange holds nothing"
        )
        let _ = testing::check(
            super::parse_multirange_literal("[1,3)", oid::INT4).is_err()
            "an unbraced literal is not a multirange"
        )
    }

    #[test]
    fn a_record_literal_survives_being_rendered_and_read_again() {
        // A field carrying a comma or a quote has to come back the same, or a
        // composite parameter changes shape on the way to the server.
        for literal in #["(1,ada,)", "(\"a,b\",c)", "(,)"] {
            match super::parse_record_literal(literal) {
                Ok(fields) => {
                    let again = super::render_record_literal(fields)
                    match super::parse_record_literal(again) {
                        Ok(reparsed) => {
                            let _ = testing::check_eq(
                                reparsed.len()
                                fields.len()
                                format("{} keeps its field count through {}", literal, again)
                            )
                            let _ = testing::check_eq(
                                reparsed.map(|f| f.render())
                                fields.map(|f| f.render())
                                format("{} keeps its fields through {}", literal, again)
                            )
                        }
                        Err(e) => { let _ = testing::check(false, format("reparse {}: {}", again, e)) }
                    }
                }
                Err(e) => { let _ = testing::check(false, format("{}: {}", literal, e)) }
            }
        }
    }

    #[test]
    fn a_nested_array_literal_renders_with_its_shape_intact() {
        let rows: Vec<String> = #["{1,2}", "{3,4}"]
        let _ = testing::check_eq(
            super::render_nested_array_literal(rows)
            "{{1,2},{3,4}}"
            "two rows of two"
        )
        let empty: Vec<String> = #[]
        let _ = testing::check_eq(super::render_nested_array_literal(empty), "{}", "no rows")
    }

    #[test]
    fn binary_uuid_renders_hyphenated() {
        let raw: Vec<u8> = #[
            0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255
        ]
        let _ = testing::check_eq(
            super::decode_binary(oid::UUID, raw).as_text().unwrap_or("")
            "00112233-4455-6677-8899-aabbccddeeff"
            "uuid text"
        )
    }

    #[test]
    fn binary_int_parameters_encode_at_their_width() {
        match super::encode_binary(super::Value::Int(258), oid::INT2) {
            Some(bytes) => {
                let _ = testing::check_eq(bytes.len(), 2, "int2 width")
                let _ = testing::check_eq((bytes[0] as i64), 1, "high byte")
                let _ = testing::check_eq((bytes[1] as i64), 2, "low byte")
            }
            None => { let _ = testing::check(false, "int2 has a binary encoding") }
        }
        let _ = testing::check(
            super::encode_binary(super::Value::Int(1), oid::NUMERIC).is_none()
            "numeric has no binary encoding here"
        )
    }
}
