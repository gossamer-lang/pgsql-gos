// A connection pool.
//
// The pool owns its connections and lends them out: `acquire` hands one over
// and `release` takes it back, so a program pays the handshake once per
// connection rather than once per unit of work, and never holds more open
// than its cap.
//
// A pool belongs to one goroutine. That is not a simplification: a
// connection is an aggregate with nested growable storage, which the
// compiled concurrency ABI has no ownership descriptor for, so a pool can
// neither be captured by a spawned goroutine nor sent through a channel, and
// `sync::Shared` guards a single word rather than an aggregate. Each of
// those is a check-time error, so a shared pool is a diagnostic rather than
// something a running program has to survive.
//
// For concurrent work, `Limiter` is the shape that holds: each goroutine
// opens its own connection, and a channel of permits bounds how many exist
// at once, which is what a server's connection limit actually cares about.
// It bounds connections rather than reusing them - reuse across goroutines
// waits on the ABI.

use std::sync::channel_unbounded
use std::errors

use crate::{client, config}

// A set of connections to one database, reused across units of work.
pub struct Pool {
    pub (package) cfg: config::Config
    // Connections opened and not currently lent out.
    pub (package) idle: Vec<client::Client>
    // How many connections exist, lent out or idle.
    pub (package) live: i64
    pub (package) max_size: i64
    // Whether a connection is checked with a round trip before being lent,
    // so a server restart surfaces as a reconnect rather than a failed query.
    pub (package) test_on_acquire: bool
    // Whether a returning connection has its session put back to what a
    // freshly opened one is, so nothing a borrower set reaches the next one.
    pub (package) reset_on_release: bool
    // How long a connection may stay in the pool, in milliseconds; 0 for no
    // bound. One older than this is closed rather than lent or kept.
    pub (package) max_lifetime_ms: i64
}

// Opens a pool of at most `max_size` connections, with none opened yet.
pub fn open(url: &String, max_size: i64) -> Result<Pool, errors::Error> {
    let cfg = config::parse(url)?
    open_with(&cfg, max_size)
}

// Opens a pool from already-parsed parameters.
pub fn open_with(cfg: &config::Config, max_size: i64) -> Result<Pool, errors::Error> {
    if max_size < 1 {
        return Err(errors::newf("pool size must be at least 1, got {}", max_size))
    }
    Ok(Pool {
        cfg: cfg.clone()
        idle: #[]
        live: 0
        max_size: max_size
        test_on_acquire: false
        reset_on_release: true
        max_lifetime_ms: 0
    })
}

impl Pool {
    // The pool's cap.
    pub fn size(&self) -> i64 {
        self.max_size
    }

    // How many connections are open, lent out or idle.
    pub fn live_count(&self) -> i64 {
        self.live
    }

    // How many are idle and ready to lend.
    pub fn idle_count(&self) -> i64 {
        self.idle.len()
    }

    // Turns on a round-trip check before a connection is lent. Costs one
    // query per checkout, and turns a server restart into a reconnect
    // instead of a failed query on the caller's first statement.
    pub fn set_test_on_acquire(&mut self, enabled: bool) {
        self.test_on_acquire = enabled
    }

    // Turns off the session reset a returning connection gets.
    //
    // The reset is on by default, because a pooled connection is handed to
    // work that did not open it: a `SET search_path` or a `SET
    // statement_timeout` one borrower ran would otherwise decide what the
    // next one's queries mean, and a temporary table or a LISTEN
    // registration would still be there. It costs one round trip per
    // release, which is worth turning off only for a pool whose borrowers
    // all leave the session alone.
    pub fn set_reset_on_release(&mut self, enabled: bool) {
        self.reset_on_release = enabled
    }

    // Bounds how long a connection stays in the pool, in milliseconds; 0,
    // the default, keeps one for as long as it works.
    //
    // A pool that never retires a connection pins the session it opened to
    // the server it first reached, so a failover, a rolling restart, or a
    // changed address only reaches the pool as connections happen to fail.
    // The age is checked when a connection would be lent and when one comes
    // back, so a connection in use is never taken from its borrower.
    pub fn set_max_lifetime(&mut self, lifetime_ms: i64) {
        self.max_lifetime_ms = max(lifetime_ms, 0)
    }

    // True when `pooled` has been open longer than the pool keeps one.
    fn is_expired(&self, pooled: &client::Client) -> bool {
        self.max_lifetime_ms > 0 && pooled.age_ms() >= self.max_lifetime_ms
    }

    // Opens connections until `count` are idle, so the first callers do not
    // pay for the handshake.
    pub fn warm(&mut self, count: i64) -> Result<(), errors::Error> {
        let target = min(count, self.max_size)
        while self.idle.len() < target && self.live < self.max_size {
            let opened = client::connect_with(&self.cfg)?
            self.live += 1
            self.idle.push(opened)
        }
        Ok(())
    }

    // Lends a connection, reusing an idle one or opening a new one.
    //
    // Reports rather than blocks when every connection is lent out: a
    // single-goroutine pool has nobody to wait for, so blocking would
    // deadlock. Raise the cap or release a connection first.
    pub fn acquire(&mut self) -> Result<client::Client, errors::Error> {
        while let Some(mut pooled) = self.idle.pop() {
            if pooled.is_closed() {
                self.live -= 1
                continue
            }
            if self.is_expired(&pooled) {
                pooled.close()
                self.live -= 1
                continue
            }
            if !self.test_on_acquire {
                return Ok(pooled)
            }
            match pooled.ping() {
                Ok(_) => return Ok(pooled)
                Err(_) => {
                    pooled.close()
                    self.live -= 1
                }
            }
        }
        if self.live >= self.max_size {
            return Err(errors::newf(
                "every one of the pool's {} connection(s) is checked out; release one first"
                self.max_size
            ))
        }
        let opened = client::connect_with(&self.cfg)?
        self.live += 1
        Ok(opened)
    }

    // Takes a connection back.
    //
    // A closed connection is dropped rather than kept, and one left inside a
    // transaction is rolled back first, so the next caller starts from a
    // clean session rather than inheriting this one's.
    pub fn release(&mut self, mut pooled: client::Client) {
        if pooled.is_closed() {
            self.live -= 1
            return
        }
        if self.is_expired(&pooled) {
            pooled.close()
            self.live -= 1
            return
        }
        if pooled.in_transaction() {
            match pooled.batch_execute(&"ROLLBACK") {
                Ok(_) => ()
                Err(_) => {
                    pooled.close()
                    self.live -= 1
                    return
                }
            }
        }
        if self.reset_on_release {
            // A session that cannot be put back to its opening state is not
            // one to lend again, whatever the reason it refused.
            match pooled.reset_session() {
                Ok(_) => ()
                Err(_) => {
                    pooled.close()
                    self.live -= 1
                    return
                }
            }
        }
        self.idle.push(pooled)
    }

    // Closes every idle connection, leaving any that are lent out alone.
    pub fn close_idle(&mut self) {
        while let Some(mut pooled) = self.idle.pop() {
            pooled.close()
            self.live -= 1
        }
    }
}

// A cap on how many connections exist at once, across goroutines.
//
// Each goroutine opens and owns its own connection, so nothing crosses a
// goroutine boundary; the permits are what is shared, and a channel carries
// those safely. `acquire` waits for a permit, `release` gives it back.
//
//     let limiter = pgsql::pool::limit(&url, 8)?
//     cohort {
//         for shard in shards {
//             spawn(|| work(&limiter, shard))
//         }
//     }?
//
//     fn work(limiter: &pgsql::pool::Limiter, shard: i64) -> Result<(), errors::Error> {
//         let mut db = limiter.acquire()?
//         let outcome = run(&mut db, shard)
//         limiter.release(db)
//         outcome
//     }
pub struct Limiter {
    // The connection string, held as written rather than as parsed
    // parameters: the limiter is read from every goroutine that opens a
    // connection, and a string crosses that boundary where an aggregate
    // with nested storage does not. Parsing costs nothing beside a
    // handshake.
    pub (package) url: String
    // One value per connection the limiter allows; taking one is the
    // permission to open a connection, sending it back is giving it up.
    pub (package) permits: Sender<i64>
    pub (package) leases: Receiver<i64>
    pub (package) max_size: i64
}

// Opens a limiter allowing at most `max_size` connections at once. The URL
// is validated here, so a bad one is reported before any goroutine starts.
pub fn limit(url: &String, max_size: i64) -> Result<Limiter, errors::Error> {
    if max_size < 1 {
        return Err(errors::newf("limiter size must be at least 1, got {}", max_size))
    }
    let _ = config::parse(url)?
    // Unbounded, so the permits can be seeded before any goroutine waits on
    // them; the count of values in flight is the bound that matters.
    let (permits, leases) = channel_unbounded()
    for _permit in 0..max_size {
        permits.send(1)
    }
    Ok(Limiter {
        url: url.clone()
        permits: permits
        leases: leases
        max_size: max_size
    })
}

impl Limiter {
    // How many connections the limiter allows at once.
    pub fn size(&self) -> i64 {
        self.max_size
    }

    // Waits for a permit and opens a connection with it.
    //
    // A connection that fails to open gives its permit back, so a server
    // refusing connections does not drain the limiter.
    pub fn acquire(&self) -> Result<client::Client, errors::Error> {
        let Some(_permit) = self.leases.recv() else {
            return Err(errors::new("the limiter is closed"))
        }
        match client::connect(&self.url) {
            Ok(opened) => Ok(opened)
            Err(e) => {
                self.permits.send(1)
                Err(e)
            }
        }
    }

    // Closes a connection and gives its permit back.
    pub fn release(&self, mut opened: client::Client) {
        opened.close()
        self.permits.send(1)
    }
}

#[cfg(test)]
mod pool_tests {
    use std::testing

    #[test]
    fn a_pool_needs_at_least_one_connection() {
        match super::open(&"user=nobody", 0) {
            Ok(_) => { let _ = testing::check(false, "size 0 must be rejected") }
            Err(e) => {
                let _ = testing::check(
                    format!("{}", e).contains("at least 1")
                    &format!("reported: {}", e)
                )
            }
        }
    }

    #[test]
    fn a_limiter_needs_at_least_one_permit() {
        match super::limit(&"user=nobody", 0) {
            Ok(_) => { let _ = testing::check(false, "size 0 must be rejected") }
            Err(e) => {
                let _ = testing::check(
                    format!("{}", e).contains("at least 1")
                    &format!("reported: {}", e)
                )
            }
        }
    }

    #[test]
    fn a_limiter_reports_its_cap() {
        match super::limit(&"user=nobody dbname=nothing", 3) {
            Ok(limiter) => { let _ = testing::check_eq(&limiter.size(), &3, "cap") }
            Err(e) => { let _ = testing::check(false, &format!("limit: {}", e)) }
        }
    }

    #[test]
    fn a_new_pool_holds_no_connections() {
        match super::open(&"user=nobody dbname=nothing", 4) {
            Ok(mut p) => {
                let _ = testing::check_eq(&p.size(), &4, "cap")
                let _ = testing::check_eq(&p.live_count(), &0, "nothing open yet")
                let _ = testing::check_eq(&p.idle_count(), &0, "nothing idle yet")
                p.set_test_on_acquire(true)
                let _ = testing::check(p.test_on_acquire, "test on acquire")
                let _ = testing::check(p.reset_on_release, "a returning connection is reset by default")
                p.set_reset_on_release(false)
                let _ = testing::check(!p.reset_on_release, "the reset can be turned off")
                let _ = testing::check_eq(&p.max_lifetime_ms, &0, "no lifetime bound by default")
                p.set_max_lifetime(30_000)
                let _ = testing::check_eq(&p.max_lifetime_ms, &30_000, "a lifetime bound is kept")
                p.set_max_lifetime(-1)
                let _ = testing::check_eq(&p.max_lifetime_ms, &0, "a negative bound is none")
            }
            Err(e) => { let _ = testing::check(false, &format!("open: {}", e)) }
        }
    }
}
